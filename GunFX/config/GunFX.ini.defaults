; GunFX settings (experimental). Saved changes are picked up while the game runs (within a second).
; Turn each effect on or off in the NVR menu (O key): Main > GunFX. This file fine-tunes them.
; Per-gun settings: each gun also gets its own file in Data\NVSE\Plugins\GunFX\Weapons\ the first time you equip it.
; Full guide: GunFX-README.txt (in the download) or docs/GUNFX.md on GitHub.
; The smoke's look (size, opacity, how it grows, rises and fades) is set per effect in [Puff], [Wisp], [Trail] and
; [Ejection]; [Volume] has the volumetric smoke prototype.

[Muzzle]
; Where the smoke at the barrel tip starts: the muzzle puff, the heat smoke and the after-fire trail all use this one
; offset, so they always line up. Game units along the gun's own axes, so they turn with the gun: Y = forward along the
; barrel, X = sideways, Z = up. (The ejection smoke has its own offsets in [Ejection]; the glow, heat haze and muzzle
; blast use [Glow]'s.)
fOffsetX=1
fOffsetY=2
fOffsetZ=0

[Puff]
; A small puff of smoke at the muzzle on every shot.
bEnabled=1
; Effect file (inside Data\Meshes).
sModel=GunFX\barrelpuff.nif
; Seconds the effect lives. Keep it longer than fSmokeLife + fSmokeLifeVariation, or the puff is cut off before it
; has faded.
fLifetime=2.4
; Size of the puff.
fScale=1.5
; Seconds the puff blows smoke (longer = a bigger puff).
fBurstSeconds=0.1
; Automatic guns: smallest gap between two puffs in seconds (0.05 = practically every shot; more = a lighter haze).
; Other guns make a puff on every shot.
fMinInterval=0.1
; 1 = only your own shots, 0 = everyone's.
bPlayerOnly=1
; Where the puff starts: a node of the gun's model (blank = ProjectileNode, the barrel tip), moved by [Muzzle]'s offsets.
sNode=
; ---- Look of the smoke (the values below are the ones the effect file was built with). GunFX writes a copy of the
; effect file with these values into Data\Meshes\GunFX\Generated\ and uses that; saved changes apply to the next
; smoke.
; Size each puff of smoke grows to, and how much that varies.
fSize=4
fSizeVariation=1.2
; Seconds each puff of smoke lives, and how much that varies.
fSmokeLife=1
fSmokeLifeVariation=0.4
; Seconds it grows for after leaving the gun (about its life = it keeps swelling as it rises), and seconds it
; shrinks at the very end (0 = it only fades).
fGrowSeconds=1.6
fShrinkSeconds=0
; Upward push (higher = rises faster; negative sinks), and curl: random swirl (0 = straight; above about 0.05 it
; scatters) with fCurlScale the size of the swirls.
fRise=8
fCurl=0.15
fCurlScale=5
; Opacity at its thickest (0 = invisible, 1 = solid).
fOpacity=0.03
; When it is fully visible, starts fading and is gone, as shares of its life (0 to 1).
fFadeIn=0.03
fFadeStart=0.12
fFadeEnd=0.95
; How each puff of smoke starts: its size as a share of fSize (small = a narrow start that widens as it rises),
; the speed it leaves at and how much that varies, and fSpread, the angle it leaves at in radians (small = a
; tight, connected strand; large = a wide spray).
fStartSize=0.7
fSpeed=7
fSpeedVariation=1.5
fSpread=0.7
; Puffs of smoke per second while the burst lasts (fBurstSeconds x fBurstRate = pieces per shot; more = one soft puff).
fBurstRate=150

[Wisp]
; Heat smoke: a thin strand of smoke rising from the barrel while you fire, driven by barrel heat. A few shots give
; nothing; sustained fire builds a steady strand. When you stop firing it stops too, and the after-fire trail ([Trail])
; takes over.
bEnabled=1
; Seconds after the last shot that still count as firing (match it to [Trail] fStartDelay for a clean hand-over).
; 0 = the old behaviour: the heat smoke keeps going after you stop, until the barrel cools.
fStopDelay=0.5
; Effect file: GunFX\barrelstrand.nif (thin strand) or GunFX\barrelwisp.nif (looser stream of bigger puffs).
sModel=GunFX\barrelstrand.nif
; Size of the strand.
fScale=2
; Barrel heat: each shot adds fHeatPerShot; the barrel cools by fCoolPerSecond each second, starting fCoolDelay
; seconds after the last shot (so slower guns build heat too). Heat never goes above fMaxHeat.
fHeatPerShot=0.5
fCoolPerSecond=3.0
fCoolDelay=1.5
fMaxHeat=15
; No smoke below fHeatStart; full smoke from fHeatFull on (rising smoothly in between).
fHeatStart=3
fHeatFull=12
; Smoke rate at full heat in puffs per second (strand: up to about 180; more = a smoother, denser strand).
fMaxRate=150
; Emitters spread along the barrel's path between frames (1-4): keeps the smoke one continuous plume while you move
; instead of separate blobs. The rate is split between them. 1 = a single emitter.
iEmitters=4
; Slow sideways sway of the smoke's source, so the strand snakes as it rises (0 = straight up), and its speed.
fSway=1
fSwaySpeed=0.1
; Where the strand starts (as in [Puff]; moved by [Muzzle]'s offsets). The after-fire trail starts here too.
sNode=
; Internal: seconds each strand effect lives before a new one takes over seamlessly, and the overlap.
fEffectSeconds=30
fTailSeconds=3.5
; Internal: the rate the barrelwisp file was built with (the strand ignores it).
fFileRate=20
; ---- Look of the smoke (the values below are the ones the effect file was built with). GunFX writes a copy of the
; effect file with these values into Data\Meshes\GunFX\Generated\ and uses that; saved changes apply to the next
; smoke.
; For the strand fOpacity is per puff of smoke and they overlap, so small numbers add up. barrelwisp.nif was built
; with: fSize 5, fSizeVariation 1.5, fSmokeLife 2.5, fSmokeLifeVariation 0.6, fGrowSeconds 2.2, fRise 20, fCurl 0.03,
; fOpacity 0.35, fFadeIn 0.5, fFadeStart 0.51, fFadeEnd 0.8.
; Size each puff of smoke grows to, and how much that varies.
fSize=4.5
fSizeVariation=0.5
; Seconds each puff of smoke lives, and how much that varies.
fSmokeLife=2.6
fSmokeLifeVariation=0.5
; Seconds it grows for after leaving the gun (about its life = it keeps swelling as it rises), and seconds it
; shrinks at the very end (0 = it only fades).
fGrowSeconds=2.6
fShrinkSeconds=0
; Upward push (higher = rises faster; negative sinks), and curl: random swirl (0 = straight; above about 0.05 it
; scatters) with fCurlScale the size of the swirls.
fRise=7
fCurl=0.012
fCurlScale=6
; Opacity at its thickest (0 = invisible, 1 = solid).
fOpacity=0.1
; When it is fully visible, starts fading and is gone, as shares of its life (0 to 1).
fFadeIn=0.04
fFadeStart=0.2
fFadeEnd=0.95
; How each puff of smoke starts: its size as a share of fSize (small = a narrow start that widens as it rises),
; the speed it leaves at and how much that varies, and fSpread, the angle it leaves at in radians (small = a
; tight, connected strand; large = a wide spray).
fStartSize=0.3
fSpeed=10
fSpeedVariation=0.8
fSpread=0.03

[Trail]
; After-fire trail: a thin, wispy trail rising from the barrel only after you stop firing, like a cigarette. It starts
; fStartDelay seconds after the last shot if the barrel is warm, thins out as the barrel cools, and stops the moment
; you fire again. It starts where the heat smoke does ([Wisp] sNode, [Muzzle] offsets). Menu switch: Main > GunFX > AfterFireTrail.
bEnabled=1
; Effect file and size. barreltrail.nif is its own file (built with the look below), separate from the heat smoke's.
sModel=GunFX\barrelstrand.nif
fScale=2.0
; Seconds after the last shot before it starts.
fStartDelay=0.5
; Barrel heat (the same heat as [Wisp]): no trail below fMinHeat, full trail from fFullHeat on.
fMinHeat=2
fFullHeat=10
; Puffs of smoke per second at full heat (they blend into one trail).
fMaxRate=120
; Emitters spread along the barrel's path between frames (1-4): keeps the smoke one continuous plume while you move
; instead of separate blobs. The rate is split between them. 1 = a single emitter.
iEmitters=4
; Slow sideways sway of its source, so the trail curls as it rises, and its speed.
fSway=1
fSwaySpeed=0.1
; ---- Look of the trail (the values barreltrail.nif was built with: thinner, longer-lived, slower and curlier than the
; heat smoke). See [Puff] for each key. Changes apply at once and never affect the heat smoke.
fSize=5.5
fSizeVariation=0.8
fSmokeLife=3.6
fSmokeLifeVariation=0.9
fGrowSeconds=3.6
fShrinkSeconds=0
fRise=4
fCurl=0.012
fCurlScale=6
fOpacity=0.2
fFadeIn=0.04
fFadeStart=0.15
fFadeEnd=0.95
; How each puff of smoke starts: its size as a share of fSize (small = a narrow start that widens as it rises),
; the speed it leaves at and how much that varies, and fSpread, the angle it leaves at in radians (small = a
; tight, connected strand; large = a wide spray).
fStartSize=0.3
fSpeed=6
fSpeedVariation=0.5
fSpread=0.02

[Volume]
; Volumetric smoke (prototype): draws GunFX's smoke as continuous, soft volumes of smoke (rendered by NVR) instead of
; the game's particle sprites, so there are no separate blobs, even while you move. Menu switch: Main > GunFX >
; VolumetricSmoke (each smoke's own switch must be on too: HeatSmoke, AfterFireTrail, Puff, EjectionSmoke). While it is
; on, the sprite version of that smoke is not spawned. Your own gun only. The look still comes from each smoke's own
; section ([Wisp], [Trail], [Puff], [Ejection]): fSize (times fScale), fSizeVariation, fStartSize, fGrowSeconds,
; fSmokeLife, fSmokeLifeVariation, fSpeed, fSpeedVariation, fSpread, fRise, fCurl, fOpacity, fFadeIn, fFadeStart and
; fFadeEnd. The keys below scale that look for the volumetric version.
; 0 = never use the volumetric smoke (e.g. in one gun's own file), even with the menu switch on.
bEnabled=1
; Which smoke is drawn volumetric while the menu switch is on (1), or stays the game's sprites (0).
bHeatSmoke=1
bTrail=1
bPuff=1
bEjection=1
; 1 = your own gun (first person) is always drawn in front of the smoke, so smoke never shows inside it.
; 0 = smoke and gun are sorted by distance (smoke can pass in front of the gun, but may cut into it).
bGunInFront=1
; 1 = your own gun (first person) is always drawn in front of the smoke, so smoke never shows inside it.
; 0 = smoke and gun are sorted by distance (smoke can pass in front of the gun, but may cut into it).
bGunInFront=1
; Width of the smoke compared with the sprite size (fSize times fScale): a sprite's soft edges are mostly transparent,
; so the visible smoke is about a quarter of it.
fSizeScale=0.25
; Width of the muzzle puff and ejection smoke compared with their sprite size ([Puff] / [Ejection] fSize times fScale).
fBurstSizeScale=1.0
; How much bigger the smoke ends up than its sprite size (1 = the same growth as the sprites, from fStartSize to
; full size). It grows fast at first and slower later.
fExpand=1.6
; How much the smoke thins out as it widens: 0 = it keeps its opacity like the sprites (only fFadeStart / fFadeEnd
; fade it), 1 = the same amount of smoke spread wider (much fainter when big).
fThinning=0.2
; How opaque the smoke is. fOpacity x fDensityScale is its thickness looking straight across the strand where it
; starts: 0.2 hides about a fifth of what is behind it, 0.8 about half, 2 nearly all. It thins out as it widens.
fDensityScale=4.0
; How strongly it rises compared with fRise.
fRiseScale=1.0
; How strongly it curls sideways compared with fCurl (it bends gently near the barrel and drifts more as it ages).
fCurlScale=400
; Air drag: how quickly the heat smoke and trail slow down (per second). Higher = they hang in the air more.
fDrag=0.4
; Smoothing: sharp kinks a quick or jittery gun movement leaves in the heat smoke and trail even out over a fraction
; of a second (per second; 0 = off). The smoke still leaves the barrel straight.
fSmooth=3.0
; Drift: the heat smoke and trail lean toward the right of where you aim (fDriftRight) and a little away from you
; (fDriftAway), so they keep out of the middle of your view and away from you as you walk (game units per second;
; 0 = straight up; a negative fDriftRight leans left).
fDriftRight=0
fDriftAway=0
; The gun as a solid shape: smoke never stays inside it; walking or swinging the gun into the trail splits it, an arm along
; each side of the barrel, and smoke slides round the barrel instead of riding along with it. fGunLength = how far
; back from the muzzle the gun reaches, fGunRadius = how thick it is (game units).
bWrapGun=1
fGunLength=30
fGunRadius=3.5
; The gun's real shape: read from its model when you first hold it, so smoke flows round its sights, magazine and
; scope (fGunLength and fGunRadius then stand in only until it is ready; fGunRadius still sets how far out the gun
; moves the air). 0 = always the plain tube above.
bGunShape=1
; Swirl behind the gun: swinging the gun through smoke leaves little whirlpools behind the barrel that curl the smoke
; into eddies for a moment (0 = none, higher = stronger).
fGunSwirl=0.6
; Swirl behind you: walking through smoke leaves little upright whirlpools behind your body; together with the gun's they
; carry each other along, so your wake rolls up into eddies. fBodySwirl = how strong (0 = none), fSwirlLife = how long
; each lasts (seconds).
fBodySwirl=0.5
fSwirlLife=1.2
; The heat smoke also rises off the hot barrel: its source wanders slowly this share of fGunLength back from the
; muzzle (0 = the muzzle only).
fBarrelSpread=0.3
; Tendrils: where the heat smoke or trail bends sharply (a quick change of the gun's direction, while you move it), a
; thin wisp peels off the bend and curls away, and a strand your body splits frays at its torn ends. fTendrils = the chance at each sharp
; bend (0 = never, 1 = always), fTendrilAngle = how sharp a bend must be (degrees), fTendrilSize = their thickness
; as a share of the strand's, fTendrilSpeed = how fast they peel off (game units per second).
fTendrils=0.6
fTendrilAngle=20
fTendrilSize=0.35
fTendrilSpeed=12
; Air drag of the muzzle puff and ejection smoke: they burst out, slow down quickly, then drift and rise.
fBurstDrag=3.0
; How fast the muzzle puff blows forward out of the barrel (game units per second; fBurstDrag slows it down).
; 0 = it only rises, like the sprite puff.
fPuffForward=25
; Points each muzzle puff / ejection burst starts with (1-12), flying apart at different speeds and angles:
; more = a fuller, more irregular cloud.
iBurstPoints=4
; Smallest gap in seconds between the points that shape the smoke (the heat smoke and trail keep about 30 points over
; the smoke's life, a puff or ejection burst about 60).
fSpacing=0.04
; Edge detail: a lumpy outline and wispy, eaten-away edges that travel with the smoke (more as it ages; the thick core
; stays whole). 0 = smooth, soft tubes; 1 = strong.
fNoise=0.55
; Brightness of the smoke in the scene's light.
fBrightness=1.0
; Self-shadowing: the side away from the sun (indoors: the underside) is darker, and so is the inside of thick smoke.
; 0 = evenly lit.
fSelfShadow=0.5
; Muzzle flash light: each shot lights the smoke around the muzzle orange for a moment. fFlash = how bright (0 = off),
; fFlashRadius = how far it reaches (game units), fFlashSeconds = how quickly it fades.
fFlash=1.0
fFlashRadius=15
fFlashSeconds=0.05
; Colour: fresh smoke is whiter and greys as it ages, thin smoke has a cool, bluish tint, and the scene seen through
; smoke warms slightly. 0 = plain grey, 1 = normal.
fTint=0.7
; Depth: the smoke is shaded as if round and lumpy (its side and top toward the light brighter, the far side darker,
; lumps catching light on one side), for a sense of depth. 0 = flat, 1 = normal.
fDepth=0.7
; Wind: outdoors the smoke drifts with the weather's wind (indoors the air is still). fWind = drift speed at full wind
; (game units per second), fWindPickup = how quickly smoke takes on the wind (per second; older smoke has had longer).
; fWindDirectionOffset turns the drift (degrees): use 180 if the smoke drifts against the grass and trees.
fWind=40
fWindPickup=0.8
fWindDirectionOffset=0
; Your body: smoke never stays inside it or runs through it. Smoke ahead of you as you walk slides aside, a strand you
; walk through is split, some smoke is pulled into your wake, and stirred smoke thins out. fPlayerRadius = your body's
; width from its middle and fPlayerHeight = its height from your feet (game units; both a little over your real size,
; so smoke stays out of the camera too), fPlayerPush = how hard it pushes, fStir = how quickly stirred smoke thins
; out (per second).
bPlayerPush=1
fPlayerRadius=30
fPlayerHeight=140
fPlayerPush=40
fStir=1.5
; Stirred smoke spreads out: smoke your body or the gun disturbs (or a whirlpool catches) billows wider, thins into a
; ragged veil and frays into wisps, as real smoke mixes into the air. 0 = off, 1 = normal, higher = more.
fDiffuse=0.5
; Unzip: as you walk into the heat smoke or trail it splits around you like a bow wave, into two arms that fan out
; either side of you and trail behind (instead of bits of it bouncing from side to side). It splits where the air ahead of
; you starts to part. fFanSpeed = how fast the two arms spread apart once it splits (game units per second; 0 = only when you reach them).
bUnzip=1
fFanSpeed=30
; Test aid: 1 = draw the volumetric smoke solid red, even through walls, to see where it is. Set back to 0 afterwards.
bDebug=0

[Ejection]
; A burst of smoke from the ejection port every time the game throws out a casing (automatic guns at the shot,
; others when the animation ejects).
bEnabled=1
; The gun's node for the port (ShellCasingNode or ##ShellCasingNode on almost every gun). No node = no smoke.
sNode=ShellCasingNode
sModel=GunFX\barrelport.nif
; Size on a cold gun, and the size at full barrel heat relative to that (a hot gun vents more smoke; 1 = always the same).
fScale=0.25
fHotScale=1.8
; Seconds the port blows smoke per casing (longer = a bigger spurt), and seconds the effect lives.
fBurstSeconds=0.08
fLifetime=2.0
; Smallest gap between two bursts in seconds (0 = one for every casing).
fMinInterval=0
; Move the burst from the port node (as in [Puff]).
fOffsetX=0
fOffsetY=0
fOffsetZ=0
; ---- Look of the smoke (the values below are the ones the effect file was built with). GunFX writes a copy of the
; effect file with these values into Data\Meshes\GunFX\Generated\ and uses that; saved changes apply to the next
; smoke.
; Size each puff of smoke grows to, and how much that varies.
fSize=2
fSizeVariation=0.7
; Seconds each puff of smoke lives, and how much that varies.
fSmokeLife=1.2
fSmokeLifeVariation=0.3
; Seconds it grows for after leaving the gun (about its life = it keeps swelling as it rises), and seconds it
; shrinks at the very end (0 = it only fades).
fGrowSeconds=1.2
fShrinkSeconds=0
; Upward push (higher = rises faster; negative sinks), and curl: random swirl (0 = straight; above about 0.05 it
; scatters) with fCurlScale the size of the swirls.
fRise=6
fCurl=0.05
fCurlScale=5
; Opacity at its thickest (0 = invisible, 1 = solid).
fOpacity=0.05
; When it is fully visible, starts fading and is gone, as shares of its life (0 to 1).
fFadeIn=0.03
fFadeStart=0.1
fFadeEnd=0.95
; How each puff of smoke starts: its size as a share of fSize (small = a narrow start that widens as it rises),
; the speed it leaves at and how much that varies, and fSpread, the angle it leaves at in radians (small = a
; tight, connected strand; large = a wide spray).
fStartSize=0.3
fSpeed=5
fSpeedVariation=2
fSpread=1.0
; Puffs of smoke per second while the burst lasts (fBurstSeconds x fBurstRate = pieces per casing).
fBurstRate=140

[Glow]
; The barrel glows after sustained fire and cools down slowly (drawn by NVR's shaders).
bEnabled=1
; Fitting mode: fire once, then the full glow stays visible while the gun is drawn. Set back to 0 afterwards.
bPreview=0
; Width of the glowing part around the barrel. Larger values catch more nearby weapon parts.
fRadius=6.5
; Reach ahead of the muzzle node, useful for muzzle brakes.
fForwardLength=9
; Glowing length back along the barrel: starts at fMinLength and grows toward fLength as shots accumulate.
fMinLength=2.5
fLength=14
; Approximate sustained shots needed to reach the full length, and seconds for it to shrink back after firing stops
; (shrinking begins after five idle seconds).
fSpreadShots=1000
fSpreadCoolSeconds=900
; Move the glow relative to the muzzle node (directions depend on the weapon model; change one axis at a time).
; Also moves the heat haze and the muzzle blast.
fOffsetX=0
fOffsetY=0
fOffsetZ=0
; Heat where the glow begins, extra heat needed for full brightness, and seconds to fade in.
fStartHeat=1.0
fHeatSpan=12.0
fRiseSeconds=2.8
; Size of the older glow-mesh fallback (does not affect the shader glow).
fScale=1.3

[Haze]
; Heat shimmer around a hot barrel (NVR screen effect).
bEnabled=1
; Testing: bPreview=1 = full haze after one shot; bShowMask=1 = paint the haze area red (the muzzle blast in blue).
bPreview=0
bShowMask=0
; Heat where the haze begins and where it is full, and seconds to fade in and out.
fStartHeat=3
fFullHeat=12
fRiseSeconds=1.5
; Strength (how far the image is pushed, in screen pixels), plume height and width (pixels), wobble speed.
fStrengthPixels=3
fHeightPixels=90
fWidthPixels=20
fSpeed=1
; Length of barrel the shimmer wraps around, in game units back from the muzzle.
fLength=8
; The haze grows with the barrel heat: its size when it first appears, as a share of the full size above (reached at
; fFullHeat). 1 = always full size. Its strength rises with the heat the same way.
fMinSize=0.35

[Blast]
; Muzzle blast: a quick, wide ripple of heat shimmer at the muzzle on every shot, whatever the barrel heat.
bEnabled=1
; Strongest push in screen pixels, size of the ripple (pixels), and how fast it fades in seconds (gone after about
; three times this).
fStrengthPixels=7
fRadiusPixels=320
fSeconds=0.06

[Main]
; Spawn flags for the effects (3).
iFlags=3
; How many puffs/strands to note in GunFX.log, and whether to list each gun's node names there (for sNode).
iLogEvents=20
bLogWeaponNodes=1

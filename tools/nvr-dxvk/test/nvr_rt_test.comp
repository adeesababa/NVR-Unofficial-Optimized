#version 460
// NVR ray tracing core test (nvr_rt_test.cpp): one ray per grid point against the scene, by its address in the push block.
#extension GL_EXT_ray_query : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, std430) writeonly buffer Out { vec4 results[]; };

layout(push_constant) uniform Push {
  uvec2 scene;       // ID3D9NvrExtRtScene::GetAddress
  uint  size;        // grid size (size x size)
  uint  pad;
  vec4  area;        // x0, y0, x1, y1 of the grid
  vec4  origin;      // z of the ray origins, tMax in w
  vec4  direction;   // xyz
} p;

void main() {
  uvec2 id = gl_GlobalInvocationID.xy;
  if (id.x >= p.size || id.y >= p.size)
    return;

  vec2 f = (vec2(id) + 0.5) / float(p.size);
  vec3 o = vec3(mix(p.area.xy, p.area.zw, f), p.origin.z);

  rayQueryEXT q;
  rayQueryInitializeEXT(q, accelerationStructureEXT(p.scene), gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT,
    0xFF, o, 0.0, p.direction.xyz, p.origin.w);
  while (rayQueryProceedEXT(q)) { }

  vec4 r = vec4(0.0, -1.0, -1.0, 0.0);
  if (rayQueryGetIntersectionTypeEXT(q, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
    r.x = 1.0;
    r.y = rayQueryGetIntersectionTEXT(q, true);
    r.z = float(rayQueryGetIntersectionInstanceCustomIndexEXT(q, true));
    r.w = float(rayQueryGetIntersectionPrimitiveIndexEXT(q, true));
  }
  results[id.y * p.size + id.x] = r;
}

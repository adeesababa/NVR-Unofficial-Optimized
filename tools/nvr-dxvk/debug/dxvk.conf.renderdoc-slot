# NVR DXVK debug template: RenderDoc in a game started WITHOUT RenderDoc's window (test slots, the auto-test).
# Copy this file next to the fork's d3d9.dll and rename it to dxvk.conf (a test slot: put both in the FORK_D3D9 folder).
# Needs: a fork d3d9.dll with patch 0014, RenderDoc installed with its Vulkan layer registered for 32-bit
# (HKLM\SOFTWARE\WOW6432Node\Khronos\Vulkan\ImplicitLayers -> C:\Program Files\RenderDoc\x86\renderdoc.json), and NVR's
# [Main.Develop.Main] GpuDebugLabels = true (or 'set Main.Develop.Main GpuDebugLabels true' in the shot).
# Guide: docs/next/FORK-DEBUG-CAPTURE.md, "Capturing in a test slot".
#
# ENABLE_VULKAN_RENDERDOC_CAPTURE=1 switches on RenderDoc's implicit Vulkan layer, so the Vulkan loader itself loads
# RenderDoc's renderdoc.dll into the game when DXVK creates its Vulkan instance: no launch from RenderDoc, no injection.
# NVR then finds it (it never loads it itself) and the shot-list command 'capture' / RenderDocCaptureKey work. Captures are
# written to the game's %TEMP%\RenderDoc\ folder; NVR's log names each file ("RENDERDOC: capture written ...").
# DXVK_DEBUG=markers: NVR's step names as Vulkan labels in the capture.
# Cost: RenderDoc's layer tracks every Vulkan call (some CPU and memory). Never use this folder for timing runs.
nvr.debugEnv = "DXVK_DEBUG=markers|ENABLE_VULKAN_RENDERDOC_CAPTURE=1"

# Optional: if the capture is broken by an overlay, switch the overlays off (RenderDoc's own layer stays on):
# nvr.debugEnv = "DXVK_DEBUG=markers|ENABLE_VULKAN_RENDERDOC_CAPTURE=1|VK_LOADER_LAYERS_DISABLE=VK_LAYER_RTSS,VK_LAYER_OW_*,VK_LAYER_OBS_HOOK,VK_LAYER_VALVE_steam_overlay"

# Depth on NVIDIA with a fork WITHOUT the RESZ-on-every-vendor patch (0007-NVR-RESZ...): uncomment.
# d3d9.customVendorId = 1002

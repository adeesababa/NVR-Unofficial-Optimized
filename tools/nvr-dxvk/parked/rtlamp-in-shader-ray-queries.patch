diff --git a/src/dxvk/dxvk_nvr_rtpatch.cpp b/src/dxvk/dxvk_nvr_rtpatch.cpp
new file mode 100644
index 0000000..0c1502d
--- /dev/null
+++ b/src/dxvk/dxvk_nvr_rtpatch.cpp
@@ -0,0 +1,399 @@
+#include "dxvk_nvr_rtpatch.h"
+
+#include <atomic>
+#include <cstring>
+#include <unordered_map>
+#include <unordered_set>
+
+// NVR RT lamp shadows (2026-10-28): see the header. A plain word-level rewrite of the module, so it needs nothing from
+// DXVK or dxbc-spirv and is tested on its own (tools/nvr-dxvk/test/rtpatch_test.cpp: glslang output, spirv-val).
+
+namespace dxvk {
+
+  namespace {
+
+    enum : uint32_t {
+      SpvOpExtension                         = 10,
+      SpvOpExtInstImport                     = 11,
+      SpvOpMemoryModel                       = 14,
+      SpvOpCapability                        = 17,
+      SpvOpTypeBool                          = 20,
+      SpvOpTypeInt                           = 21,
+      SpvOpTypeFloat                         = 22,
+      SpvOpTypeVector                        = 23,
+      SpvOpTypeImage                         = 25,
+      SpvOpTypeSampledImage                  = 27,
+      SpvOpTypePointer                       = 32,
+      SpvOpConstant                          = 43,
+      SpvOpConstantComposite                 = 44,
+      SpvOpFunction                          = 54,
+      SpvOpFunctionEnd                       = 56,
+      SpvOpVariable                          = 59,
+      SpvOpLoad                              = 61,
+      SpvOpVectorShuffle                     = 79,
+      SpvOpCompositeConstruct                = 80,
+      SpvOpCompositeExtract                  = 81,
+      SpvOpCopyObject                        = 83,
+      SpvOpSampledImage                      = 86,
+      SpvOpImageSampleExplicitLod            = 88,
+      SpvOpConvertFToU                       = 109,
+      SpvOpSelect                            = 169,
+      SpvOpIEqual                            = 170,
+      SpvOpPhi                               = 245,
+      SpvOpLabel                             = 248,
+      SpvOpConvertUToAccelerationStructureKHR = 4447,
+      SpvOpTypeRayQueryKHR                   = 4472,
+      SpvOpRayQueryInitializeKHR             = 4473,
+      SpvOpRayQueryProceedKHR                = 4477,
+      SpvOpRayQueryGetIntersectionTypeKHR    = 4479,
+      SpvOpTypeAccelerationStructureKHR      = 5341,
+
+      SpvCapabilityRayQueryKHR               = 4472,
+      SpvDimCube                             = 3,
+      SpvStorageClassFunction                = 7,
+      SpvImageOperandsBias                   = 0x1,
+      SpvImageOperandsLod                    = 0x2,
+      SpvImageOperandsGrad                   = 0x4,
+      RayFlagsOpaqueTerminateOnFirstHit      = 0x1 | 0x4,
+    };
+
+    struct Ins {
+      size_t   pos;
+      uint32_t op;
+      uint32_t len;
+    };
+
+    void emit(std::vector<uint32_t>& out, uint32_t op, std::initializer_list<uint32_t> operands) {
+      out.push_back((uint32_t(operands.size() + 1u) << 16) | op);
+      out.insert(out.end(), operands.begin(), operands.end());
+    }
+
+    void emitString(std::vector<uint32_t>& out, uint32_t op, const char* str) {
+      size_t chars = std::strlen(str) + 1u;
+      size_t words = (chars + 3u) / 4u;
+      out.push_back((uint32_t(words + 1u) << 16) | op);
+      size_t base = out.size();
+      out.resize(base + words, 0u);
+      std::memcpy(&out[base], str, chars);
+    }
+
+  }
+
+
+  uint32_t nvrPatchCubeGradRayQueries(std::vector<uint32_t>& code, uint64_t tlasAddress) {
+    if (code.size() < 5u || code[0] != 0x07230203u || !tlasAddress)
+      return 0u;
+
+    std::vector<Ins> ins;
+
+    for (size_t pos = 5u; pos < code.size(); ) {
+      uint32_t len = code[pos] >> 16;
+      if (!len || pos + len > code.size())
+        return 0u;
+      ins.push_back({ pos, code[pos] & 0xFFFFu, len });
+      pos += len;
+    }
+
+    auto word = [&] (const Ins& i, uint32_t n) { return n < i.len ? code[i.pos + n] : 0u; };
+
+    // Types by result id, and the result type of the values a sampled image can come from
+    std::unordered_map<uint32_t, size_t> types;
+    std::unordered_map<uint32_t, uint32_t> valueTypes;
+
+    uint32_t floatType = 0u, uintType = 0u, boolType = 0u, asType = 0u, rqType = 0u;
+
+    for (size_t k = 0; k < ins.size(); k++) {
+      const Ins& i = ins[k];
+
+      switch (i.op) {
+        case SpvOpTypeBool:
+          boolType = word(i, 1);
+          types[word(i, 1)] = k;
+          break;
+        case SpvOpTypeInt:
+          if (word(i, 2) == 32u && word(i, 3) == 0u)
+            uintType = word(i, 1);
+          types[word(i, 1)] = k;
+          break;
+        case SpvOpTypeFloat:
+          if (word(i, 2) == 32u)
+            floatType = word(i, 1);
+          types[word(i, 1)] = k;
+          break;
+        case SpvOpTypeAccelerationStructureKHR:
+          asType = word(i, 1);
+          types[word(i, 1)] = k;
+          break;
+        case SpvOpTypeRayQueryKHR:
+          rqType = word(i, 1);
+          types[word(i, 1)] = k;
+          break;
+        case SpvOpTypeVector:
+        case SpvOpTypeImage:
+        case SpvOpTypeSampledImage:
+        case SpvOpTypePointer:
+          types[word(i, 1)] = k;
+          break;
+        case SpvOpSampledImage:
+        case SpvOpLoad:
+        case SpvOpCopyObject:
+        case SpvOpPhi:
+        case SpvOpSelect:
+          valueTypes[word(i, 2)] = word(i, 1);
+          break;
+        default:
+          break;
+      }
+    }
+
+    auto typeIns = [&] (uint32_t id) -> const Ins* {
+      auto e = types.find(id);
+      return e != types.end() ? &ins[e->second] : nullptr;
+    };
+
+    auto findVector = [&] (uint32_t component, uint32_t count) {
+      for (const auto& t : types) {
+        const Ins& i = ins[t.second];
+        if (i.op == SpvOpTypeVector && word(i, 2) == component && word(i, 3) == count)
+          return t.first;
+      }
+      return 0u;
+    };
+
+    // The marked samples: explicit gradients on a cube image
+    std::vector<size_t> targets;
+
+    for (size_t k = 0; k < ins.size(); k++) {
+      const Ins& i = ins[k];
+
+      if (i.op != SpvOpImageSampleExplicitLod || i.len < 8u)
+        continue;
+
+      uint32_t mask = word(i, 5);
+      if (!(mask & SpvImageOperandsGrad) || (mask & (SpvImageOperandsBias | SpvImageOperandsLod)))
+        continue;
+
+      auto vt = valueTypes.find(word(i, 3));
+      const Ins* sampledType = vt != valueTypes.end() ? typeIns(vt->second) : nullptr;
+      const Ins* imageType = sampledType && sampledType->op == SpvOpTypeSampledImage ? typeIns(word(*sampledType, 2)) : nullptr;
+
+      if (imageType && imageType->op == SpvOpTypeImage && word(*imageType, 3) == SpvDimCube)
+        targets.push_back(k);
+    }
+
+    if (targets.empty() || !floatType)
+      return 0u;
+
+    // New ids from the bound
+    uint32_t bound = code[3];
+    auto newId = [&] () { return bound++; };
+
+    std::vector<uint32_t> decls;
+
+    if (!uintType) {
+      uintType = newId();
+      emit(decls, SpvOpTypeInt, { uintType, 32u, 0u });
+    }
+
+    if (!boolType) {
+      boolType = newId();
+      emit(decls, SpvOpTypeBool, { boolType });
+    }
+
+    uint32_t v3Type = findVector(floatType, 3u);
+    if (!v3Type) {
+      v3Type = newId();
+      emit(decls, SpvOpTypeVector, { v3Type, floatType, 3u });
+    }
+
+    uint32_t v2uType = findVector(uintType, 2u);
+    if (!v2uType) {
+      v2uType = newId();
+      emit(decls, SpvOpTypeVector, { v2uType, uintType, 2u });
+    }
+
+    if (!asType) {
+      asType = newId();
+      emit(decls, SpvOpTypeAccelerationStructureKHR, { asType });
+    }
+
+    if (!rqType) {
+      rqType = newId();
+      emit(decls, SpvOpTypeRayQueryKHR, { rqType });
+    }
+
+    uint32_t rqPtrType = newId();
+    emit(decls, SpvOpTypePointer, { rqPtrType, SpvStorageClassFunction, rqType });
+
+    uint32_t cUint0 = newId(), cUint1 = newId(), cFlags = newId(), cFloat0 = newId(), cFloat1 = newId();
+    uint32_t cAddrLo = newId(), cAddrHi = newId(), cAddr = newId();
+    float one = 1.0f, zero = 0.0f;
+    uint32_t oneBits, zeroBits;
+    std::memcpy(&oneBits, &one, 4u);
+    std::memcpy(&zeroBits, &zero, 4u);
+    emit(decls, SpvOpConstant, { uintType, cUint0, 0u });
+    emit(decls, SpvOpConstant, { uintType, cUint1, 1u });
+    emit(decls, SpvOpConstant, { uintType, cFlags, RayFlagsOpaqueTerminateOnFirstHit });
+    emit(decls, SpvOpConstant, { floatType, cFloat0, zeroBits });
+    emit(decls, SpvOpConstant, { floatType, cFloat1, oneBits });
+    emit(decls, SpvOpConstant, { uintType, cAddrLo, uint32_t(tlasAddress) });
+    emit(decls, SpvOpConstant, { uintType, cAddrHi, uint32_t(tlasAddress >> 32) });
+    emit(decls, SpvOpConstantComposite, { v2uType, cAddr, cAddrLo, cAddrHi });
+
+    // One ray query variable per function that holds a marked sample
+    std::unordered_set<size_t> targetSet(targets.begin(), targets.end());
+    std::unordered_map<size_t, uint32_t> functionLabels;   // index of the function's first OpLabel -> its variable
+
+    { size_t fnStart = SIZE_MAX, firstLabel = SIZE_MAX;
+      for (size_t k = 0; k < ins.size(); k++) {
+        if (ins[k].op == SpvOpFunction) {
+          fnStart = k;
+          firstLabel = SIZE_MAX;
+        } else if (ins[k].op == SpvOpLabel && fnStart != SIZE_MAX && firstLabel == SIZE_MAX) {
+          firstLabel = k;
+        } else if (targetSet.count(k) && firstLabel != SIZE_MAX && !functionLabels.count(firstLabel)) {
+          functionLabels[firstLabel] = newId();
+        }
+      }
+    }
+
+    // Rebuild the module
+    std::vector<uint32_t> out(code.begin(), code.begin() + 5u);
+    out.reserve(code.size() + decls.size() + targets.size() * 48u + 16u);
+
+    bool capabilityDone = false, extensionDone = false, declsDone = false;
+    uint32_t currentVar = 0u;
+
+    for (size_t k = 0; k < ins.size(); k++) {
+      const Ins& i = ins[k];
+
+      if (!extensionDone && i.op != SpvOpCapability && i.op != SpvOpExtension) {
+        emitString(out, SpvOpExtension, "SPV_KHR_ray_query");
+        extensionDone = true;
+      }
+
+      if (!declsDone && i.op == SpvOpFunction) {
+        out.insert(out.end(), decls.begin(), decls.end());
+        declsDone = true;
+      }
+
+      if (targetSet.count(k)) {
+        uint32_t resultType = word(i, 1), result = word(i, 2);
+        uint32_t coord = word(i, 4), dx = word(i, 6), dy = word(i, 7);
+
+        uint32_t origin = newId(), dir = newId(), tMin = newId(), tMax = newId(), maskF = newId(), mask = newId();
+        uint32_t as = newId(), proceed = newId(), type = newId(), none = newId(), vis = newId();
+
+        emit(out, SpvOpVectorShuffle, { v3Type, origin, coord, coord, 0u, 1u, 2u });
+        emit(out, SpvOpVectorShuffle, { v3Type, dir, dx, dx, 0u, 1u, 2u });
+        emit(out, SpvOpCompositeExtract, { floatType, tMin, dy, 0u });
+        emit(out, SpvOpCompositeExtract, { floatType, tMax, dy, 1u });
+        emit(out, SpvOpCompositeExtract, { floatType, maskF, dy, 2u });
+        emit(out, SpvOpConvertFToU, { uintType, mask, maskF });
+        emit(out, SpvOpConvertUToAccelerationStructureKHR, { asType, as, cAddr });
+        emit(out, SpvOpRayQueryInitializeKHR, { currentVar, as, cFlags, mask, origin, tMin, dir, tMax });
+        emit(out, SpvOpRayQueryProceedKHR, { boolType, proceed, currentVar });
+        emit(out, SpvOpRayQueryGetIntersectionTypeKHR, { uintType, type, currentVar, cUint1 });
+        emit(out, SpvOpIEqual, { boolType, none, type, cUint0 });
+        emit(out, SpvOpSelect, { floatType, vis, none, cFloat1, cFloat0 });
+
+        const Ins* rt = typeIns(resultType);
+        uint32_t count = rt && rt->op == SpvOpTypeVector ? word(*rt, 3) : 1u;
+
+        if (count <= 1u) {
+          emit(out, SpvOpCopyObject, { resultType, result, vis });
+        } else {
+          out.push_back(((3u + count) << 16) | SpvOpCompositeConstruct);
+          out.push_back(resultType);
+          out.push_back(result);
+          for (uint32_t c = 0; c < count; c++)
+            out.push_back(vis);
+        }
+        continue;
+      }
+
+      out.insert(out.end(), code.begin() + i.pos, code.begin() + i.pos + i.len);
+
+      if (i.op == SpvOpCapability && !capabilityDone) {
+        emit(out, SpvOpCapability, { SpvCapabilityRayQueryKHR });
+        capabilityDone = true;
+      }
+
+      if (i.op == SpvOpLabel) {
+        auto e = functionLabels.find(k);
+        if (e != functionLabels.end()) {
+          currentVar = e->second;
+          emit(out, SpvOpVariable, { rqPtrType, currentVar, SpvStorageClassFunction });
+        }
+      }
+    }
+
+    if (!declsDone || !capabilityDone)
+      return 0u;
+
+    out[3] = bound;
+    code = std::move(out);
+    return uint32_t(targets.size());
+  }
+
+
+
+  namespace {
+    std::atomic<uint64_t> g_tlasAddress    = { 0u };
+    std::atomic<bool>     g_cameraRelative = { false };
+    std::atomic<bool>     g_hook           = { false };
+    std::atomic<uint32_t> g_shaders        = { 0u };
+    std::atomic<uint32_t> g_samples        = { 0u };
+  }
+
+
+  void nvrRtSetTlas(uint64_t address, bool cameraRelative) {
+    g_cameraRelative.store(cameraRelative);
+    g_tlasAddress.store(address);
+  }
+
+
+  uint64_t nvrRtTlasAddress() {
+    return g_tlasAddress.load();
+  }
+
+
+  bool nvrRtTlasCameraRelative() {
+    return g_cameraRelative.load();
+  }
+
+
+  void nvrRtSetHook(bool enable) {
+    g_hook.store(enable);
+  }
+
+
+  bool nvrRtHookEnabled() {
+    return g_hook.load(std::memory_order_relaxed);
+  }
+
+
+  void nvrRtPatchLowered(std::vector<uint32_t>& code) {
+    if (!nvrRtHookEnabled())
+      return;
+
+    uint64_t address = g_tlasAddress.load();
+
+    if (!address)
+      return;
+
+    uint32_t samples = nvrPatchCubeGradRayQueries(code, address);
+
+    if (samples) {
+      g_shaders += 1u;
+      g_samples += samples;
+    }
+  }
+
+
+  void nvrRtGetStats(uint32_t* pShaders, uint32_t* pSamples) {
+    if (pShaders) *pShaders = g_shaders.load();
+    if (pSamples) *pSamples = g_samples.load();
+  }
+
+}
diff --git a/src/dxvk/dxvk_nvr_rtpatch.h b/src/dxvk/dxvk_nvr_rtpatch.h
new file mode 100644
index 0000000..0a5e008
--- /dev/null
+++ b/src/dxvk/dxvk_nvr_rtpatch.h
@@ -0,0 +1,56 @@
+#pragma once
+
+#include <cstdint>
+#include <vector>
+
+namespace dxvk {
+
+  /**
+   * \brief NVR RT lamp shadows: cube-gradient samples become ray queries
+   *
+   * NVR's lamp-shadow pixel shaders (PointShadowForward.hlsl, POINT_SHADOW_RT) mark each shadow ray as
+   * texCUBEgrad(cube, origin, segment, params), which no other shader uses. After DXVK has converted such a
+   * shader to SPIR-V, every OpImageSampleExplicitLod with Grad on a cube image is replaced by one opaque ray
+   * query against the TLAS at \c tlasAddress (baked as a constant; OpConvertUToAccelerationStructureKHR):
+   *
+   *   origin   = coordinate.xyz        (TLAS space)
+   *   segment  = dx.xyz                (the ray's direction, unnormalised: t runs 0..1 along it)
+   *   tMin     = dy.x, tMax = dy.y     (in units of the segment)
+   *   cullMask = uint(dy.z)            (instances whose mask shares no bit are skipped)
+   *   result   = 1.0 in every component when nothing is hit, 0.0 when something is
+   *
+   * Flags: opaque, terminate on first hit. The shader must keep 0 <= tMin <= tMax and finite inputs.
+   * Shaders without the marker are returned unchanged.
+   *
+   * \param [in,out] code SPIR-V words
+   * \param [in] tlasAddress Device address of the top-level acceleration structure
+   * \returns Number of samples replaced (0: the code is untouched)
+   */
+  uint32_t nvrPatchCubeGradRayQueries(std::vector<uint32_t>& code, uint64_t tlasAddress);
+
+  /**
+   * rief The TLAS the patched shaders trace against
+   *
+   * Set by the RT core (the TLAS owner) once its acceleration structure exists, and never moved after: the address is
+   * baked into every patched shader. \c cameraRelative: the TLAS's space is camera-relative world (else absolute world).
+   * An address of 0 withdraws it (shaders patched before keep the old address: the owner must keep it valid while the
+   * device lives).
+   */
+  void nvrRtSetTlas(uint64_t address, bool cameraRelative);
+
+  uint64_t nvrRtTlasAddress();
+
+  bool nvrRtTlasCameraRelative();
+
+  /** The hook (D3D9's ID3D9NvrExtRtLamp): while on, fragment shaders DXVK lowers to SPIR-V get the replacement. */
+  void nvrRtSetHook(bool enable);
+
+  bool nvrRtHookEnabled();
+
+  /** Applies the replacement to a lowered fragment shader when the hook is on and a TLAS is set (counted). */
+  void nvrRtPatchLowered(std::vector<uint32_t>& code);
+
+  /** Cumulative: lowerings patched, ray queries put in. */
+  void nvrRtGetStats(uint32_t* pShaders, uint32_t* pSamples);
+
+}

diff --git a/src/d3d9/d3d9_device.h b/src/d3d9/d3d9_device.h
index ebdf55e..4ffcc20 100644
--- a/src/d3d9/d3d9_device.h
+++ b/src/d3d9/d3d9_device.h
@@ -24,6 +24,7 @@
 #include "d3d9_nvr_ext.h"
 #include "d3d9_nvr_hdr.h"
 #include "d3d9_nvr_tess.h"
+#include "d3d9_nvr_rtlamp.h"
 #include "d3d9_on_12.h"
 
 #include <cstdint>
@@ -1704,6 +1705,7 @@ namespace dxvk {
     D3D9NvrExt                      m_nvrExt;

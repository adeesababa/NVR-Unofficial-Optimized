From 59692e0dec6346de23a540a03914a5ab4cb2ec67 Mon Sep 17 00:00:00 2001
From: adeesababa <rkwastavich@gmail.com>
Date: Wed, 28 Oct 2026 12:30:09 -0400
Subject: [PATCH 2/2] NVR rtlamp: the hook takes the RT core's scene address
 (ID3D9NvrExtRt 1.8-rt) instead of a TLAS owner hand-off

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/d3d9/d3d9_nvr_ext_api.h  | 22 ++++++++++++----------
 src/d3d9/d3d9_nvr_rtlamp.cpp | 27 ++++++++++-----------------
 src/d3d9/d3d9_nvr_rtlamp.h   |  7 ++-----
 3 files changed, 24 insertions(+), 32 deletions(-)

diff --git a/src/d3d9/d3d9_nvr_ext_api.h b/src/d3d9/d3d9_nvr_ext_api.h
index 863558e..df96f17 100644
--- a/src/d3d9/d3d9_nvr_ext_api.h
+++ b/src/d3d9/d3d9_nvr_ext_api.h
@@ -969,15 +969,17 @@ __CRT_UUID_DECL(ID3D9NvrExtSharedFence, 0x6e2b0f3a,0x9c14,0x4d57,0x8a,0x41,0xb2,
 
 /**
  * UNOFFICIAL 2026-10-28 "rtlamp" (fork patch nvr-rtlamp; docs/next/FORK-RT-LAMPS.md): ray queries inside D3D9 pixel shaders, for the
- * RT lamp shadows. With the hook on, every pixel shader created afterwards has each texCUBEgrad (texldd on a cube sampler; no game
- * or NVR shader samples a cube with gradients otherwise) replaced by one opaque ray query against the fork's TLAS:
- *   coordinate.xyz = origin (TLAS space), ddx.xyz = the ray (t 0..1 along it, unnormalised), ddy = (tMin, tMax, cull mask)
+ * RT lamp shadows, against a scene of the RT core (ID3D9NvrExtRt, "1.8-rt"). With the hook on, every pixel shader DXVK converts
+ * afterwards has each texCUBEgrad (texldd on a cube sampler; no game or NVR shader samples a cube with gradients otherwise)
+ * replaced by one opaque ray query against that scene, its address baked into the shader:
+ *   coordinate.xyz = origin (the scene's space: NVR's camera-relative world), ddx.xyz = the ray (t 0..1 along it, unnormalised),
+ *   ddy = (tMin, tMax, cull mask: ANDed with the instances' Mask)
  *   result = 1 in every component when nothing is hit, 0 when something is.
+ * The scene must stay alive while the device does (its address never changes: ID3D9NvrExtRtScene::GetAddress), and a shader
+ * may trace it only after a BuildScene (until then NVR keeps the rays switched off in its constants).
  * QueryInterface(__uuidof(ID3D9NvrExtRtLamp)); a d3d9.dll without it answers E_NOINTERFACE.
  */
-#define NVR_EXT_RTLAMP_USABLE                0x1u   /* the device has ray queries and the TLAS exists: the hook can be enabled */
-#define NVR_EXT_RTLAMP_TLAS_CAMERA_RELATIVE  0x2u   /* the TLAS is in camera-relative world space (else absolute world space) */
-#define NVR_EXT_RTLAMP_HOOK_ON               0x4u   /* EnableCubeGradRayQueries(TRUE) took */
+#define NVR_EXT_RTLAMP_HOOK_ON               0x1u   /* EnableCubeGradRayQueries took a scene */
 
 MIDL_INTERFACE("6e2b0f3a-9c14-4d57-8a41-b2f0c7a9d340")
 ID3D9NvrExtRtLamp : public IUnknown {
@@ -985,12 +987,12 @@ ID3D9NvrExtRtLamp : public IUnknown {
   virtual HRESULT STDMETHODCALLTYPE GetRayQueryInfo(
           UINT*                           pFlags) = 0;
 
-  /** On: pixel shaders created from now on get the replacement (before NVR loads its shaders). D3DERR_NOTAVAILABLE without
-      NVR_EXT_RTLAMP_USABLE. Off: later shaders are converted as by stock DXVK. */
+  /** SceneAddress != 0: pixel shaders converted from now on trace that scene (call before NVR loads its shaders). 0: later
+      shaders are converted as by stock DXVK. D3DERR_NOTAVAILABLE when the device has no ray queries. */
   virtual HRESULT STDMETHODCALLTYPE EnableCubeGradRayQueries(
-          BOOL                            Enable) = 0;
+          UINT64                          SceneAddress) = 0;
 
-  /** Cumulative: pixel shaders patched, ray queries put in (one per marked sample). */
+  /** Cumulative: shader conversions patched, ray queries put in (one per marked sample). */
   virtual HRESULT STDMETHODCALLTYPE GetRayQueryStats(
           UINT*                           pShaders,
           UINT*                           pSamples) = 0;
diff --git a/src/d3d9/d3d9_nvr_rtlamp.cpp b/src/d3d9/d3d9_nvr_rtlamp.cpp
index 7d955f0..aecc2e5 100644
--- a/src/d3d9/d3d9_nvr_rtlamp.cpp
+++ b/src/d3d9/d3d9_nvr_rtlamp.cpp
@@ -24,34 +24,27 @@ namespace dxvk {
   }
 
 
-  bool D3D9NvrRtLamp::Usable() const {
-    // The RT core sets a TLAS address only on a device it enabled ray queries and acceleration structures on
-    return nvrRtTlasAddress() != 0u;
-  }
-
-
   HRESULT STDMETHODCALLTYPE D3D9NvrRtLamp::GetRayQueryInfo(UINT* pFlags) {
     if (unlikely(pFlags == nullptr))
       return D3DERR_INVALIDCALL;
 
-    UINT flags = 0u;
-    if (Usable())                  flags |= NVR_EXT_RTLAMP_USABLE;
-    if (nvrRtTlasCameraRelative()) flags |= NVR_EXT_RTLAMP_TLAS_CAMERA_RELATIVE;
-    if (nvrRtHookEnabled())        flags |= NVR_EXT_RTLAMP_HOOK_ON;
-    *pFlags = flags;
+    *pFlags = nvrRtHookEnabled() && nvrRtTlasAddress() ? NVR_EXT_RTLAMP_HOOK_ON : 0u;
     return D3D_OK;
   }
 
 
-  HRESULT STDMETHODCALLTYPE D3D9NvrRtLamp::EnableCubeGradRayQueries(BOOL Enable) {
-    if (Enable && !Usable()) {
-      Logger::warn("NVR ext: rtlamp: ray queries requested but the device has none or no TLAS exists; the hook stays off");
+  HRESULT STDMETHODCALLTYPE D3D9NvrRtLamp::EnableCubeGradRayQueries(UINT64 SceneAddress) {
+    const auto& features = m_device->GetDXVKDevice()->features();
+
+    if (SceneAddress && !(features.khrRayQuery.rayQuery && features.khrAccelerationStructure.accelerationStructure)) {
+      Logger::warn("NVR ext: rtlamp: ray queries requested but the device has none; the hook stays off");
       return D3DERR_NOTAVAILABLE;
     }
 
-    nvrRtSetHook(Enable != FALSE);
-    Logger::info(str::format("NVR ext: rtlamp: cube-gradient ray queries ", Enable ? "on" : "off",
-      " for pixel shaders lowered from now on"));
+    nvrRtSetTlas(SceneAddress, true);
+    nvrRtSetHook(SceneAddress != 0u);
+    Logger::info(str::format("NVR ext: rtlamp: cube-gradient ray queries ", SceneAddress ? "on" : "off",
+      " for pixel shaders converted from now on"));
     return D3D_OK;
   }
 

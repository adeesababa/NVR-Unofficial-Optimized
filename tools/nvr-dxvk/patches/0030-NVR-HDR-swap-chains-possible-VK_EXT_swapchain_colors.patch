diff --git a/src/dxvk/dxvk_instance.h b/src/dxvk/dxvk_instance.h
index b302ae0..dd532e7 100644
--- a/src/dxvk/dxvk_instance.h
+++ b/src/dxvk/dxvk_instance.h
@@ -28,6 +28,9 @@ namespace dxvk {
   struct DxvkInstanceExtensionInfo {
     VkExtensionProperties extDebugUtils               = vk::makeExtension(VK_EXT_DEBUG_UTILS_EXTENSION_NAME);
     VkExtensionProperties extSurfaceMaintenance1      = vk::makeExtension(VK_EXT_SURFACE_MAINTENANCE_1_EXTENSION_NAME);
+    /// NVR: an instance extension (the device table's extSwapchainColorSpace is never found, so it stays 0 there).
+    /// Without it the driver reports only SRGB_NONLINEAR surface formats and HDR10 / scRGB swap chains are impossible.
+    VkExtensionProperties extSwapchainColorSpace      = vk::makeExtension(VK_EXT_SWAPCHAIN_COLOR_SPACE_EXTENSION_NAME);
     VkExtensionProperties khrGetSurfaceCapabilities2  = vk::makeExtension(VK_KHR_GET_SURFACE_CAPABILITIES_2_EXTENSION_NAME);
     VkExtensionProperties khrSurface                  = vk::makeExtension(VK_KHR_SURFACE_EXTENSION_NAME);
     VkExtensionProperties khrSurfaceMaintenance1      = vk::makeExtension(VK_KHR_SURFACE_MAINTENANCE_1_EXTENSION_NAME);
diff --git a/src/dxvk/dxvk_presenter.cpp b/src/dxvk/dxvk_presenter.cpp
index f0d2651..46ffc07 100644
--- a/src/dxvk/dxvk_presenter.cpp
+++ b/src/dxvk/dxvk_presenter.cpp
@@ -326,6 +326,21 @@ namespace dxvk {
   }
 
 
+  std::vector<VkSurfaceFormatKHR> Presenter::listSurfaceFormats() {
+    std::lock_guard lock(m_surfaceMutex);
+
+    std::vector<VkSurfaceFormatKHR> surfaceFormats;
+
+    if (!m_surface && createSurface() != VK_SUCCESS)
+      return surfaceFormats;
+
+    if (getSupportedFormats(surfaceFormats) != VK_SUCCESS)
+      surfaceFormats.clear();
+
+    return surfaceFormats;
+  }
+
+
   void Presenter::invalidateSurface() {
     std::lock_guard lock(m_surfaceMutex);
 
@@ -762,6 +777,7 @@ namespace dxvk {
       "Presenter: Actual swapchain properties:"
       "\n  Format:       ", swapInfo.imageFormat,
       "\n  Color space:  ", swapInfo.imageColorSpace,
+      "\n  Requested:    ", m_preferredFormat.format, " / ", m_preferredFormat.colorSpace,
       "\n  Present mode: ", swapInfo.presentMode, " (dynamic: ", (dynamicModes.empty() ? "no)" : "yes)"),
       "\n  Buffer size:  ", swapInfo.imageExtent.width, "x", swapInfo.imageExtent.height,
       "\n  Image count:  ", swapInfo.minImageCount));
diff --git a/src/dxvk/dxvk_presenter.h b/src/dxvk/dxvk_presenter.h
index 48fa292..064d3f5 100644
--- a/src/dxvk/dxvk_presenter.h
+++ b/src/dxvk/dxvk_presenter.h
@@ -197,6 +197,13 @@ namespace dxvk {
      */
     bool supportsColorSpace(VkColorSpaceKHR colorspace);
 
+    /**
+     * \brief NVR: the surface formats the surface offers (for the HDR log)
+     *
+     * \returns The formats, empty if there is no surface
+     */
+    std::vector<VkSurfaceFormatKHR> listSurfaceFormats();
+

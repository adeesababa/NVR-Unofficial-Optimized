index 0000000..a03dfe6
--- /dev/null
+++ b/src/d3d9/d3d9_nvr_hdr.h
@@ -0,0 +1,87 @@
+#pragma once
+
+/*
+ * NVR extension 1.5-hdr: HDR output (ID3D9NvrExtHdr, see d3d9_nvr_ext_api.h).
+ *
+ * The game's back buffer stays 8-bit SDR. The swap chain is switched to HDR10 or scRGB
+ * (the colour space machinery DXVK's ID3D9VkExtSwapchain already has), and the present
+ * blit (DxvkSwapchainBlitter, DxvkNvrHdrBlit) turns the SDR back buffer into HDR: decoded,
+ * at NVR's paper white, times NVR's per-pixel highlight gain where no HUD drew over NVR's
+ * picture (compared with a copy NVR marks before the HUD).
+ */
+
+#include "d3d9_nvr_ext_api.h"
+#include "d3d9_include.h"
+
+#include "../dxvk/dxvk_buffer.h"
+#include "../dxvk/dxvk_image.h"
+
+namespace dxvk {
+
+  class D3D9DeviceEx;
+  class D3D9SwapChainEx;
+
+  /** Per swap chain HDR state (owned by D3D9SwapChainEx, set through D3D9NvrExtHdr). */
+  struct D3D9NvrHdrState {
+    uint32_t          mode            = NVR_EXT_HDR_OFF;
+    float             paperWhiteNits  = 200.0f;
+    float             peakNits        = 1000.0f;
+    float             hudThreshold    = 1.5f / 255.0f;
+    uint32_t          flags           = 0u;
+
+    Rc<DxvkImage>     ref;            // copy of NVR's picture before the HUD
+    Rc<DxvkImage>     gain;           // copy of NVR's gain
+    bool              marked          = false;   // ref/gain hold this frame's data
+    bool              warnedMark      = false;
+
+    bool              captureRequested = false;
+    bool              captureRecorded  = false;
+    Rc<DxvkImage>     captureImage;
+    Rc<DxvkBuffer>    captureBuffer;
+    VkExtent2D        captureExtent   = { 0u, 0u };
+  };
+
+  /**
+   * \brief The HDR interface, owned by the D3D9 device (its reference count is the device's)
+   */
+  class D3D9NvrExtHdr final : public ID3D9NvrExtHdr {
+
+  public:
+
+    explicit D3D9NvrExtHdr(D3D9DeviceEx* pDevice);
+
+    ULONG STDMETHODCALLTYPE AddRef();
+
+    ULONG STDMETHODCALLTYPE Release();
+
+    HRESULT STDMETHODCALLTYPE QueryInterface(REFIID riid, void** ppvObject);
+
+    HRESULT STDMETHODCALLTYPE GetHdrInfo(
+            NVR_EXT_HDR_INFO*               pInfo);
+
+    HRESULT STDMETHODCALLTYPE SetHdrOutput(
+      const NVR_EXT_HDR_OUTPUT*             pOutput);
+
+    HRESULT STDMETHODCALLTYPE MarkHdrScene(
+            IUnknown*                       pScene,
+            IUnknown*                       pGain);
+
+    HRESULT STDMETHODCALLTYPE RequestHdrCapture();
+
+    HRESULT STDMETHODCALLTYPE ReadHdrCapture(
+            UINT*                           pWidth,
+            UINT*                           pHeight,
+            void*                           pData,
+            UINT                            Size);
+
+  private:
+
+    D3D9SwapChainEx* GetSwapChain() const;
+
+    static Rc<DxvkImage> ResolveImage(IUnknown* pResource, VkImageSubresourceLayers& layers);
+
+    D3D9DeviceEx* m_device;
+
+  };
+
+}

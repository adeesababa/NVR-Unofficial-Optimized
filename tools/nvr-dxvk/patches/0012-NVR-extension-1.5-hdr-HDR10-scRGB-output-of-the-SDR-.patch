new file mode 100755
index 0000000..d0e5482
--- /dev/null
+++ b/src/d3d9/d3d9_nvr_hdr.cpp
@@ -0,0 +1,318 @@
+#include "d3d9_nvr_hdr.h"
+#include "d3d9_device.h"
+#include "d3d9_swapchain.h"
+#include "d3d9_common_texture.h"
+#include "d3d9_surface.h"
+#include "d3d9_texture.h"
+
+#include "../dxvk/dxvk_context.h"
+
+#include <algorithm>
+#include <cstring>
+
+namespace dxvk {
+
+  static const char* NvrHdrModeName(uint32_t mode) {
+    switch (mode) {
+      case NVR_EXT_HDR_HDR10: return "HDR10 (ST.2084, 10-bit)";
+      case NVR_EXT_HDR_SCRGB: return "scRGB (FP16 linear)";
+      default:                return "SDR";
+    }
+  }
+
+
+  D3D9NvrExtHdr::D3D9NvrExtHdr(D3D9DeviceEx* pDevice)
+  : m_device(pDevice) {
+
+  }
+
+
+  ULONG STDMETHODCALLTYPE D3D9NvrExtHdr::AddRef() {
+    return m_device->AddRef();
+  }
+
+
+  ULONG STDMETHODCALLTYPE D3D9NvrExtHdr::Release() {
+    return m_device->Release();
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9NvrExtHdr::QueryInterface(REFIID riid, void** ppvObject) {
+    return m_device->QueryInterface(riid, ppvObject);
+  }
+
+
+  D3D9SwapChainEx* D3D9NvrExtHdr::GetSwapChain() const {
+    D3D9SwapChainEx* swapchain = m_device->m_implicitSwapchain.ptr();
+    return (swapchain && swapchain->m_wctx && swapchain->m_wctx->presenter != nullptr) ? swapchain : nullptr;
+  }
+
+
+  Rc<DxvkImage> D3D9NvrExtHdr::ResolveImage(IUnknown* pResource, VkImageSubresourceLayers& layers) {
+    layers = { };
+    layers.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    layers.layerCount = 1u;
+
+    if (pResource == nullptr)
+      return nullptr;
+
+    Com<IDirect3DResource9> resource;
+    if (FAILED(pResource->QueryInterface(__uuidof(IDirect3DResource9), reinterpret_cast<void**>(&resource))))
+      return nullptr;
+
+    D3D9CommonTexture* texture = nullptr;
+
+    switch (resource->GetType()) {
+      case D3DRTYPE_SURFACE: {
+        D3D9Surface* s = static_cast<D3D9Surface*>(static_cast<IDirect3DSurface9*>(resource.ptr()));
+        texture = s->GetCommonTexture();
+        layers.mipLevel = s->GetMipLevel();
+        layers.baseArrayLayer = s->GetFace();
+      } break;
+
+      case D3DRTYPE_TEXTURE:
+        texture = GetCommonTexture(static_cast<IDirect3DBaseTexture9*>(resource.ptr()));
+        break;
+
+      default:
+        return nullptr;
+    }
+
+    return texture ? texture->GetImage() : nullptr;
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9NvrExtHdr::GetHdrInfo(NVR_EXT_HDR_INFO* pInfo) {
+    D3D9DeviceLock lock = m_device->LockDevice();
+
+    if (unlikely(pInfo == nullptr))
+      return D3DERR_INVALIDCALL;
+
+    *pInfo = NVR_EXT_HDR_INFO();
+
+    D3D9SwapChainEx* swapchain = GetSwapChain();
+    if (unlikely(swapchain == nullptr))
+      return D3DERR_INVALIDCALL;
+
+    const Rc<Presenter>& presenter = swapchain->m_wctx->presenter;
+    pInfo->SupportsHdr10 = presenter->supportsColorSpace(VK_COLOR_SPACE_HDR10_ST2084_EXT);
+    pInfo->SupportsScRgb = presenter->supportsColorSpace(VK_COLOR_SPACE_EXTENDED_SRGB_LINEAR_EXT);
+
+    D3D9VkExtOutputMetadata desc = { };
+    if (SUCCEEDED(swapchain->m_swapchainExt.GetCurrentOutputDesc(&desc))) {
+      pInfo->DisplayMinNits          = desc.MinLuminance;
+      pInfo->DisplayMaxNits          = desc.MaxLuminance;
+      pInfo->DisplayMaxFullFrameNits = desc.MaxFullFrameLuminance;
+    }
+
+    pInfo->ActiveMode = swapchain->m_nvrHdr.mode;
+    return D3D_OK;
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9NvrExtHdr::SetHdrOutput(const NVR_EXT_HDR_OUTPUT* pOutput) {
+    D3D9DeviceLock lock = m_device->LockDevice();
+
+    if (unlikely(pOutput == nullptr || pOutput->Mode > NVR_EXT_HDR_SCRGB))
+      return D3DERR_INVALIDCALL;
+
+    D3D9SwapChainEx* swapchain = GetSwapChain();
+    if (unlikely(swapchain == nullptr))
+      return D3DERR_INVALIDCALL;
+
+    const float paperWhite = std::clamp(float(pOutput->PaperWhiteNits), 10.0f, 10000.0f);
+    const float peak = std::clamp(float(pOutput->PeakNits), paperWhite, 10000.0f);
+    const float maxFall = pOutput->MaxFrameAverageNits > 0.0f
+      ? std::clamp(float(pOutput->MaxFrameAverageNits), 1.0f, peak) : paperWhite;
+
+    VkColorSpaceKHR colorSpace = VK_COLOR_SPACE_SRGB_NONLINEAR_KHR;
+    if (pOutput->Mode == NVR_EXT_HDR_HDR10) colorSpace = VK_COLOR_SPACE_HDR10_ST2084_EXT;
+    if (pOutput->Mode == NVR_EXT_HDR_SCRGB) colorSpace = VK_COLOR_SPACE_EXTENDED_SRGB_LINEAR_EXT;
+
+    const Rc<Presenter>& presenter = swapchain->m_wctx->presenter;
+
+    if (pOutput->Mode != NVR_EXT_HDR_OFF && !presenter->supportsColorSpace(colorSpace)) {
+      Logger::warn(str::format("NVR ext: HDR: the surface does not offer ", NvrHdrModeName(pOutput->Mode), "; output stays SDR"));
+      return D3DERR_NOTAVAILABLE;
+    }
+
+    D3D9NvrHdrState& state = swapchain->m_nvrHdr;
+    const bool changed = state.mode != pOutput->Mode || state.paperWhiteNits != paperWhite || state.peakNits != peak;
+
+    state.mode           = pOutput->Mode;
+    state.paperWhiteNits = paperWhite;
+    state.peakNits       = peak;
+    state.hudThreshold   = std::clamp(float(pOutput->HudThreshold), 0.0f, 1.0f);
+    state.flags          = pOutput->Flags;
+
+    if (state.mode != NVR_EXT_HDR_OFF) {
+      // Rec.2020 primaries + D65 for HDR10, Rec.709 for scRGB (what the content uses)
+      VkHdrMetadataEXT metadata = { VK_STRUCTURE_TYPE_HDR_METADATA_EXT };
+      if (state.mode == NVR_EXT_HDR_HDR10) {
+        metadata.displayPrimaryRed   = { 0.708f, 0.292f };
+        metadata.displayPrimaryGreen = { 0.170f, 0.797f };
+        metadata.displayPrimaryBlue  = { 0.131f, 0.046f };
+      } else {
+        metadata.displayPrimaryRed   = { 0.640f, 0.330f };
+        metadata.displayPrimaryGreen = { 0.300f, 0.600f };
+        metadata.displayPrimaryBlue  = { 0.150f, 0.060f };
+      }
+      metadata.whitePoint                = { 0.3127f, 0.3290f };
+      metadata.maxLuminance              = peak;
+      metadata.minLuminance              = 0.0f;
+      metadata.maxContentLightLevel      = peak;
+      metadata.maxFrameAverageLightLevel = maxFall;
+
+      swapchain->m_hdrMetadata = metadata;
+      presenter->setHdrMetadata(metadata);
+    } else {
+      swapchain->m_hdrMetadata = std::nullopt;
+      presenter->setHdrMetadata(VkHdrMetadataEXT());   // no sType: clears it
+      state.ref = nullptr;
+      state.gain = nullptr;
+      state.marked = false;
+    }
+
+    if (swapchain->m_colorspace != colorSpace) {
+      swapchain->m_colorspace = colorSpace;
+      presenter->setSurfaceFormat(swapchain->GetSurfaceFormat());
+    }
+
+    if (changed) {
+      Logger::info(str::format("NVR ext: HDR output ", NvrHdrModeName(state.mode),
+        state.mode != NVR_EXT_HDR_OFF ? str::format(": paper white ", paperWhite, " nits, peak ", peak, " nits, MaxFALL ", maxFall) : std::string()));
+    }
+
+    return D3D_OK;
+  }
+
+
+  static Rc<DxvkImage> NvrHdrCopyImage(const Rc<DxvkDevice>& device, VkFormat format, VkExtent3D extent, const char* name) {
+    DxvkImageCreateInfo info = { };
+    info.type        = VK_IMAGE_TYPE_2D;
+    info.format      = format;
+    info.sampleCount = VK_SAMPLE_COUNT_1_BIT;
+    info.extent      = { extent.width, extent.height, 1u };
+    info.numLayers   = 1u;
+    info.mipLevels   = 1u;
+    info.usage       = VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_SAMPLED_BIT;
+    info.stages      = VK_PIPELINE_STAGE_TRANSFER_BIT | VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT;
+    info.access      = VK_ACCESS_TRANSFER_WRITE_BIT | VK_ACCESS_SHADER_READ_BIT;
+    info.tiling      = VK_IMAGE_TILING_OPTIMAL;
+    info.layout      = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+    info.colorSpace  = VK_COLOR_SPACE_SRGB_NONLINEAR_KHR;
+    info.debugName   = name;
+    return device->createImage(info, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9NvrExtHdr::MarkHdrScene(IUnknown* pScene, IUnknown* pGain) {
+    D3D9DeviceLock lock = m_device->LockDevice();
+
+    D3D9SwapChainEx* swapchain = GetSwapChain();
+    if (unlikely(swapchain == nullptr))
+      return D3DERR_INVALIDCALL;
+
+    D3D9NvrHdrState& state = swapchain->m_nvrHdr;
+    if (state.mode == NVR_EXT_HDR_OFF)
+      return S_FALSE;
+
+    VkImageSubresourceLayers sceneLayers, gainLayers;
+    Rc<DxvkImage> scene = ResolveImage(pScene, sceneLayers);
+    Rc<DxvkImage> gain  = ResolveImage(pGain, gainLayers);
+
+    if (unlikely(scene == nullptr || gain == nullptr)) {
+      if (!std::exchange(state.warnedMark, true))
+        Logger::err("NVR ext: HDR: MarkHdrScene: not a D3D9 surface or 2D texture");
+      return D3DERR_INVALIDCALL;
+    }
+
+    VkExtent3D sceneExtent = scene->mipLevelExtent(sceneLayers.mipLevel);
+    VkExtent3D gainExtent  = gain->mipLevelExtent(gainLayers.mipLevel);
+
+    if (unlikely(sceneExtent.width != gainExtent.width || sceneExtent.height != gainExtent.height
+      || scene->info().sampleCount != VK_SAMPLE_COUNT_1_BIT || gain->info().sampleCount != VK_SAMPLE_COUNT_1_BIT
+      || !(scene->info().usage & VK_IMAGE_USAGE_TRANSFER_SRC_BIT) || !(gain->info().usage & VK_IMAGE_USAGE_TRANSFER_SRC_BIT))) {
+      if (!std::exchange(state.warnedMark, true))
+        Logger::err(str::format("NVR ext: HDR: MarkHdrScene: picture ", sceneExtent.width, "x", sceneExtent.height,
+          " and gain ", gainExtent.width, "x", gainExtent.height, " must be single-sampled, copyable and the same size"));
+      return D3DERR_INVALIDCALL;
+    }
+
+    const Rc<DxvkDevice>& device = m_device->GetDXVKDevice();
+    sceneExtent.depth = 1u;
+
+    if (state.ref == nullptr || state.ref->info().format != scene->info().format || state.ref->info().extent != sceneExtent)
+      state.ref = NvrHdrCopyImage(device, scene->info().format, sceneExtent, "NVR HDR reference");
+
+    if (state.gain == nullptr || state.gain->info().format != gain->info().format || state.gain->info().extent != sceneExtent)
+      state.gain = NvrHdrCopyImage(device, gain->info().format, sceneExtent, "NVR HDR gain");
+
+    VkImageSubresourceLayers dstLayers = { };
+    dstLayers.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    dstLayers.layerCount = 1u;
+
+    m_device->EmitCs([
+      cRef         = state.ref,
+      cGainCopy    = state.gain,
+      cScene       = std::move(scene),
+      cGain        = std::move(gain),
+      cSceneLayers = sceneLayers,
+      cGainLayers  = gainLayers,
+      cDstLayers   = dstLayers,
+      cExtent      = sceneExtent
+    ] (DxvkContext* ctx) {
+      ctx->copyImage(cRef, cDstLayers, VkOffset3D { 0, 0, 0 }, cScene, cSceneLayers, VkOffset3D { 0, 0, 0 }, cExtent);
+      ctx->copyImage(cGainCopy, cDstLayers, VkOffset3D { 0, 0, 0 }, cGain, cGainLayers, VkOffset3D { 0, 0, 0 }, cExtent);
+    });
+
+    state.marked = true;
+    return D3D_OK;
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9NvrExtHdr::RequestHdrCapture() {
+    D3D9DeviceLock lock = m_device->LockDevice();
+
+    D3D9SwapChainEx* swapchain = GetSwapChain();
+    if (unlikely(swapchain == nullptr))
+      return D3DERR_INVALIDCALL;
+
+    swapchain->m_nvrHdr.captureRequested = true;
+    return D3D_OK;
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9NvrExtHdr::ReadHdrCapture(UINT* pWidth, UINT* pHeight, void* pData, UINT Size) {
+    D3D9DeviceLock lock = m_device->LockDevice();
+
+    D3D9SwapChainEx* swapchain = GetSwapChain();
+    if (unlikely(swapchain == nullptr))
+      return D3DERR_INVALIDCALL;
+
+    D3D9NvrHdrState& state = swapchain->m_nvrHdr;
+    if (!state.captureRecorded || state.captureBuffer == nullptr)
+      return S_FALSE;
+
+    if (pWidth)  *pWidth  = state.captureExtent.width;
+    if (pHeight) *pHeight = state.captureExtent.height;
+
+    if (pData == nullptr)
+      return D3D_OK;
+
+    const size_t bytes = size_t(state.captureExtent.width) * state.captureExtent.height * 8u;
+    if (unlikely(Size < bytes))
+      return D3DERR_INVALIDCALL;
+
+    // Flushes, waits for the CS thread and then for the GPU (test use only)
+    m_device->WaitForResource(*state.captureBuffer, DxvkCsThread::SynchronizeAll, D3DLOCK_READONLY);
+
+    const void* mapped = state.captureBuffer->mapPtr(0u);
+    if (unlikely(mapped == nullptr))
+      return D3DERR_INVALIDCALL;
+

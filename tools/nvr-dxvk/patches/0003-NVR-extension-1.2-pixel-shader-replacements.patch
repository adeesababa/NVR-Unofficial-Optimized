+
+  std::string D3D9NvrExt::HashBytecode(const void* pBytecode, size_t Length) {
+    auto hasher = dxbc_spv::util::md5::Hasher();
+    hasher.update(pBytecode, Length);
+    auto digest = hasher.finalize();
+
+    std::string result;
+    for (size_t i = 0; i < digest.data.size(); i++) {
+      static const char hex[] = "0123456789abcdef";
+      result.push_back(hex[digest.data[i] >> 4]);
+      result.push_back(hex[digest.data[i] & 0xF]);
+    }
+    return result;
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9NvrExt::RegisterShaderReplacement(const NVR_EXT_SHADER_REPLACEMENT_DESC* pDesc) {
+    if (unlikely(pDesc == nullptr || pDesc->pBytecode == nullptr || pDesc->BytecodeSize < 8u
+              || pDesc->pSpirv == nullptr || pDesc->SpirvSize < 20u || (pDesc->SpirvSize & 3u)))
+      return D3DERR_INVALIDCALL;
+
+    const char* name = pDesc->pDebugName ? pDesc->pDebugName : "NVR replacement";
+
+    // The shader's own length (the game passes bytecode without a size; DXVK measures it the same way)
+    dxbc_spv::util::ByteReader reader(pDesc->pBytecode, pDesc->BytecodeSize);
+    D3D9ShaderAnalysis analysis(reader, false);
+
+    if (unlikely(!analysis || analysis.GetShaderInfo().getType() != dxbc_spv::sm3::ShaderType::ePixel)) {
+      Logger::err(str::format("NVR ext: ", name, ": the bytecode is not a usable D3D9 pixel shader"));
+      return D3DERR_INVALIDCALL;
+    }
+
+    if (unlikely(pDesc->ExtraCount > NVR_EXT_MAX_BINDINGS || (pDesc->ExtraCount && pDesc->pExtra == nullptr)))
+      return D3DERR_INVALIDCALL;
+
+    Replacement r;
+    r.spirv.resize(pDesc->SpirvSize / 4u);
+    std::memcpy(r.spirv.data(), pDesc->pSpirv, pDesc->SpirvSize);
+    r.textureMask = pDesc->TextureMask & 0xFFFFu;
+    for (size_t i = 0; i < r.floatMask.size(); i++)
+      r.floatMask[i] = pDesc->FloatRegisterMask[i];
+    r.name = name;
+
+    uint32_t samplerCount = 0u;
+    for (uint32_t j = 0; j < pDesc->ExtraCount; j++) {
+      const auto& e = pDesc->pExtra[j];
+      if (unlikely(e.Slot >= NVR_EXT_MAX_SLOTS || e.Type == NVR_EXT_BIND_STORAGE_IMAGE
+                || (e.Type == NVR_EXT_BIND_STORAGE_BUFFER && e.Writes)
+                || (e.Type == NVR_EXT_BIND_SAMPLER && samplerCount++ >= 8u))) {
+        Logger::err(str::format("NVR ext: ", name, ": extra binding ", j, " is not allowed (slot range, storage image, written buffer or more than 8 samplers)"));
+        return D3DERR_INVALIDCALL;
+      }
+      D3D9NvrExtBindingInfo own;
+      own.slot = e.Slot;
+      own.type = e.Type;
+      own.viewType = e.ViewType;
+      own.writes = false;
+      r.extras.push_back(own);
+      r.extraBindings.push_back(std::make_pair(e.Binding, j));
+    }
+
+    uint32_t originalSamplers = analysis.GetSamplerMask();
+    if (unlikely(r.textureMask & ~originalSamplers)) {
+      Logger::err(str::format("NVR ext: ", name, ": TextureMask ", r.textureMask, " uses samplers the original shader does not (its mask ", originalSamplers, ")"));
+      return D3DERR_INVALIDCALL;
+    }
+
+    std::string key = HashBytecode(pDesc->pBytecode, analysis.GetLength());
+
+    std::lock_guard lock(m_replacementMutex);
+    m_replacements[key] = std::move(r);
+    Logger::info(str::format("NVR ext: pixel shader replacement '", name, "' registered for ", key, " (", analysis.GetLength(), " bytes of bytecode)"));
+    return D3D_OK;
+  }
+
+
+  Rc<DxvkShader> D3D9NvrExt::BuildReplacementShader(
+          D3D9ShaderType                  ShaderType,
+    const void*                           pBytecode,
+          size_t                          BytecodeLength,
+          D3D9ShaderAnalysis&             Analysis) {
+    if (ShaderType != D3D9ShaderType::PixelShader)
+      return nullptr;
+
+    Replacement r;
+
+    { std::lock_guard lock(m_replacementMutex);
+      if (m_replacements.empty())
+        return nullptr;
+
+      auto entry = m_replacements.find(HashBytecode(pBytecode, BytecodeLength));
+      if (entry == m_replacements.end())
+        return nullptr;
+
+      r = entry->second;
+    }
+
+    small_vector<DxvkBindingInfo, 32> bindings;
+
+    // D3D9 textures and their samplers, exactly where the device binds them
+    for (uint32_t i = 0; i < 16u; i++) {
+      if (!(r.textureMask & (1u << i)))
+        continue;
+
+      uint32_t index = D3D9ShaderResourceMapping::computeTextureBinding(D3D9ShaderType::PixelShader, i);
+
+      DxvkBindingInfo tex = { };
+      tex.set = 1u;
+      tex.binding = i;
+      tex.resourceIndex = index;
+      tex.descriptorType = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE;
+      tex.descriptorCount = 1u;
+      tex.viewType = Analysis.GetImageViewType(i);
+      if (tex.viewType == VK_IMAGE_VIEW_TYPE_MAX_ENUM)
+        tex.viewType = VK_IMAGE_VIEW_TYPE_2D;
+      tex.access = VK_ACCESS_SHADER_READ_BIT;
+      bindings.push_back(tex);
+
+      DxvkBindingInfo smp = { };
+      smp.resourceIndex = index;
+      smp.descriptorType = VK_DESCRIPTOR_TYPE_SAMPLER;
+      smp.descriptorCount = 1u;
+      smp.blockOffset = MaxSharedPushDataSize + sizeof(uint16_t) * i;
+      smp.flags.set(DxvkDescriptorFlag::PushData);
+      bindings.push_back(smp);
+    }
+
+    // The stage's float (and int) constants
+    DxvkBindingInfo cbv = { };
+    cbv.set = 2u;
+    cbv.binding = D3D9ShaderResourceMapping::CbvIndex::PSStaticConstants;
+    cbv.resourceIndex = D3D9ShaderResourceMapping::CbvIndex::PSStaticConstants;
+    cbv.descriptorType = VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER;
+    cbv.descriptorCount = 1u;
+    cbv.access = VK_ACCESS_UNIFORM_READ_BIT;
+    cbv.flags.set(DxvkDescriptorFlag::UniformBuffer);
+    bindings.push_back(cbv);
+
+    // NVR's own resources (extension slots), and their samplers after the D3D9 ones in push data
+    uint32_t extraSampler = 0u;
+    for (size_t k = 0; k < r.extras.size(); k++) {
+      const auto& e = r.extras[k];
+      uint32_t binding = r.extraBindings[k].first;
+
+      DxvkBindingInfo info = { };
+      info.set = 4u;
+      info.binding = binding;
+      info.descriptorCount = 1u;
+
+      switch (e.type) {
+        case NVR_EXT_BIND_SAMPLED_IMAGE:
+          info.resourceIndex = NvrExtImageSlotBase + e.slot;
+          info.descriptorType = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE;
+          info.viewType = DecodeNvrViewType(e.viewType);
+          info.access = VK_ACCESS_SHADER_READ_BIT;
+          break;
+        case NVR_EXT_BIND_UNIFORM_BUFFER:
+          info.resourceIndex = NvrExtBufferSlotBase + e.slot;
+          info.descriptorType = VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER;
+          info.access = VK_ACCESS_UNIFORM_READ_BIT;
+          info.flags.set(DxvkDescriptorFlag::UniformBuffer);
+          break;
+        case NVR_EXT_BIND_STORAGE_BUFFER:
+          info.resourceIndex = NvrExtBufferSlotBase + e.slot;
+          info.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+          info.access = VK_ACCESS_SHADER_READ_BIT;
+          info.flags.set(DxvkDescriptorFlag::UniformBuffer);
+          break;
+        case NVR_EXT_BIND_SAMPLER:
+          info.resourceIndex = NvrExtSamplerSlotBase + e.slot;
+          info.descriptorType = VK_DESCRIPTOR_TYPE_SAMPLER;
+          info.blockOffset = MaxSharedPushDataSize + 32u + sizeof(uint16_t) * (extraSampler++);
+          info.flags.set(DxvkDescriptorFlag::PushData);
+          break;
+        default:
+          break;
+      }
+
+      bindings.push_back(info);
+    }
+
+    // Another set of float constants than the original's: a layout the device uploads instead
+    bool customFloats = false;
+    for (uint32_t m : r.floatMask)
+      customFloats |= m != 0u;
+
+    if (customFloats) {
+      const auto* original = Analysis.GetConstantLayout();
+      D3D9ConstantBufferLayout floats(uint32_t(r.floatMask.size()), r.floatMask.data());
+      Analysis.SetConstantLayout(D3D9ConstantBufferCopy::getOrCreate(floats,
+        original->getLayout(D3D9ConstantType::Int), original->getLayout(D3D9ConstantType::Bool)));
+    }
+
+    DxvkSpirvShaderCreateInfo info;
+    info.bindingCount = bindings.size();
+    info.bindings = bindings.data();
+    info.flatShadingInputs = Analysis.GetFlatShadingMask();
+    info.sharedPushData = DxvkPushDataBlock(0u, sizeof(D3D9SharedPushData), 4u, 0u);
+    // 16 D3D9 sampler indices (8 dwords) then up to 8 extra ones (4 dwords), all resource data
+    info.localPushData = DxvkPushDataBlock(VK_SHADER_STAGE_FRAGMENT_BIT, MaxSharedPushDataSize, 48u, 4u, 0xFFFu);
+    info.samplerHeap = DxvkShaderBinding(VK_SHADER_STAGE_FRAGMENT_BIT, 0u, 0u);
+    info.specDataBuffer = DxvkShaderBinding(VK_SHADER_STAGE_FRAGMENT_BIT, 3u, 0u);
+    info.debugName = r.name;
+
+    try {
+      Rc<DxvkShader> shader = new DxvkSpirvShader(info, SpirvCodeBuffer(uint32_t(r.spirv.size()), r.spirv.data()));
+
+      if (shader->metadata().stage != VK_SHADER_STAGE_FRAGMENT_BIT) {
+        Logger::err(str::format("NVR ext: ", r.name, ": the replacement SPIR-V is not a fragment shader; the original is used"));
+        return nullptr;
+      }
+
+      m_device->GetDXVKDevice()->registerShader(shader);
+      Logger::info(str::format("NVR ext: pixel shader replaced by '", r.name, "'"));
+      return shader;
+    } catch (const DxvkError& e) {
+      Logger::err(str::format("NVR ext: ", r.name, ": ", e.message(), "; the original is used"));
+      return nullptr;
+    }
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9NvrExt::SetReplacementResources(
+          UINT                            Count,
+    const NVR_EXT_RESOURCE_BINDING*       pBindings) {
+    D3D9DeviceLock lock = m_device->LockDevice();
+
+    small_vector<D3D9NvrExtBound, 8> bound;
+
+    HRESULT hr = ResolveBindings(nullptr, Count, pBindings, bound);
+
+    if (FAILED(hr))
+      return hr;
+
+    m_device->EmitCs([
+      cBound = std::move(bound)
+    ] (DxvkContext* ctx) {
+      NvrBindResources(ctx, VK_SHADER_STAGE_FRAGMENT_BIT, cBound);
+    });
+
+    return D3D_OK;
+  }
+
+
   HRESULT STDMETHODCALLTYPE D3D9NvrExt::UpdateBuffer(
           ID3D9NvrExtBuffer*              pBuffer,
           UINT                            Offset,

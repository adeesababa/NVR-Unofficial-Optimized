+namespace dxvk {
+
+  D3D9NvrTess::D3D9NvrTess(D3D9DeviceEx* pDevice)
+  : m_device(pDevice) {
+
+  }
+
+
+  D3D9NvrTess::~D3D9NvrTess() {
+
+  }
+
+
+  ULONG STDMETHODCALLTYPE D3D9NvrTess::AddRef() {
+    return m_device->AddRef();
+  }
+
+
+  ULONG STDMETHODCALLTYPE D3D9NvrTess::Release() {
+    return m_device->Release();
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9NvrTess::QueryInterface(REFIID riid, void** ppvObject) {
+    return m_device->QueryInterface(riid, ppvObject);
+  }
+
+
+  std::string D3D9NvrTess::HashBytecode(const void* pBytecode, size_t Length) {
+    auto hasher = dxbc_spv::util::md5::Hasher();
+    hasher.update(pBytecode, Length);
+    auto digest = hasher.finalize();
+
+    std::string result;
+    for (size_t i = 0; i < digest.data.size(); i++) {
+      static const char hex[] = "0123456789abcdef";
+      result.push_back(hex[digest.data[i] >> 4]);
+      result.push_back(hex[digest.data[i] & 0xF]);
+    }
+    return result;
+  }
+
+
+  static bool NvrTessCopySpirv(const void* pSpirv, UINT Size, std::vector<uint32_t>& Words) {
+    Words.clear();
+
+    if (pSpirv == nullptr || Size < 20u || (Size & 3u))
+      return false;
+
+    Words.resize(Size / 4u);
+    std::memcpy(Words.data(), pSpirv, Size);
+    return Words[0] == 0x07230203u;   // the SPIR-V magic number
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9NvrTess::RegisterTessVertexShader(const NVR_EXT_TESS_VS_DESC* pDesc) {
+    if (unlikely(pDesc == nullptr || pDesc->pBytecode == nullptr || pDesc->BytecodeSize < 8u || !pDesc->Family))
+      return D3DERR_INVALIDCALL;
+
+    const char* name = pDesc->pDebugName ? pDesc->pDebugName : "NVR tessellated vertex shader";
+
+    if (!m_device->GetDXVKDevice()->features().core.features.tessellationShader) {
+      Logger::warn(str::format("NVR tess: ", name, ": this GPU has no tessellation shaders; it stays as it is"));
+      return D3DERR_NOTAVAILABLE;
+    }
+
+    dxbc_spv::util::ByteReader reader(pDesc->pBytecode, pDesc->BytecodeSize);
+    D3D9ShaderAnalysis analysis(reader, false);
+
+    if (unlikely(!analysis || analysis.GetShaderInfo().getType() != dxbc_spv::sm3::ShaderType::eVertex)) {
+      Logger::err(str::format("NVR tess: ", name, ": the bytecode is not a usable D3D9 vertex shader"));
+      return D3DERR_INVALIDCALL;
+    }
+
+    PendingVs p;
+
+    if (!NvrTessCopySpirv(pDesc->pControlSpirv, pDesc->ControlSpirvSize, p.tcs)) {
+      Logger::err(str::format("NVR tess: ", name, ": the tessellation control shader is not SPIR-V"));
+      return D3DERR_INVALIDCALL;
+    }
+
+    for (uint32_t k = 0; k < 4u; k++)
+      p.vsRegs[k] = pDesc->VsFloatRegisters[k];
+
+    p.family = pDesc->Family;
+    p.name = name;
+
+    std::string key = HashBytecode(pDesc->pBytecode, analysis.GetLength());
+
+    D3D9DeviceLock lock = m_device->LockDevice();
+
+    { std::lock_guard guard(m_mutex);
+      m_vs[key] = std::move(p);
+    }
+
+    m_extraStages = VK_SHADER_STAGE_TESSELLATION_EVALUATION_BIT;
+    m_used.store(true);
+
+    Logger::info(str::format("NVR tess: vertex shader '", name, "' registered for ", key, " (family ", pDesc->Family, ")"));
+    return D3D_OK;
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9NvrTess::RegisterTessPixelShader(const NVR_EXT_TESS_PS_DESC* pDesc) {
+    if (unlikely(pDesc == nullptr || pDesc->pBytecode == nullptr || pDesc->BytecodeSize < 8u || !pDesc->Family))
+      return D3DERR_INVALIDCALL;
+
+    const char* name = pDesc->pDebugName ? pDesc->pDebugName : "NVR tessellated pixel shader";
+
+    if (!m_device->GetDXVKDevice()->features().core.features.tessellationShader)
+      return D3DERR_NOTAVAILABLE;
+
+    dxbc_spv::util::ByteReader reader(pDesc->pBytecode, pDesc->BytecodeSize);
+    D3D9ShaderAnalysis analysis(reader, false);
+
+    if (unlikely(!analysis || analysis.GetShaderInfo().getType() != dxbc_spv::sm3::ShaderType::ePixel)) {
+      Logger::err(str::format("NVR tess: ", name, ": the bytecode is not a usable D3D9 pixel shader"));
+      return D3DERR_INVALIDCALL;
+    }
+
+    if (unlikely(pDesc->TextureMask & ~0xFFu)) {
+      Logger::err(str::format("NVR tess: ", name, ": TextureMask names a sampler above s7"));
+      return D3DERR_INVALIDCALL;
+    }
+
+    if (unlikely(pDesc->TextureMask & ~analysis.GetSamplerMask())) {
+      Logger::err(str::format("NVR tess: ", name, ": TextureMask ", pDesc->TextureMask, " names samplers the pixel shader does not use (its mask ",
+        analysis.GetSamplerMask(), "); it stays as it is"));
+      return D3DERR_INVALIDCALL;
+    }
+
+    PendingPs p;
+
+    if (!NvrTessCopySpirv(pDesc->pEvalSpirv[0], pDesc->EvalSpirvSize[0], p.tes[0])) {
+      Logger::err(str::format("NVR tess: ", name, ": the tessellation evaluation shader is not SPIR-V"));
+      return D3DERR_INVALIDCALL;
+    }
+
+    if (pDesc->pEvalSpirv[1] && !NvrTessCopySpirv(pDesc->pEvalSpirv[1], pDesc->EvalSpirvSize[1], p.tes[1])) {
+      Logger::err(str::format("NVR tess: ", name, ": the second tessellation evaluation shader is not SPIR-V"));
+      return D3DERR_INVALIDCALL;
+    }
+
+    p.textureMask = pDesc->TextureMask;
+    p.psRegs = { pDesc->PsFloatRegisters[0], pDesc->PsFloatRegisters[1] };
+    p.family = pDesc->Family;
+    p.name = name;
+
+    std::string key = HashBytecode(pDesc->pBytecode, analysis.GetLength());
+
+    D3D9DeviceLock lock = m_device->LockDevice();
+
+    { std::lock_guard guard(m_mutex);
+      m_ps[key] = std::move(p);
+    }
+
+    m_extraStages = VK_SHADER_STAGE_TESSELLATION_EVALUATION_BIT;
+    m_used.store(true);
+    return D3D_OK;
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9NvrTess::SetTessState(const NVR_EXT_TESS_STATE* pState) {
+    if (unlikely(pState == nullptr || pState->Winding > 1u))
+      return D3DERR_INVALIDCALL;
+
+    D3D9DeviceLock lock = m_device->LockDevice();
+
+    if (std::memcmp(&m_state, pState, sizeof(m_state))) {
+      m_state = *pState;
+      m_stateId++;
+    }
+
+    return D3D_OK;
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9NvrTess::GetTessStats(NVR_EXT_TESS_STATS* pStats) {
+    if (unlikely(pStats == nullptr))
+      return D3DERR_INVALIDCALL;
+
+    D3D9DeviceLock lock = m_device->LockDevice();
+
+    *pStats = m_stats;
+    pStats->RefusedPairs = m_refused.load();
+    return D3D_OK;
+  }
+
+
+  Rc<DxvkShader> D3D9NvrTess::CreateControlShader(const std::vector<uint32_t>& Spirv, const std::string& Name) {
+    std::string key = "tcs" + HashBytecode(Spirv.data(), Spirv.size() * sizeof(uint32_t));
+
+    auto entry = m_shaderCache.find(key);
+    if (entry != m_shaderCache.end())
+      return entry->second;
+
+    DxvkSpirvShaderCreateInfo info;
+    // ControlParams: 8 floats, the stage's own push block. It starts at shader offset 32 (MaxSharedPushDataSize), as in
+    // DXVK's own D3D9 shaders: offsets 0-31 are the shared block (D3D9's fog / alpha-ref data, every graphics stage), and a
+    // stage block declared from offset 0 is remapped onto that shared data (round 2 of the bulk test: the TCS read its
+    // first four parameters from D3D9's fog data and never split anything; the TES read its sampler indices from it).
+    // The host side still pushes from the stage's offset 0 (shader offset 32 + x <-> pushData(stage, x)).
+    info.localPushData = DxvkPushDataBlock(VK_SHADER_STAGE_TESSELLATION_CONTROL_BIT, MaxSharedPushDataSize, 32u, 4u, 0u);
+    info.patchVertexCount = 3u;
+    info.debugName = Name;
+
+    try {
+      Rc<DxvkShader> shader = new DxvkSpirvShader(info, SpirvCodeBuffer(uint32_t(Spirv.size()), Spirv.data()));
+
+      if (shader->metadata().stage != VK_SHADER_STAGE_TESSELLATION_CONTROL_BIT) {
+        Logger::err(str::format("NVR tess: ", Name, ": the SPIR-V is not a tessellation control shader"));
+        return nullptr;
+      }
+
+      m_shaderCache.insert({ key, shader });
+      return shader;
+    } catch (const DxvkError& e) {
+      Logger::err(str::format("NVR tess: ", Name, ": ", e.message()));
+      return nullptr;
+    }
+  }
+
+
+  Rc<DxvkShader> D3D9NvrTess::CreateEvalShader(const std::vector<uint32_t>& Spirv, uint32_t TextureMask, const std::string& Name) {
+    std::string key = "tes" + std::to_string(TextureMask) + HashBytecode(Spirv.data(), Spirv.size() * sizeof(uint32_t));
+
+    auto entry = m_shaderCache.find(key);
+    if (entry != m_shaderCache.end())
+      return entry->second;
+
+    small_vector<DxvkBindingInfo, 24> bindings;
+
+    // The pixel shader's textures and samplers, where the device binds them for the pixel shader
+    for (uint32_t i = 0; i < 8u; i++) {
+      if (!(TextureMask & (1u << i)))
+        continue;
+
+      uint32_t index = D3D9ShaderResourceMapping::computeTextureBinding(D3D9ShaderType::PixelShader, i);
+
+      DxvkBindingInfo tex = { };
+      tex.set = 1u;
+      tex.binding = i;
+      tex.resourceIndex = index;
+      tex.descriptorType = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE;
+      tex.descriptorCount = 1u;
+      tex.viewType = VK_IMAGE_VIEW_TYPE_2D;
+      tex.access = VK_ACCESS_SHADER_READ_BIT;
+      bindings.push_back(tex);
+
+      DxvkBindingInfo smp = { };
+      smp.resourceIndex = index;
+      smp.descriptorType = VK_DESCRIPTOR_TYPE_SAMPLER;
+      smp.descriptorCount = 1u;
+      smp.blockOffset = MaxSharedPushDataSize + sizeof(uint16_t) * i;   // shader offset (see CreateControlShader)
+      smp.flags.set(DxvkDescriptorFlag::PushData);
+      bindings.push_back(smp);
+    }
+
+    // The vertex shader's float constants (the same buffer the vertex shader reads)
+    DxvkBindingInfo vsc = { };
+    vsc.set = 2u;
+    vsc.binding = 0u;
+    vsc.resourceIndex = D3D9ShaderResourceMapping::CbvIndex::VSStaticConstants;
+    vsc.descriptorType = VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER;
+    vsc.descriptorCount = 1u;
+    vsc.access = VK_ACCESS_UNIFORM_READ_BIT;
+    vsc.flags.set(DxvkDescriptorFlag::UniformBuffer);
+    bindings.push_back(vsc);
+
+    // D3D9's user clip planes, as DXVK's converted vertex shaders read them
+    DxvkBindingInfo clip = vsc;
+    clip.binding = 1u;
+    clip.resourceIndex = D3D9ShaderResourceMapping::CbvIndex::VSClipPlanes;
+    bindings.push_back(clip);
+
+    DxvkSpirvShaderCreateInfo info;
+    info.bindingCount = bindings.size();
+    info.bindings = bindings.data();
+    // From shader offset 32 (MaxSharedPushDataSize, see CreateControlShader): 4 dwords of sampler heap indices (resource
+    // data), then vsIndex, psBits and EvalParams[4] (pushed at the stage's offset 16)
+    info.localPushData = DxvkPushDataBlock(VK_SHADER_STAGE_TESSELLATION_EVALUATION_BIT, MaxSharedPushDataSize, 40u, 4u, 0xFu);
+    info.samplerHeap = DxvkShaderBinding(VK_SHADER_STAGE_TESSELLATION_EVALUATION_BIT, 0u, 0u);
+    info.debugName = Name;
+
+    try {
+      Rc<DxvkShader> shader = new DxvkSpirvShader(info, SpirvCodeBuffer(uint32_t(Spirv.size()), Spirv.data()));
+
+      if (shader->metadata().stage != VK_SHADER_STAGE_TESSELLATION_EVALUATION_BIT) {
+        Logger::err(str::format("NVR tess: ", Name, ": the SPIR-V is not a tessellation evaluation shader"));
+        return nullptr;
+      }
+
+      m_shaderCache.insert({ key, shader });
+      return shader;
+    } catch (const DxvkError& e) {
+      Logger::err(str::format("NVR tess: ", Name, ": ", e.message()));
+      return nullptr;
+    }
+  }
+
+
+  void D3D9NvrTess::Attach(
+          D3D9ShaderType                  ShaderType,
+    const void*                           pBytecode,
+          size_t                          BytecodeLength,
+          D3D9CommonShader&               Shader) {
+    if (likely(!m_used.load()))
+      return;
+
+    std::string key = HashBytecode(pBytecode, BytecodeLength);
+
+    std::lock_guard guard(m_mutex);
+
+    if (ShaderType == D3D9ShaderType::VertexShader) {
+      auto entry = m_vs.find(key);
+      if (entry == m_vs.end())
+        return;
+
+      PendingVs& p = entry->second;
+
+      if (!p.created) {
+        auto object = std::make_unique<D3D9NvrTessVs>();
+        object->name = p.name;
+        object->family = p.family;
+        object->tcs = CreateControlShader(p.tcs, p.name + " TCS");
+
+        if (object->tcs == nullptr) {
+          m_vs.erase(entry);
+          return;
+        }
+
+        // Where the TES finds each listed register in the vertex shader's compacted float constants
+        const D3D9ConstantBufferCopy* layout = Shader.GetConstantLayout();
+        uint32_t packed = 0u;
+
+        for (uint32_t k = 0; k < 4u; k++) {
+          uint32_t index = 0xFFu;
+
+          if (layout != nullptr && p.vsRegs[k] < 256u) {
+            auto found = layout->getLayout(D3D9ConstantType::Float).findConstant(p.vsRegs[k]);
+
+            if (found && *found < 0xFFu)
+              index = *found;
+          }
+
+          packed |= index << (8u * k);
+        }
+
+        object->vsIndex = packed;
+        p.created = object.get();
+        m_vsObjects.push_back(std::move(object));
+        m_stats.VertexShaders++;
+
+        Logger::info(str::format("NVR tess: vertex shader '", p.name, "' created with its TCS (constant indices ",
+          packed & 0xFFu, " ", (packed >> 8u) & 0xFFu, " ", (packed >> 16u) & 0xFFu, " ", packed >> 24u, ")"));
+      }
+
+      Shader.SetNvrTessVs(p.created);
+    } else {
+      auto entry = m_ps.find(key);
+      if (entry == m_ps.end())
+        return;
+
+      PendingPs& p = entry->second;
+
+      if (!p.created) {
+        auto object = std::make_unique<D3D9NvrTessPs>();
+        object->name = p.name;
+        object->family = p.family;
+        object->psRegs = p.psRegs;
+        object->tes[0] = CreateEvalShader(p.tes[0], p.textureMask, p.name + " TES");
+
+        if (!p.tes[1].empty())
+          object->tes[1] = CreateEvalShader(p.tes[1], p.textureMask, p.name + " TES ccw");
+
+        if (object->tes[0] == nullptr || (!p.tes[1].empty() && object->tes[1] == nullptr)) {
+          m_ps.erase(entry);
+          return;
+        }
+
+        p.created = object.get();
+        m_psObjects.push_back(std::move(object));
+        m_stats.PixelShaders++;
+      }
+
+      Shader.SetNvrTessPs(p.created);
+    }
+  }
+
+
+  uint32_t D3D9NvrTess::ComputePsBits(const D3D9NvrTessPs* Ps) const {
+    uint32_t bits = 0u;
+
+    for (uint32_t j = 0; j < 2u; j++) {
+      uint32_t reg = Ps->psRegs[j];
+
+      if (reg >= caps::MaxSM3FloatConstantsPS)
+        continue;
+
+      const auto& value = m_device->m_state.psConsts->fConsts[reg];
+
+      for (uint32_t k = 0; k < 4u; k++) {
+        if (value.data[k] > 0.0f)
+          bits |= 1u << (4u * j + k);
+      }
+    }
+
+    return bits;
+  }
+
+
+  /** Whether a stage's outputs hold an input (same location, the components covered). */
+  static bool NvrTessProduces(const DxvkShaderIo& Outputs, const DxvkShaderIoVar& Input) {
+    for (uint32_t j = 0; j < Outputs.getVarCount(); j++) {
+      DxvkShaderIoVar o = Outputs.getVar(j);
+
+      if (o.builtIn != spv::BuiltInMax || o.isPatchConstant || o.location != Input.location)
+        continue;
+
+      if (o.componentIndex <= Input.componentIndex
+       && o.componentIndex + o.componentCount >= Input.componentIndex + Input.componentCount)
+        return true;
+    }
+
+    return false;
+  }
+
+
+  /**
+   * The interface check, once per registered shader, on the CS thread (where DXVK itself reads shader metadata):
+   * the TCS reads only what the vertex shader writes; the TES writes every input of the pixel shader that the
+   * vertex shader writes (an input the vertex shader does not write either is filled in by DXVK as before).
+   */
+  static bool NvrTessCheck(
+          DxvkShader*             Vs,
+          DxvkShader*             Tcs,
+          DxvkShader*             Tes,
+          DxvkShader*             Fs,
+          D3D9NvrTessVs*          VsAttach,
+          D3D9NvrTessPs*          PsAttach,
+          std::atomic<uint32_t>*  Refused) {
+    if (VsAttach->io.load() == 0 && Vs != nullptr) {
+      bool ok = DxvkShaderIo::checkStageCompatibility(VK_SHADER_STAGE_TESSELLATION_CONTROL_BIT, Tcs->metadata().inputs,
+        VK_SHADER_STAGE_VERTEX_BIT, Vs->metadata().outputs, false);
+
+      VsAttach->io.store(ok ? 1 : -1);
+
+      if (ok) {
+        Logger::info(str::format("NVR tess: '", VsAttach->name, "': its TCS reads what the vertex shader writes"));
+      } else {
+        Logger::err(str::format("NVR tess: '", VsAttach->name, "': the TCS reads inputs the vertex shader does not write; drawn without tessellation"));
+        Refused->fetch_add(1u);
+      }
+    }
+
+    if (PsAttach->io.load() == 0 && Vs != nullptr && Fs != nullptr) {
+      const DxvkShaderIo& fsInputs = Fs->metadata().inputs;
+      const DxvkShaderIo& vsOutputs = Vs->metadata().outputs;
+      const DxvkShaderIo& tesOutputs = Tes->metadata().outputs;
+
+      bool ok = true;
+
+      for (uint32_t i = 0; i < fsInputs.getVarCount(); i++) {
+        DxvkShaderIoVar input = fsInputs.getVar(i);
+
+        if (input.builtIn != spv::BuiltInMax)
+          continue;
+
+        if (NvrTessProduces(vsOutputs, input) && !NvrTessProduces(tesOutputs, input)) {
+          Logger::err(str::format("NVR tess: '", PsAttach->name, "': the pixel shader reads location ", uint32_t(input.location),
+            " (component ", uint32_t(input.componentIndex), "+", uint32_t(input.componentCount), "), which the TES does not write; drawn without tessellation"));
+          ok = false;
+        }
+      }
+
+      PsAttach->io.store(ok ? 1 : -1);
+
+      if (ok)
+        Logger::info(str::format("NVR tess: '", PsAttach->name, "': its TES writes everything the pixel shader reads"));
+      else
+        Refused->fetch_add(1u);
+    }
+
+    return VsAttach->io.load() > 0 && PsAttach->io.load() > 0;
+  }
+
+
+  bool D3D9NvrTess::ApplyDraw(D3DPRIMITIVETYPE PrimType) {
+    const D3D9NvrTessVs* vs = nullptr;
+    const D3D9NvrTessPs* ps = nullptr;
+    const D3D9CommonShader* vsShader = nullptr;
+    const D3D9CommonShader* psShader = nullptr;
+
+    // Only DrawPrimitive / DrawIndexedPrimitive (BeginDraw) can issue a strip as three patch lists
+    const bool stripsOk = std::exchange(m_stripsOk, false);
+    m_stripPending = false;
+
+    if (m_state.Enable && m_device->UseProgrammableVS() && m_device->UseProgrammablePS() && !m_device->CanSWVP()) {
+      vsShader = GetCommonShader(m_device->m_state.vertexShader);
+      psShader = GetCommonShader(m_device->m_state.pixelShader);
+
+      vs = vsShader ? vsShader->GetNvrTessVs() : nullptr;
+      ps = psShader ? psShader->GetNvrTessPs() : nullptr;
+
+      if (vs == nullptr || ps == nullptr || vs->family != ps->family || vs->io.load() < 0 || ps->io.load() < 0) {
+        vs = nullptr;
+        ps = nullptr;
+      } else if (PrimType != D3DPT_TRIANGLELIST && !(PrimType == D3DPT_TRIANGLESTRIP && stripsOk)) {
+        m_stats.OtherTopologyDraws++;
+
+        if (!m_loggedOther) {
+          m_loggedOther = true;
+          Logger::warn(str::format("NVR tess: '", vs->name, "' / '", ps->name, "' drawn with D3D9 primitive type ", uint32_t(PrimType),
+            " (or a strip through DrawPrimitiveUP): left untessellated (only triangle lists and DrawPrimitive / DrawIndexedPrimitive strips are tessellated)"));
+        }
+
+        vs = nullptr;
+        ps = nullptr;
+      }
+    }
+
+    if (vs == nullptr) {
+      if (m_boundVs == nullptr)
+        return false;
+
+      // Back to the normal pipeline
+      m_boundVs = nullptr;
+      m_boundPs = nullptr;
+      m_device->m_iaState.primitiveType = PrimType;
+
+      m_device->EmitCs([
+        cPrimType = PrimType
+      ] (DxvkContext* ctx) {
+        ctx->bindShader<VK_SHADER_STAGE_TESSELLATION_CONTROL_BIT>(nullptr);
+        ctx->bindShader<VK_SHADER_STAGE_TESSELLATION_EVALUATION_BIT>(nullptr);
+        ctx->setInputAssemblyState(DecodeInputAssemblyState(cPrimType));
+      });
+
+      if (m_boundWire) {
+        m_boundWire = false;
+        m_device->BindRasterizerState();
+      }
+
+      return true;
+    }
+
+    m_stats.TessellatedDraws++;
+
+    // A strip is issued by EmitStripDraw (the device's draw call asks StripPending after its PrepareDraw)
+    m_stripPending = PrimType == D3DPT_TRIANGLESTRIP;
+
+    uint32_t psBits = ComputePsBits(ps);
+
+    if (vs == m_boundVs && ps == m_boundPs && m_boundState == m_stateId && psBits == m_boundPsBits)
+      return true;
+
+    m_stats.Bindings++;
+
+    bool check = vs->io.load() == 0 || ps->io.load() == 0;
+    uint32_t winding = (m_state.Winding && ps->tes[1] != nullptr) ? 1u : 0u;
+
+    std::array<float, 8> tcsData;
+    for (uint32_t i = 0; i < 8u; i++)
+      tcsData[i] = m_state.ControlParams[i];
+
+    // ControlParams[7] is DXVK's: -1 = a triangle list; 0, 1, 2 = which index window of a strip (EmitStripDraw)
+    tcsData[7] = -1.0f;
+
+    std::array<uint32_t, 6> tesData;
+    tesData[0] = vs->vsIndex;
+    tesData[1] = psBits;
+    for (uint32_t i = 0; i < 4u; i++)
+      tesData[2u + i] = bit::cast<uint32_t>(m_state.EvalParams[i]);
+
+    m_device->EmitCs([
+      cTcs      = vs->tcs,
+      cTes      = ps->tes[winding],
+      cVs       = check ? vsShader->GetShader() : Rc<DxvkShader>(),
+      cFs       = check ? psShader->GetShader() : Rc<DxvkShader>(),
+      cVsAttach = const_cast<D3D9NvrTessVs*>(vs),
+      cPsAttach = const_cast<D3D9NvrTessPs*>(ps),
+      cRefused  = &m_refused,
+      cPrimType = PrimType,
+      cTcsData  = tcsData,
+      cTesData  = tesData
+    ] (DxvkContext* ctx) mutable {
+      bool ok = NvrTessCheck(cVs.ptr(), cTcs.ptr(), cTes.ptr(), cFs.ptr(), cVsAttach, cPsAttach, cRefused);
+
+      if (ok) {
+        ctx->bindShader<VK_SHADER_STAGE_TESSELLATION_CONTROL_BIT>(Rc<DxvkShader>(cTcs));
+        ctx->bindShader<VK_SHADER_STAGE_TESSELLATION_EVALUATION_BIT>(Rc<DxvkShader>(cTes));
+
+        DxvkInputAssemblyState ia(VK_PRIMITIVE_TOPOLOGY_PATCH_LIST, false);
+        ia.setPatchVertexCount(3u);
+        ctx->setInputAssemblyState(ia);
+
+        ctx->pushData(VK_SHADER_STAGE_TESSELLATION_CONTROL_BIT, 0u, sizeof(cTcsData), cTcsData.data());
+        // after the 16 bytes of sampler heap indices, which DXVK fills in
+        ctx->pushData(VK_SHADER_STAGE_TESSELLATION_EVALUATION_BIT, 16u, sizeof(cTesData), cTesData.data());
+      } else {
+        ctx->bindShader<VK_SHADER_STAGE_TESSELLATION_CONTROL_BIT>(nullptr);
+        ctx->bindShader<VK_SHADER_STAGE_TESSELLATION_EVALUATION_BIT>(nullptr);
+        ctx->setInputAssemblyState(DecodeInputAssemblyState(cPrimType));
+      }
+    });
+
+    m_boundVs = vs;
+    m_boundPs = ps;
+    // While the interface check is still to be answered on the CS thread, every draw binds again (each such bind sets
+    // the topology for its own draw, so a refused pair never draws with another draw's topology)
+    m_boundState = check ? 0u : m_stateId;
+    m_boundPsBits = psBits;
+    m_device->m_iaState.primitiveType = PrimType;
+
+    bool wire = m_state.Wireframe != 0u;
+
+    if (wire != m_boundWire) {
+      m_boundWire = wire;
+      m_device->BindRasterizerState();   // consults WireframeActive()
+    }
+
+    return true;
+  }
+
+
+  void D3D9NvrTess::EmitStripDraw(bool Indexed, uint32_t First, uint32_t Count, int32_t BaseVertex, uint32_t InstanceCount) {
+    m_stripPending = false;
+
+    if (!m_loggedStrip && m_boundVs && m_boundPs) {
+      m_loggedStrip = true;
+      Logger::info(str::format("NVR tess: '", m_boundVs->name, "' / '", m_boundPs->name, "' come as triangle strips: each strip is",
+        " tessellated as three patch lists (its index windows from the first, second and third index)"));
+    }
+
+    m_device->EmitCs([
+      cIndexed   = Indexed,
+      cFirst     = First,
+      cCount     = Count,
+      cBase      = BaseVertex,
+      cInstances = InstanceCount,
+      cVsAttach  = m_boundVs,
+      cPsAttach  = m_boundPs,
+      &cIaState  = m_device->m_iaState
+    ] (DxvkContext* ctx) {
+      uint32_t instances = cInstances;
+
+      // As DrawIndexedPrimitive: no instancing when no instanced binding is used
+      if (unlikely(cIaState.streamsInstanced && !(cIaState.streamsInstanced & cIaState.streamsUsed)))
+        instances = 1u;
+
+      if (cVsAttach == nullptr || cPsAttach == nullptr || cVsAttach->io.load() <= 0 || cPsAttach->io.load() <= 0) {
+        // Refused by the interface check (this draw's bind put the strip topology back): the strip as it is
+        if (cIndexed) {
+          VkDrawIndexedIndirectCommand draw = { cCount, instances, cFirst, cBase, 0u };
+          ctx->drawIndexed(1u, &draw);
+        } else {
+          VkDrawIndirectCommand draw = { cCount, 1u, cFirst, 0u };
+          ctx->draw(1u, &draw);
+        }
+        return;
+      }
+
+      // Strip triangle i = (i, i + 1, i + 2). Window k (k = 0, 1, 2) as a patch list from index k: its patch p is
+      // strip triangle k + 3p, so the three windows hold every triangle of the strip exactly once.
+      for (uint32_t k = 0; k < 3u; k++) {
+        if (cCount < 3u + k)
+          break;
+
+        uint32_t patches = (cCount - 3u - k) / 3u + 1u;
+        float window = float(k);
+        ctx->pushData(VK_SHADER_STAGE_TESSELLATION_CONTROL_BIT, 28u, sizeof(window), &window);
+
+        if (cIndexed) {
+          VkDrawIndexedIndirectCommand draw = { 3u * patches, instances, cFirst + k, cBase, 0u };
+          ctx->drawIndexed(1u, &draw);
+        } else {
+          VkDrawIndirectCommand draw = { 3u * patches, 1u, cFirst + k, 0u };
+          ctx->draw(1u, &draw);
+        }
+      }
+
+      float list = -1.0f;
+      ctx->pushData(VK_SHADER_STAGE_TESSELLATION_CONTROL_BIT, 28u, sizeof(list), &list);
+    });
+  }
+
+}
diff --git a/src/d3d9/d3d9_nvr_tess.h b/src/d3d9/d3d9_nvr_tess.h
new file mode 100644
index 0000000..97b5a5b
--- /dev/null
+++ b/src/d3d9/d3d9_nvr_tess.h
@@ -0,0 +1,190 @@
+#pragma once
+
+/*
+ * NVR extension, tessellation displacement ("1.7-displace", fork patch 0021): the implementation of
+ * ID3D9NvrExtTess (d3d9_nvr_ext_api.h). Opt-in per registered shader pair: a draw whose vertex and pixel
+ * shaders NVR registered under one family (and which is a triangle list) gets NVR's TCS and TES bound
+ * and a patch-list topology; every other draw takes DXVK's normal path, untouched.
+ */
+
+#include "d3d9_nvr_ext_api.h"
+#include "d3d9_include.h"
+#include "d3d9_multithread.h"
+
+#include "../dxvk/dxvk_shader.h"
+
+#include "../util/thread.h"
+
+#include <array>
+#include <atomic>
+#include <memory>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+namespace dxvk {
+
+  class D3D9DeviceEx;
+  class D3D9CommonShader;
+
+  /** A registered vertex shader once created: its TCS and the indices the TES needs. Lives as long as the device. */
+  struct D3D9NvrTessVs {
+    std::string           name;
+    uint32_t              family  = 0u;
+    Rc<DxvkShader>        tcs;
+    uint32_t              vsIndex = 0xFFFFFFFFu;  // 4 x u8: compacted VS float index of VsFloatRegisters[k]
+    std::atomic<int32_t>  io      = { 0 };        // interface check (CS thread): 0 not yet, 1 passed, -1 refused
+  };
+
+  /** A registered pixel shader once created: its TES (one per winding) and the registers read per draw. */
+  struct D3D9NvrTessPs {
+    std::string                   name;
+    uint32_t                      family = 0u;
+    std::array<Rc<DxvkShader>, 2> tes;
+    std::array<uint32_t, 2>       psRegs = { 0xFFFFFFFFu, 0xFFFFFFFFu };
+    std::atomic<int32_t>          io     = { 0 };
+  };
+
+  class D3D9NvrTess final : public ID3D9NvrExtTess {
+
+  public:
+
+    explicit D3D9NvrTess(D3D9DeviceEx* pDevice);
+
+    ~D3D9NvrTess();
+
+    ULONG STDMETHODCALLTYPE AddRef();
+
+    ULONG STDMETHODCALLTYPE Release();
+
+    HRESULT STDMETHODCALLTYPE QueryInterface(REFIID riid, void** ppvObject);
+
+    HRESULT STDMETHODCALLTYPE RegisterTessVertexShader(
+      const NVR_EXT_TESS_VS_DESC*           pDesc);
+
+    HRESULT STDMETHODCALLTYPE RegisterTessPixelShader(
+      const NVR_EXT_TESS_PS_DESC*           pDesc);
+
+    HRESULT STDMETHODCALLTYPE SetTessState(
+      const NVR_EXT_TESS_STATE*             pState);
+
+    HRESULT STDMETHODCALLTYPE GetTessStats(
+            NVR_EXT_TESS_STATS*             pStats);
+
+    /** Whether anything was ever registered: until then the device skips every hook (one branch per draw). */
+    bool IsUsed() const {
+      return m_used.load(std::memory_order_relaxed);
+    }
+
+    /**
+     * \brief Extra stages for the pixel shader's texture bindings
+     *
+     * The TES reads pixel shader textures. With pipeline libraries the TES's descriptors live in the
+     * pre-rasterization set, which DXVK refreshes only when a pre-rasterization stage's bindings change:
+     * once anything is registered, the device marks pixel shader texture binds for the TES too.
+     */
+    VkShaderStageFlags ExtraTextureStages() const {
+      return m_extraStages;
+    }
+
+    /** CreateShaderModule: gives a registered shader its tessellation attachment. */
+    void Attach(
+            D3D9ShaderType                  ShaderType,
+      const void*                           pBytecode,
+            size_t                          BytecodeLength,
+            D3D9CommonShader&               Shader);
+
+    /**
+     * \brief The device's ApplyPrimitiveType hook (game thread, inside PrepareDraw)
+     *
+     * Binds or unbinds the tessellation shaders and sets the input assembly state as this draw needs.
+     * \returns \c true when it handled the input assembly state itself; \c false: nothing of ours is
+     *   bound and the device applies the primitive type as usual.
+     */
+    bool ApplyDraw(D3DPRIMITIVETYPE PrimType);
+
+    /**
+     * \brief Triangle strips (the land comes as strips)
+     *
+     * DrawPrimitive / DrawIndexedPrimitive call BeginDraw before their PrepareDraw: only those draws may take
+     * a triangle strip through the tessellation path (the UP draws and the other PrepareDraw callers may not).
+     * A strip of n indices is then drawn as three patch lists of consecutive index windows, starting at the
+     * strip's first, second and third index: together they are every triangle (i, i + 1, i + 2) of the strip,
+     * each once; the TCS learns from its push data which window a draw is (ControlParams[7]) and restores the
+     * winding of the strip's odd triangles by swapping their first two control points. No index buffer is
+     * read or written. StripPending then says the draw must be issued by EmitStripDraw instead.
+     */
+    void BeginDraw() {
+      m_stripsOk = true;
+    }
+
+    bool StripPending() const {
+      return m_stripPending;
+    }
+
+    void EmitStripDraw(bool Indexed, uint32_t First, uint32_t Count, int32_t BaseVertex, uint32_t InstanceCount);
+
+    /** Whether tessellated draws are bound right now in the wireframe debug view (BindRasterizerState). */
+    bool WireframeActive() const {
+      return m_boundVs != nullptr && m_state.Wireframe != 0u;
+    }
+
+  private:
+
+    bool                                          m_stripsOk     = false;
+    bool                                          m_stripPending = false;
+    bool                                          m_loggedStrip  = false;
+    bool                                          m_loggedOther  = false;
+
+    struct PendingVs {
+      std::vector<uint32_t>   tcs;
+      std::array<uint32_t, 4> vsRegs = { };
+      uint32_t                family = 0u;
+      std::string             name;
+      D3D9NvrTessVs*          created = nullptr;
+    };
+
+    struct PendingPs {
+      std::array<std::vector<uint32_t>, 2> tes;
+      uint32_t                textureMask = 0u;
+      std::array<uint32_t, 2> psRegs = { };
+      uint32_t                family = 0u;
+      std::string             name;
+      D3D9NvrTessPs*          created = nullptr;
+    };
+
+    static std::string HashBytecode(const void* pBytecode, size_t Length);
+
+    Rc<DxvkShader> CreateControlShader(const std::vector<uint32_t>& Spirv, const std::string& Name);
+
+    Rc<DxvkShader> CreateEvalShader(const std::vector<uint32_t>& Spirv, uint32_t TextureMask, const std::string& Name);
+
+    uint32_t ComputePsBits(const D3D9NvrTessPs* Ps) const;
+
+    D3D9DeviceEx*                                 m_device;
+
+    std::atomic<bool>                             m_used        = { false };
+    VkShaderStageFlags                            m_extraStages = 0u;
+
+    dxvk::mutex                                   m_mutex;
+    std::unordered_map<std::string, PendingVs>    m_vs;
+    std::unordered_map<std::string, PendingPs>    m_ps;
+    std::unordered_map<std::string, Rc<DxvkShader>> m_shaderCache;  // equal SPIR-V shares one DxvkShader
+    std::vector<std::unique_ptr<D3D9NvrTessVs>>   m_vsObjects;
+    std::vector<std::unique_ptr<D3D9NvrTessPs>>   m_psObjects;
+
+    // Game-thread state (the device lock is held in every call)
+    NVR_EXT_TESS_STATE                            m_state       = { };
+    uint64_t                                      m_stateId     = 1u;
+    const D3D9NvrTessVs*                          m_boundVs     = nullptr;
+    const D3D9NvrTessPs*                          m_boundPs     = nullptr;
+    uint64_t                                      m_boundState  = 0u;
+    uint32_t                                      m_boundPsBits = 0u;
+    bool                                          m_boundWire   = false;
+
+    NVR_EXT_TESS_STATS                            m_stats       = { };
+    std::atomic<uint32_t>                         m_refused     = { 0u };
+
+  };
+
+}

From f09333469032baf3d0529b25979b9066696b5a19 Mon Sep 17 00:00:00 2001
From: nvr <nvr@localhost>
Date: Tue, 27 Oct 2026 10:24:11 -0400
Subject: [PATCH] NVR extension 1.7-dlss: images and timeline semaphores shared
 with another process (ID3D9NvrExtShare)

CreateSharedImage / CreateSharedFence: DXVK images with a dedicated exportable
allocation (OPAQUE_WIN32 NT handles, kept in GENERAL between uses) and exportable
timeline semaphores, for a 64-bit helper process on the same GPU (NVR's DLSS helper:
NVIDIA's DLSS runtime is 64-bit only). GetInfo reports what the importer needs to
create the identical VkImage (format, usage, flags, tiling, allocation size, memory
type index; DxvkResourceAllocation::getMemoryTypeIndex is new). CopyToShared /
CopyFromShared (image copy, or a 1:1 blit between formats), SignalShared (signal +
flush) and WaitShared (GPU wait in the command list being recorded) are recorded in
DXVK's command stream; no CPU waits. SignalFromHost / GetCompletedValue for a
watchdog that releases the GPU when the other process dies. No NVIDIA code: plain
Vulkan external memory / semaphores, which DXVK already enables when present.
---
 src/d3d9/d3d9_nvr_ext.cpp   | 503 ++++++++++++++++++++++++++++++++++++
 src/d3d9/d3d9_nvr_ext.h     |  97 ++++++-
 src/d3d9/d3d9_nvr_ext_api.h | 152 +++++++++++
 src/dxvk/dxvk_memory.h      |  11 +
 4 files changed, 762 insertions(+), 1 deletion(-)

diff --git a/src/d3d9/d3d9_nvr_ext.cpp b/src/d3d9/d3d9_nvr_ext.cpp
index c0d04e0..8d6f6c1 100644
--- a/src/d3d9/d3d9_nvr_ext.cpp
+++ b/src/d3d9/d3d9_nvr_ext.cpp
@@ -163,6 +163,12 @@ namespace dxvk {
       return S_OK;
     }
 
+    // 1.7-dlss: images and semaphores shared with another process
+    if (ppvObject != nullptr && riid == __uuidof(ID3D9NvrExtShare)) {
+      *ppvObject = ref(static_cast<ID3D9NvrExtShare*>(this));
+      return S_OK;
+    }
+
     return m_device->QueryInterface(riid, ppvObject);
   }
 
@@ -1786,4 +1792,501 @@ namespace dxvk {
     return D3D_OK;
   }
 
+
+
+  // ---- 1.7-dlss: ID3D9NvrExtShare -----------------------------------------------------------------
+  //
+  // Images and timeline semaphores another process imports (NVR's 64-bit DLSS helper). Plain Vulkan
+  // external memory / semaphores with Win32 NT handles; DXVK already enables both extensions when the
+  // driver has them. A shared image is a DXVK image of its own: shared (kept in its default layout,
+  // GENERAL, after every submission), dedicated exportable allocation, never relocated.
+
+  static VkFormat DecodeNvrSharedFormat(NVR_EXT_SHARED_FORMAT format) {
+    switch (format) {
+      case NVR_EXT_SHARED_RGBA16F: return VK_FORMAT_R16G16B16A16_SFLOAT;
+      case NVR_EXT_SHARED_RG16F:   return VK_FORMAT_R16G16_SFLOAT;
+      case NVR_EXT_SHARED_R32F:    return VK_FORMAT_R32_SFLOAT;
+      case NVR_EXT_SHARED_RG32F:   return VK_FORMAT_R32G32_SFLOAT;
+      case NVR_EXT_SHARED_RGBA8:   return VK_FORMAT_R8G8B8A8_UNORM;
+      case NVR_EXT_SHARED_R16F:    return VK_FORMAT_R16_SFLOAT;
+      default:                     return VK_FORMAT_UNDEFINED;
+    }
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9NvrExtSharedImage::QueryInterface(REFIID riid, void** ppvObject) {
+    if (ppvObject == nullptr)
+      return E_POINTER;
+
+    *ppvObject = nullptr;
+
+    if (riid == __uuidof(IUnknown)
+     || riid == __uuidof(ID3D9NvrExtSharedImage)) {
+      *ppvObject = ref(this);
+      return S_OK;
+    }
+
+    return E_NOINTERFACE;
+  }
+
+
+  void STDMETHODCALLTYPE D3D9NvrExtSharedImage::GetInfo(NVR_EXT_SHARED_IMAGE_INFO* pInfo) {
+    if (pInfo != nullptr)
+      *pInfo = m_info;
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9NvrExtSharedImage::CreateHandle(HANDLE* pHandle) {
+    if (pHandle == nullptr)
+      return E_POINTER;
+
+    *pHandle = nullptr;
+
+    HANDLE handle = m_image->sharedHandle();
+
+    if (handle == INVALID_HANDLE_VALUE || handle == nullptr)
+      return D3DERR_NOTAVAILABLE;
+
+    *pHandle = handle;
+    return D3D_OK;
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9NvrExtSharedFence::QueryInterface(REFIID riid, void** ppvObject) {
+    if (ppvObject == nullptr)
+      return E_POINTER;
+
+    *ppvObject = nullptr;
+
+    if (riid == __uuidof(IUnknown)
+     || riid == __uuidof(ID3D9NvrExtSharedFence)) {
+      *ppvObject = ref(this);
+      return S_OK;
+    }
+
+    return E_NOINTERFACE;
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9NvrExtSharedFence::CreateHandle(HANDLE* pHandle) {
+    if (pHandle == nullptr)
+      return E_POINTER;
+
+    *pHandle = nullptr;
+
+    HANDLE handle = m_fence->sharedHandle();
+
+    if (handle == INVALID_HANDLE_VALUE || handle == nullptr)
+      return D3DERR_NOTAVAILABLE;
+
+    *pHandle = handle;
+    return D3D_OK;
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9NvrExtSharedFence::GetCompletedValue(UINT64* pValue) {
+    if (pValue == nullptr)
+      return E_POINTER;
+
+    uint64_t value = 0u;
+
+    if (m_vkd->vkGetSemaphoreCounterValue(m_vkd->device(), m_fence->handle(), &value) != VK_SUCCESS)
+      return D3DERR_DEVICELOST;
+
+    *pValue = value;
+    return D3D_OK;
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9NvrExtSharedFence::SignalFromHost(UINT64 Value) {
+    VkSemaphoreSignalInfo info = { VK_STRUCTURE_TYPE_SEMAPHORE_SIGNAL_INFO };
+    info.semaphore = m_fence->handle();
+    info.value = Value;
+
+    VkResult vr = m_vkd->vkSignalSemaphore(m_vkd->device(), &info);
+
+    if (vr != VK_SUCCESS) {
+      Logger::err(str::format("NVR ext: SignalFromHost: vkSignalSemaphore failed: ", vr));
+      return D3DERR_INVALIDCALL;
+    }
+
+    return D3D_OK;
+  }
+
+
+  void STDMETHODCALLTYPE D3D9NvrExt::GetShareInfo(NVR_EXT_SHARE_INFO* pInfo) {
+    if (pInfo == nullptr)
+      return;
+
+    Rc<DxvkDevice> device = m_device->GetDXVKDevice();
+    const auto& props = device->properties();
+    const auto& features = device->features();
+
+    *pInfo = NVR_EXT_SHARE_INFO();
+    pInfo->Supported = features.khrExternalMemoryWin32 && features.khrExternalSemaphoreWin32;
+    pInfo->VendorId = props.core.properties.vendorID;
+    pInfo->DeviceId = props.core.properties.deviceID;
+    pInfo->DriverVersion = props.core.properties.driverVersion;
+    pInfo->ApiVersion = props.core.properties.apiVersion;
+    std::memcpy(pInfo->DeviceUUID, props.vk11.deviceUUID, sizeof(pInfo->DeviceUUID));
+    std::memcpy(pInfo->DriverUUID, props.vk11.driverUUID, sizeof(pInfo->DriverUUID));
+    std::memcpy(pInfo->DeviceLUID, props.vk11.deviceLUID, sizeof(pInfo->DeviceLUID));
+    pInfo->DeviceLUIDValid = props.vk11.deviceLUIDValid;
+    std::strncpy(pInfo->DeviceName, props.core.properties.deviceName, sizeof(pInfo->DeviceName) - 1u);
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9NvrExt::CreateSharedImage(
+    const NVR_EXT_SHARED_IMAGE_DESC*      pDesc,
+          ID3D9NvrExtSharedImage**        ppImage) {
+    InitReturnPtr(ppImage);
+
+    if (unlikely(pDesc == nullptr || ppImage == nullptr || !pDesc->Width || !pDesc->Height))
+      return D3DERR_INVALIDCALL;
+
+    VkFormat format = DecodeNvrSharedFormat(pDesc->Format);
+
+    if (unlikely(format == VK_FORMAT_UNDEFINED))
+      return D3DERR_INVALIDCALL;
+
+    D3D9DeviceLock lock = m_device->LockDevice();
+
+    Rc<DxvkDevice> device = m_device->GetDXVKDevice();
+
+    if (!device->features().khrExternalMemoryWin32) {
+      Logger::err("NVR ext: CreateSharedImage: VK_KHR_external_memory_win32 is not enabled on this device");
+      return D3DERR_NOTAVAILABLE;
+    }
+
+    DxvkImageCreateInfo info;
+    info.type          = VK_IMAGE_TYPE_2D;
+    info.format        = format;
+    info.flags         = 0u;
+    info.sampleCount   = VK_SAMPLE_COUNT_1_BIT;
+    info.extent        = { pDesc->Width, pDesc->Height, 1u };
+    info.numLayers     = 1u;
+    info.mipLevels     = 1u;
+    info.usage         = VK_IMAGE_USAGE_TRANSFER_SRC_BIT
+                       | VK_IMAGE_USAGE_TRANSFER_DST_BIT
+                       | VK_IMAGE_USAGE_SAMPLED_BIT
+                       | VK_IMAGE_USAGE_STORAGE_BIT
+                       | VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT;
+    info.stages        = VK_PIPELINE_STAGE_TRANSFER_BIT
+                       | VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT
+                       | VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT
+                       | VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT;
+    info.access        = VK_ACCESS_TRANSFER_READ_BIT
+                       | VK_ACCESS_TRANSFER_WRITE_BIT
+                       | VK_ACCESS_SHADER_READ_BIT
+                       | VK_ACCESS_SHADER_WRITE_BIT
+                       | VK_ACCESS_COLOR_ATTACHMENT_READ_BIT
+                       | VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+    info.tiling        = VK_IMAGE_TILING_OPTIMAL;
+    info.layout        = VK_IMAGE_LAYOUT_GENERAL;
+    info.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    info.shared        = VK_TRUE;
+    info.sharing.mode  = DxvkSharedHandleMode::Export;
+    info.sharing.type  = VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_WIN32_BIT;
+    info.debugName     = pDesc->pDebugName ? pDesc->pDebugName : "NVR shared image";
+
+    // Exportable at that size with that usage? (DxvkImage would otherwise quietly make an unshared image.)
+    DxvkFormatQuery query = { };
+    query.format     = format;
+    query.type       = VK_IMAGE_TYPE_2D;
+    query.tiling     = VK_IMAGE_TILING_OPTIMAL;
+    query.usage      = info.usage;
+    query.flags      = 0u;
+    query.handleType = info.sharing.type;
+
+    auto limits = device->getFormatLimits(query);
+
+    if (!limits || !(limits->externalFeatures & VK_EXTERNAL_MEMORY_FEATURE_EXPORTABLE_BIT)
+     || limits->maxExtent.width < pDesc->Width || limits->maxExtent.height < pDesc->Height) {
+      Logger::err(str::format("NVR ext: CreateSharedImage: format ", uint32_t(format), " ", pDesc->Width, "x", pDesc->Height,
+        " cannot be exported (OPAQUE_WIN32) on this device"));
+      return D3DERR_NOTAVAILABLE;
+    }
+
+    Rc<DxvkImage> image;
+
+    try {
+      image = device->createImage(info, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+    } catch (const DxvkError& e) {
+      Logger::err(str::format("NVR ext: CreateSharedImage: ", e.message()));
+      return D3DERR_OUTOFVIDEOMEMORY;
+    }
+
+    // An image that could not be shared after all has no handle.
+    HANDLE probe = image->sharedHandle();
+
+    if (probe == INVALID_HANDLE_VALUE || probe == nullptr) {
+      Logger::err("NVR ext: CreateSharedImage: the image was made but has no shared handle");
+      return D3DERR_NOTAVAILABLE;
+    }
+
+    CloseHandle(probe);
+
+    Rc<DxvkResourceAllocation> storage = image->storage();
+    DxvkResourceMemoryInfo memory = storage->getMemoryInfo();
+
+    if (memory.offset != 0u) {
+      Logger::err(str::format("NVR ext: CreateSharedImage: the allocation is not dedicated (offset ", memory.offset, ")"));
+      return D3DERR_NOTAVAILABLE;
+    }
+
+    NVR_EXT_SHARED_IMAGE_INFO out = { };
+    out.VkFormat        = uint32_t(format);
+    out.Width           = pDesc->Width;
+    out.Height          = pDesc->Height;
+    out.MipLevels       = 1u;
+    out.ArrayLayers     = 1u;
+    out.Samples         = uint32_t(VK_SAMPLE_COUNT_1_BIT);
+    out.Usage           = uint32_t(image->info().usage);
+    out.Flags           = uint32_t(image->info().flags);
+    out.Tiling          = uint32_t(image->info().tiling);
+    out.Layout          = uint32_t(VK_IMAGE_LAYOUT_GENERAL);
+    out.HandleType      = uint32_t(VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_WIN32_BIT);
+    out.MemoryTypeIndex = storage->getMemoryTypeIndex();
+    out.AllocationSize  = memory.size;
+    out.Dedicated       = TRUE;
+
+    // Into its default layout (GENERAL), cleared to black, before anyone else touches it.
+    m_device->EmitCs([
+      cImage = image
+    ] (DxvkContext* ctx) {
+      ctx->initImage(cImage, VK_IMAGE_LAYOUT_UNDEFINED);
+    });
+
+    Logger::info(str::format("NVR ext: shared image ", info.debugName, " ", pDesc->Width, "x", pDesc->Height,
+      " format ", uint32_t(format), ", ", memory.size, " bytes, memory type ", out.MemoryTypeIndex));
+
+    *ppImage = ref(new D3D9NvrExtSharedImage(std::move(image), out));
+    return D3D_OK;
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9NvrExt::CreateSharedFence(
+          UINT64                          InitialValue,
+          ID3D9NvrExtSharedFence**        ppFence) {
+    InitReturnPtr(ppFence);
+
+    if (unlikely(ppFence == nullptr))
+      return D3DERR_INVALIDCALL;
+
+    D3D9DeviceLock lock = m_device->LockDevice();
+
+    Rc<DxvkDevice> device = m_device->GetDXVKDevice();
+
+    if (!device->features().khrExternalSemaphoreWin32) {
+      Logger::err("NVR ext: CreateSharedFence: VK_KHR_external_semaphore_win32 is not enabled on this device");
+      return D3DERR_NOTAVAILABLE;
+    }
+
+    DxvkFenceCreateInfo info;
+    info.initialValue = InitialValue;
+    info.sharedType = VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_OPAQUE_WIN32_BIT;
+
+    Rc<DxvkFence> fence;
+
+    try {
+      fence = device->createFence(info);
+    } catch (const DxvkError& e) {
+      Logger::err(str::format("NVR ext: CreateSharedFence: ", e.message()));
+      return D3DERR_NOTAVAILABLE;
+    }
+
+    // DxvkFence makes a plain semaphore when export is not supported: no handle then.
+    HANDLE probe = fence->sharedHandle();
+
+    if (probe == INVALID_HANDLE_VALUE || probe == nullptr) {
+      Logger::err("NVR ext: CreateSharedFence: the timeline semaphore cannot be exported");
+      return D3DERR_NOTAVAILABLE;
+    }
+
+    CloseHandle(probe);
+
+    *ppFence = ref(new D3D9NvrExtSharedFence(std::move(fence), device->vkd()));
+    return D3D_OK;
+  }
+
+
+  HRESULT D3D9NvrExt::RecordSharedCopy(
+    const Rc<DxvkImage>&                  DstImage,
+          uint32_t                        DstMip,
+          uint32_t                        DstLayer,
+          UINT                            DstX,
+          UINT                            DstY,
+    const Rc<DxvkImage>&                  SrcImage,
+          uint32_t                        SrcMip,
+          uint32_t                        SrcLayer,
+    const RECT*                           pSrcRect) {
+    if (unlikely(DstImage == nullptr || SrcImage == nullptr || DstImage == SrcImage))
+      return D3DERR_INVALIDCALL;
+
+    if (unlikely(DstImage->info().sampleCount != VK_SAMPLE_COUNT_1_BIT || SrcImage->info().sampleCount != VK_SAMPLE_COUNT_1_BIT))
+      return D3DERR_INVALIDCALL;
+
+    if (unlikely(!(lookupFormatInfo(DstImage->info().format)->aspectMask & VK_IMAGE_ASPECT_COLOR_BIT)
+              || !(lookupFormatInfo(SrcImage->info().format)->aspectMask & VK_IMAGE_ASPECT_COLOR_BIT)))
+      return D3DERR_INVALIDCALL;
+
+    VkExtent3D srcExtent = SrcImage->mipLevelExtent(SrcMip);
+    VkExtent3D dstExtent = DstImage->mipLevelExtent(DstMip);
+
+    RECT rect = { 0, 0, LONG(srcExtent.width), LONG(srcExtent.height) };
+
+    if (pSrcRect != nullptr)
+      rect = *pSrcRect;
+
+    if (unlikely(rect.left < 0 || rect.top < 0 || rect.right <= rect.left || rect.bottom <= rect.top
+              || UINT(rect.right) > srcExtent.width || UINT(rect.bottom) > srcExtent.height))
+      return D3DERR_INVALIDCALL;
+
+    UINT width  = UINT(rect.right - rect.left);
+    UINT height = UINT(rect.bottom - rect.top);
+
+    if (unlikely(DstX + width > dstExtent.width || DstY + height > dstExtent.height))
+      return D3DERR_INVALIDCALL;
+
+    VkImageSubresourceLayers dstLayers = { VK_IMAGE_ASPECT_COLOR_BIT, DstMip, DstLayer, 1u };
+    VkImageSubresourceLayers srcLayers = { VK_IMAGE_ASPECT_COLOR_BIT, SrcMip, SrcLayer, 1u };
+
+    if (DstImage->info().format == SrcImage->info().format) {
+      m_device->EmitCs([
+        cDst       = DstImage,
+        cDstLayers = dstLayers,
+        cDstOffset = VkOffset3D { int32_t(DstX), int32_t(DstY), 0 },
+        cSrc       = SrcImage,
+        cSrcLayers = srcLayers,
+        cSrcOffset = VkOffset3D { int32_t(rect.left), int32_t(rect.top), 0 },
+        cExtent    = VkExtent3D { width, height, 1u }
+      ] (DxvkContext* ctx) {
+        ctx->copyImage(cDst, cDstLayers, cDstOffset, cSrc, cSrcLayers, cSrcOffset, cExtent);
+      });
+
+      return D3D_OK;
+    }
+
+    // Different formats: a 1:1 blit (format conversion, nearest), the way D3D9's StretchRect does it.
+    DxvkImageViewKey dstKey;
+    dstKey.viewType   = VK_IMAGE_VIEW_TYPE_2D_ARRAY;
+    dstKey.usage      = VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+    dstKey.format     = DstImage->info().format;
+    dstKey.aspects    = VK_IMAGE_ASPECT_COLOR_BIT;
+    dstKey.mipIndex   = DstMip;
+    dstKey.mipCount   = 1u;
+    dstKey.layerIndex = DstLayer;
+    dstKey.layerCount = 1u;
+
+    DxvkImageViewKey srcKey;
+    srcKey.viewType   = VK_IMAGE_VIEW_TYPE_2D;
+    srcKey.usage      = VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+    srcKey.format     = SrcImage->info().format;
+    srcKey.aspects    = VK_IMAGE_ASPECT_COLOR_BIT;
+    srcKey.mipIndex   = SrcMip;
+    srcKey.mipCount   = 1u;
+    srcKey.layerIndex = SrcLayer;
+    srcKey.layerCount = 1u;
+
+    std::array<VkOffset3D, 2> dstOffsets = {{ { int32_t(DstX), int32_t(DstY), 0 },
+      { int32_t(DstX + width), int32_t(DstY + height), 1 } }};
+    std::array<VkOffset3D, 2> srcOffsets = {{ { int32_t(rect.left), int32_t(rect.top), 0 },
+      { int32_t(rect.right), int32_t(rect.bottom), 1 } }};
+
+    m_device->EmitCs([
+      cDstView    = DstImage->createView(dstKey),
+      cSrcView    = SrcImage->createView(srcKey),
+      cDstOffsets = dstOffsets,
+      cSrcOffsets = srcOffsets
+    ] (DxvkContext* ctx) {
+      ctx->blitImageView(cDstView, cDstOffsets.data(), cSrcView, cSrcOffsets.data(), VK_FILTER_NEAREST);
+    });
+
+    return D3D_OK;
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9NvrExt::CopyToShared(
+          ID3D9NvrExtSharedImage*         pDst,
+          UINT                            DstX,
+          UINT                            DstY,
+          IUnknown*                       pSrc,
+    const RECT*                           pSrcRect) {
+    D3D9DeviceLock lock = m_device->LockDevice();
+
+    if (unlikely(pDst == nullptr || pSrc == nullptr))
+      return D3DERR_INVALIDCALL;
+
+    TextureRef ref;
+    if (unlikely(!ResolveTexture(pSrc, 0u, 0u, ref)))
+      return D3DERR_INVALIDCALL;
+
+    Rc<DxvkImage> src = ref.texture->GetImage();
+    Rc<DxvkImage> dst = static_cast<D3D9NvrExtSharedImage*>(pDst)->GetImage();
+
+    return RecordSharedCopy(dst, 0u, 0u, DstX, DstY, src, ref.mipLevel, ref.layer, pSrcRect);
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9NvrExt::CopyFromShared(
+          IUnknown*                       pDst,
+          UINT                            DstX,
+          UINT                            DstY,
+          ID3D9NvrExtSharedImage*         pSrc,
+    const RECT*                           pSrcRect) {
+    D3D9DeviceLock lock = m_device->LockDevice();
+
+    if (unlikely(pDst == nullptr || pSrc == nullptr))
+      return D3DERR_INVALIDCALL;
+
+    TextureRef ref;
+    if (unlikely(!ResolveTexture(pDst, 0u, 0u, ref)))
+      return D3DERR_INVALIDCALL;
+
+    Rc<DxvkImage> dst = ref.texture->GetImage();
+    Rc<DxvkImage> src = static_cast<D3D9NvrExtSharedImage*>(pSrc)->GetImage();
+
+    return RecordSharedCopy(dst, ref.mipLevel, ref.layer, DstX, DstY, src, 0u, 0u, pSrcRect);
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9NvrExt::SignalShared(
+          ID3D9NvrExtSharedFence*         pFence,
+          UINT64                          Value) {
+    D3D9DeviceLock lock = m_device->LockDevice();
+
+    if (unlikely(pFence == nullptr))
+      return D3DERR_INVALIDCALL;
+
+    m_device->EmitCs([
+      cFence = static_cast<D3D9NvrExtSharedFence*>(pFence)->GetFence(),
+      cValue = uint64_t(Value)
+    ] (DxvkContext* ctx) {
+      ctx->signalFence(cFence, cValue);
+    });
+
+    // The command list so far goes to the GPU now, with the signal (the other process waits for it).
+    m_device->ExecuteFlush(false);
+    return D3D_OK;
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9NvrExt::WaitShared(
+          ID3D9NvrExtSharedFence*         pFence,
+          UINT64                          Value) {
+    D3D9DeviceLock lock = m_device->LockDevice();
+
+    if (unlikely(pFence == nullptr))
+      return D3DERR_INVALIDCALL;
+
+    m_device->EmitCs([
+      cFence = static_cast<D3D9NvrExtSharedFence*>(pFence)->GetFence(),
+      cValue = uint64_t(Value)
+    ] (DxvkContext* ctx) {
+      ctx->waitFence(cFence, cValue);
+    });
+
+    return D3D_OK;
+  }
+
 }
diff --git a/src/d3d9/d3d9_nvr_ext.h b/src/d3d9/d3d9_nvr_ext.h

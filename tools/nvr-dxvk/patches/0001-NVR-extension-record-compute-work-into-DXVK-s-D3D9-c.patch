+  HRESULT STDMETHODCALLTYPE D3D9NvrExt::CreateBuffer(
+    const NVR_EXT_BUFFER_DESC*            pDesc,
+          ID3D9NvrExtBuffer**             ppBuffer) {
+    InitReturnPtr(ppBuffer);
+
+    if (unlikely(pDesc == nullptr || ppBuffer == nullptr || pDesc->Size == 0u || !pDesc->Flags))
+      return D3DERR_INVALIDCALL;
+
+    DxvkBufferCreateInfo info;
+    info.size   = align(pDesc->Size, 16u);
+    info.usage  = 0u;
+    info.stages = 0u;
+    info.access = 0u;
+    info.debugName = pDesc->pDebugName;
+
+    if (pDesc->Flags & NVR_EXT_BUFFER_STORAGE) {
+      info.usage  |= VK_BUFFER_USAGE_STORAGE_BUFFER_BIT;
+      info.stages |= VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT;
+      info.access |= VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT;
+    }
+
+    if (pDesc->Flags & NVR_EXT_BUFFER_UNIFORM) {
+      info.usage  |= VK_BUFFER_USAGE_UNIFORM_BUFFER_BIT;
+      info.stages |= VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT;
+      info.access |= VK_ACCESS_UNIFORM_READ_BIT;
+    }
+
+    if (pDesc->Flags & NVR_EXT_BUFFER_TRANSFER_SRC) {
+      info.usage  |= VK_BUFFER_USAGE_TRANSFER_SRC_BIT;
+      info.stages |= VK_PIPELINE_STAGE_TRANSFER_BIT;
+      info.access |= VK_ACCESS_TRANSFER_READ_BIT;
+    }
+
+    if (pDesc->Flags & NVR_EXT_BUFFER_TRANSFER_DST) {
+      info.usage  |= VK_BUFFER_USAGE_TRANSFER_DST_BIT;
+      info.stages |= VK_PIPELINE_STAGE_TRANSFER_BIT;
+      info.access |= VK_ACCESS_TRANSFER_WRITE_BIT;
+    }
+
+    try {
+      Rc<DxvkBuffer> buffer = m_device->GetDXVKDevice()->createBuffer(info, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+      *ppBuffer = ref(new D3D9NvrExtBuffer(std::move(buffer), pDesc->Size));
+      return D3D_OK;
+    } catch (const DxvkError& e) {
+      Logger::err(str::format("NVR ext: CreateBuffer: ", e.message()));
+      return D3DERR_OUTOFVIDEOMEMORY;
+    }
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9NvrExt::CreateSampler(
+    const NVR_EXT_SAMPLER_DESC*           pDesc,
+          ID3D9NvrExtSampler**            ppSampler) {
+    InitReturnPtr(ppSampler);
+
+    if (unlikely(pDesc == nullptr || ppSampler == nullptr))
+      return D3DERR_INVALIDCALL;
+
+    VkFilter filter = pDesc->Filter == NVR_EXT_FILTER_LINEAR ? VK_FILTER_LINEAR : VK_FILTER_NEAREST;
+    VkSamplerAddressMode address = DecodeNvrAddressMode(pDesc->Address);
+
+    DxvkSamplerKey key = { };
+    key.setFilter(filter, filter, VK_SAMPLER_MIPMAP_MODE_NEAREST);
+    key.setAddressModes(address, address, address);
+    key.setLodRange(0.0f, 0.0f, 0.0f);
+    key.setAniso(0u);
+    key.setDepthCompare(false, VK_COMPARE_OP_NEVER);
+    key.setReduction(VK_SAMPLER_REDUCTION_MODE_WEIGHTED_AVERAGE);
+
+    VkClearColorValue border = { };
+    key.setBorderColor(border);
+
+    try {
+      Rc<DxvkSampler> sampler = m_device->GetDXVKDevice()->createSampler(key);
+      *ppSampler = ref(new D3D9NvrExtSampler(std::move(sampler)));
+      return D3D_OK;
+    } catch (const DxvkError& e) {
+      Logger::err(str::format("NVR ext: CreateSampler: ", e.message()));
+      return D3DERR_INVALIDCALL;
+    }
+  }

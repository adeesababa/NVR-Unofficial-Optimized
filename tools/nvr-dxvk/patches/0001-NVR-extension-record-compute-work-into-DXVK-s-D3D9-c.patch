+  HRESULT STDMETHODCALLTYPE D3D9NvrExtPipeline::QueryInterface(REFIID riid, void** ppvObject) {
+    if (ppvObject == nullptr)
+      return E_POINTER;
+
+    *ppvObject = nullptr;
+
+    if (riid == __uuidof(IUnknown)
+     || riid == __uuidof(ID3D9NvrExtPipeline)) {
+      *ppvObject = ref(this);
+      return S_OK;
+    }
+
+    return E_NOINTERFACE;
+  }
+
+
+  const D3D9NvrExtBindingInfo* D3D9NvrExtPipeline::FindBinding(uint32_t slot, NVR_EXT_BIND_TYPE type) const {
+    for (size_t i = 0; i < m_bindings.size(); i++) {
+      if (m_bindings[i].slot == slot && m_bindings[i].type == type)
+        return &m_bindings[i];
+    }
+    return nullptr;
+  }

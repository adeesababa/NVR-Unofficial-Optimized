+
+  HRESULT STDMETHODCALLTYPE D3D9NvrExt::CreateComputePipeline(
+    const NVR_EXT_COMPUTE_PIPELINE_DESC*  pDesc,
+          ID3D9NvrExtPipeline**           ppPipeline) {
+    InitReturnPtr(ppPipeline);
+
+    if (unlikely(pDesc == nullptr || ppPipeline == nullptr))
+      return D3DERR_INVALIDCALL;
+
+    const char* name = pDesc->pDebugName ? pDesc->pDebugName : "NVR compute";
+
+    if (unlikely(pDesc->pSpirv == nullptr || pDesc->SpirvSize < 20u || (pDesc->SpirvSize & 3u))) {
+      Logger::err(str::format("NVR ext: ", name, ": no SPIR-V or a size that is not a multiple of 4"));
+      return D3DERR_INVALIDCALL;
+    }
+
+    if (unlikely(pDesc->BindingCount > NVR_EXT_MAX_BINDINGS
+              || (pDesc->BindingCount && pDesc->pBindings == nullptr))) {
+      Logger::err(str::format("NVR ext: ", name, ": bad binding list"));
+      return D3DERR_INVALIDCALL;
+    }
+
+    if (unlikely(pDesc->PushConstantSize > NVR_EXT_MAX_PUSH_BYTES || (pDesc->PushConstantSize & 3u))) {
+      Logger::err(str::format("NVR ext: ", name, ": push constant size must be 4-aligned and at most ", NVR_EXT_MAX_PUSH_BYTES));
+      return D3DERR_INVALIDCALL;
+    }
+
+    small_vector<DxvkBindingInfo, 16>       dxvkBindings;
+    small_vector<D3D9NvrExtBindingInfo, 8>  ownBindings;
+    uint64_t pushResourceMask = 0u;
+    bool usesSamplers = false;
+
+    for (uint32_t i = 0; i < pDesc->BindingCount; i++) {
+      const auto& b = pDesc->pBindings[i];
+
+      if (unlikely(b.Slot >= NVR_EXT_MAX_SLOTS)) {
+        Logger::err(str::format("NVR ext: ", name, ": binding ", i, " slot ", b.Slot, " out of range"));
+        return D3DERR_INVALIDCALL;
+      }
+
+      D3D9NvrExtBindingInfo own;
+      own.slot = b.Slot;
+      own.type = b.Type;
+      own.viewType = b.ViewType;
+      own.writes = b.Writes != FALSE;
+
+      for (size_t j = 0; j < ownBindings.size(); j++) {
+        if (ownBindings[j].slot == own.slot && ownBindings[j].type == own.type) {
+          Logger::err(str::format("NVR ext: ", name, ": slot ", b.Slot, " is bound twice for the same type"));
+          return D3DERR_INVALIDCALL;
+        }
+      }
+
+      DxvkBindingInfo info = { };
+      info.set = b.Set;
+      info.binding = b.Binding;
+      info.descriptorCount = 1u;
+
+      switch (b.Type) {
+        case NVR_EXT_BIND_SAMPLED_IMAGE:
+          info.resourceIndex  = NvrExtImageSlotBase + b.Slot;
+          info.descriptorType = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE;
+          info.viewType       = DecodeNvrViewType(b.ViewType);
+          info.access         = VK_ACCESS_SHADER_READ_BIT;
+          break;
+
+        case NVR_EXT_BIND_STORAGE_IMAGE:
+          info.resourceIndex  = NvrExtImageSlotBase + b.Slot;
+          info.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+          info.viewType       = DecodeNvrViewType(b.ViewType);
+          info.access         = VK_ACCESS_SHADER_READ_BIT | (own.writes ? VkAccessFlags(VK_ACCESS_SHADER_WRITE_BIT) : VkAccessFlags(0u));
+          break;
+
+        case NVR_EXT_BIND_STORAGE_BUFFER:
+          info.resourceIndex  = NvrExtBufferSlotBase + b.Slot;
+          info.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+          info.access         = VK_ACCESS_SHADER_READ_BIT | (own.writes ? VkAccessFlags(VK_ACCESS_SHADER_WRITE_BIT) : VkAccessFlags(0u));
+          info.flags.set(DxvkDescriptorFlag::UniformBuffer);
+          break;
+
+        case NVR_EXT_BIND_UNIFORM_BUFFER:
+          info.resourceIndex  = NvrExtBufferSlotBase + b.Slot;
+          info.descriptorType = VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER;
+          info.access         = VK_ACCESS_UNIFORM_READ_BIT;
+          info.flags.set(DxvkDescriptorFlag::UniformBuffer);
+          break;
+
+        case NVR_EXT_BIND_SAMPLER:
+          if (unlikely((b.PushOffset & 3u) || b.PushOffset + 4u > pDesc->PushConstantSize)) {
+            Logger::err(str::format("NVR ext: ", name, ": sampler slot ", b.Slot, " push offset ", b.PushOffset, " is not inside the push block"));
+            return D3DERR_INVALIDCALL;
+          }
+          info.resourceIndex  = NvrExtSamplerSlotBase + b.Slot;
+          info.descriptorType = VK_DESCRIPTOR_TYPE_SAMPLER;
+          info.blockOffset    = b.PushOffset;
+          info.flags.set(DxvkDescriptorFlag::PushData);
+          pushResourceMask |= 1ull << (b.PushOffset / 4u);
+          usesSamplers = true;
+          break;
+
+        default:
+          Logger::err(str::format("NVR ext: ", name, ": binding ", i, " has an unknown type"));
+          return D3DERR_INVALIDCALL;
+      }
+
+      dxvkBindings.push_back(info);
+      ownBindings.push_back(own);
+    }
+
+    if (unlikely(usesSamplers && !pDesc->UsesSamplerHeap)) {
+      Logger::err(str::format("NVR ext: ", name, ": sampler bindings need UsesSamplerHeap and the heap's set/binding"));
+      return D3DERR_INVALIDCALL;
+    }
+
+    DxvkSpirvShaderCreateInfo info;
+    info.bindingCount = dxvkBindings.size();
+    info.bindings = dxvkBindings.data();
+
+    if (pDesc->PushConstantSize)
+      info.localPushData = DxvkPushDataBlock(VK_SHADER_STAGE_COMPUTE_BIT, 0u, pDesc->PushConstantSize, 4u, pushResourceMask);
+
+    if (pDesc->UsesSamplerHeap)
+      info.samplerHeap = DxvkShaderBinding(VK_SHADER_STAGE_COMPUTE_BIT, pDesc->SamplerHeapSet, pDesc->SamplerHeapBinding);
+
+    info.debugName = name;
+
+    try {
+      Rc<DxvkShader> shader = new DxvkSpirvShader(info,
+        SpirvCodeBuffer(pDesc->SpirvSize / 4u, reinterpret_cast<const uint32_t*>(pDesc->pSpirv)));
+
+      if (shader->metadata().stage != VK_SHADER_STAGE_COMPUTE_BIT) {
+        Logger::err(str::format("NVR ext: ", name, ": the SPIR-V is not a compute shader"));
+        return D3DERR_INVALIDCALL;
+      }
+
+      *ppPipeline = ref(new D3D9NvrExtPipeline(std::move(shader), pDesc->PushConstantSize, std::move(ownBindings)));
+      Logger::info(str::format("NVR ext: compute pipeline '", name, "' created (", pDesc->BindingCount, " bindings, ", pDesc->PushConstantSize, " push bytes)"));
+      return D3D_OK;
+    } catch (const DxvkError& e) {
+      Logger::err(str::format("NVR ext: ", name, ": ", e.message()));
+      return D3DERR_INVALIDCALL;
+    }
+  }
+

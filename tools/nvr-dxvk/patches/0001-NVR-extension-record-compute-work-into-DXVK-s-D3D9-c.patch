+  ////////////////////////////////
+  // Helpers
+  ///////////////////////////////
+
+  static VkImageViewType DecodeNvrViewType(NVR_EXT_VIEW_TYPE type) {
+    switch (type) {
+      case NVR_EXT_VIEW_3D:       return VK_IMAGE_VIEW_TYPE_3D;
+      case NVR_EXT_VIEW_CUBE:     return VK_IMAGE_VIEW_TYPE_CUBE;
+      case NVR_EXT_VIEW_2D_ARRAY: return VK_IMAGE_VIEW_TYPE_2D_ARRAY;
+      default:                    return VK_IMAGE_VIEW_TYPE_2D;
+    }
+  }
+
+
+  static VkSamplerAddressMode DecodeNvrAddressMode(NVR_EXT_ADDRESS mode) {
+    switch (mode) {
+      case NVR_EXT_ADDRESS_WRAP:   return VK_SAMPLER_ADDRESS_MODE_REPEAT;
+      case NVR_EXT_ADDRESS_MIRROR: return VK_SAMPLER_ADDRESS_MODE_MIRRORED_REPEAT;
+      case NVR_EXT_ADDRESS_BORDER: return VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_BORDER;
+      default:                     return VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE;
+    }
+  }
+
+
+  /**
+   * \brief One resource resolved for a dispatch
+   *
+   * Built on the calling thread, consumed on the CS thread. Views are
+   * created on the CS thread so that a storage image can first get its
+   * storage usage added (which may relocate the image).
+   */
+  struct D3D9NvrExtBound {
+    uint32_t          slot = 0u;
+    NVR_EXT_BIND_TYPE type = NVR_EXT_BIND_SAMPLED_IMAGE;
+    bool              writes = false;
+    Rc<DxvkImage>     image;
+    DxvkImageViewKey  viewKey = { };
+    DxvkBufferSlice   buffer;
+    Rc<DxvkSampler>   sampler;
+  };

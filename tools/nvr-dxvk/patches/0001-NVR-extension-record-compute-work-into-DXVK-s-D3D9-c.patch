+
+  void STDMETHODCALLTYPE D3D9NvrExt::GetInfo(NVR_EXT_INFO* pInfo) {
+    if (pInfo == nullptr)
+      return;
+
+    const auto& props = m_device->GetDXVKDevice()->properties();
+
+    *pInfo = NVR_EXT_INFO();
+    pInfo->ExtVersionMajor = NVR_EXT_VERSION_MAJOR;
+    pInfo->ExtVersionMinor = NVR_EXT_VERSION_MINOR;
+    std::strncpy(pInfo->DxvkVersion, DXVK_VERSION, sizeof(pInfo->DxvkVersion) - 1u);
+    pInfo->MaxPushBytes = NVR_EXT_MAX_PUSH_BYTES;
+    pInfo->MaxSlots = NVR_EXT_MAX_SLOTS;
+    pInfo->SubgroupSize = props.vk11.subgroupSize;
+    pInfo->MaxWorkgroupInvocations = props.core.properties.limits.maxComputeWorkGroupInvocations;
+  }

@@ -974,7 +974,7 @@ namespace dxvk {
         cNvrHdr         = std::move(nvrHdr),
         cCaptureImage   = std::move(nvrCaptureImage),
         cCaptureBuffer  = std::move(nvrCaptureBuffer),
-        cColorSpace     = m_colorspace,
+        cColorSpace     = m_nvrHdr.mode != NVR_EXT_HDR_OFF ? VK_COLOR_SPACE_SRGB_NONLINEAR_KHR : m_colorspace,
         cSrcView        = swapImageView,
         cSrcRect        = srcRect,
         cDstView        = backBuffer->createView(viewInfo),
@@ -983,8 +983,8 @@ namespace dxvk {
         cFrameId        = m_wctx->frameId,
         cLatency        = m_latencyTracker
       ] (DxvkContext* ctx) {
-        // Update back buffer color space as necessary (not with NVR HDR: the back buffer stays SDR)
-        if (!cNvrHdr.enabled && cSrcView->image()->info().colorSpace != cColorSpace) {
+        // Update back buffer color space as necessary (with NVR HDR on it stays SDR: cColorSpace is SRGB then)
+        if (cSrcView->image()->info().colorSpace != cColorSpace) {
           DxvkImageUsageInfo usage = { };
           usage.colorSpace = cColorSpace;
 
diff --git a/src/dxvk/dxvk_presenter.cpp b/src/dxvk/dxvk_presenter.cpp
index 55f4c7a..2aeb50a 100644
--- a/src/dxvk/dxvk_presenter.cpp
+++ b/src/dxvk/dxvk_presenter.cpp
@@ -354,6 +354,21 @@ namespace dxvk {
   }
 
 
+  void Presenter::setFullscreenExclusiveOff(bool disallow) {
+    std::lock_guard lock(m_surfaceMutex);
+
+    // m_fullscreenMode is chained into every surface query and the swap chain itself, so all of them follow
+    VkFullScreenExclusiveEXT mode = (!disallow && m_device->config().allowFse)
+      ? VK_FULL_SCREEN_EXCLUSIVE_ALLOWED_EXT
+      : VK_FULL_SCREEN_EXCLUSIVE_DISALLOWED_EXT;
+
+    if (m_fullscreenMode != mode) {
+      m_fullscreenMode = mode;
+      m_dirtySwapchain = true;
+    }
+  }
+
+
   void Presenter::invalidateSurface() {
     std::lock_guard lock(m_surfaceMutex);
 

diff --git a/src/d3d9/shaders/d3d9_nvr_fullscreen_vert.vert b/src/d3d9/shaders/d3d9_nvr_fullscreen_vert.vert
new file mode 100644
index 0000000..e292fe3
--- /dev/null
+++ b/src/d3d9/shaders/d3d9_nvr_fullscreen_vert.vert
@@ -0,0 +1,13 @@
+#version 450
+
+// NVR extension: the built-in full-screen triangle. Three vertices, no vertex
+// buffer; location 0 carries the texture coordinate with (0, 0) at the top left
+// of the target, as D3D9 textures are addressed.
+
+layout(location = 0) out vec2 o_uv;
+
+void main() {
+  vec2 p = vec2(float((gl_VertexIndex << 1) & 2), float(gl_VertexIndex & 2));
+  o_uv = p;
+  gl_Position = vec4(p * 2.0f - 1.0f, 0.0f, 1.0f);
+}

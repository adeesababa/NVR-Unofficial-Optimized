+  HRESULT STDMETHODCALLTYPE D3D9NvrExt::CreateGraphicsPipeline(
+    const NVR_EXT_GRAPHICS_PIPELINE_DESC* pDesc,
+          ID3D9NvrExtPipeline**           ppPipeline) {
+    InitReturnPtr(ppPipeline);
+
+    if (unlikely(pDesc == nullptr || ppPipeline == nullptr))
+      return D3DERR_INVALIDCALL;
+
+    const char* name = pDesc->pDebugName ? pDesc->pDebugName : "NVR pass";
+
+    if (unlikely(pDesc->pFragmentSpirv == nullptr || pDesc->FragmentSpirvSize < 20u || (pDesc->FragmentSpirvSize & 3u))) {
+      Logger::err(str::format("NVR ext: ", name, ": no fragment SPIR-V or a size that is not a multiple of 4"));
+      return D3DERR_INVALIDCALL;
+    }
+
+    if (unlikely(pDesc->pVertexSpirv != nullptr && (pDesc->VertexSpirvSize < 20u || (pDesc->VertexSpirvSize & 3u)))) {
+      Logger::err(str::format("NVR ext: ", name, ": vertex SPIR-V size is not a multiple of 4"));
+      return D3DERR_INVALIDCALL;
+    }
+
+    if (unlikely(pDesc->ColorTargetCount == 0u || pDesc->ColorTargetCount > NVR_EXT_MAX_TARGETS)) {
+      Logger::err(str::format("NVR ext: ", name, ": ColorTargetCount must be 1..", NVR_EXT_MAX_TARGETS));
+      return D3DERR_INVALIDCALL;
+    }
+
+    small_vector<DxvkBindingInfo, 16>       dxvkBindings;
+    small_vector<D3D9NvrExtBindingInfo, 8>  ownBindings;
+    uint64_t pushResourceMask = 0u;
+
+    HRESULT hr = BuildPipelineBindings(name, pDesc->BindingCount, pDesc->pBindings, pDesc->PushConstantSize,
+      pDesc->UsesSamplerHeap, dxvkBindings, ownBindings, pushResourceMask);
+
+    if (FAILED(hr))
+      return hr;
+
+    // Blend state, the same for every target
+    VkColorComponentFlags writeMask = pDesc->ColorWriteMask
+      ? VkColorComponentFlags(pDesc->ColorWriteMask & 0xFu)
+      : VkColorComponentFlags(VK_COLOR_COMPONENT_R_BIT | VK_COLOR_COMPONENT_G_BIT | VK_COLOR_COMPONENT_B_BIT | VK_COLOR_COMPONENT_A_BIT);
+
+    DxvkBlendMode blend = { };
+    blend.setWriteMask(writeMask);
+    blend.setBlendEnable(pDesc->Blend != NVR_EXT_BLEND_NONE);
+
+    switch (pDesc->Blend) {
+      case NVR_EXT_BLEND_ALPHA:
+        blend.setColorOp(VK_BLEND_FACTOR_SRC_ALPHA, VK_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA, VK_BLEND_OP_ADD);
+        blend.setAlphaOp(VK_BLEND_FACTOR_SRC_ALPHA, VK_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA, VK_BLEND_OP_ADD);
+        break;
+      case NVR_EXT_BLEND_ADD:
+        blend.setColorOp(VK_BLEND_FACTOR_ONE, VK_BLEND_FACTOR_ONE, VK_BLEND_OP_ADD);
+        blend.setAlphaOp(VK_BLEND_FACTOR_ONE, VK_BLEND_FACTOR_ONE, VK_BLEND_OP_ADD);
+        break;
+      case NVR_EXT_BLEND_MULTIPLY:
+        blend.setColorOp(VK_BLEND_FACTOR_DST_COLOR, VK_BLEND_FACTOR_ZERO, VK_BLEND_OP_ADD);
+        blend.setAlphaOp(VK_BLEND_FACTOR_DST_ALPHA, VK_BLEND_FACTOR_ZERO, VK_BLEND_OP_ADD);
+        break;
+      default:
+        blend.setColorOp(VK_BLEND_FACTOR_ONE, VK_BLEND_FACTOR_ZERO, VK_BLEND_OP_ADD);
+        blend.setAlphaOp(VK_BLEND_FACTOR_ONE, VK_BLEND_FACTOR_ZERO, VK_BLEND_OP_ADD);
+        break;
+    }
+
+    try {
+      // The fragment shader carries all bindings and the push block (offset 0; the pipeline has no shared block).
+      DxvkSpirvShaderCreateInfo fsInfo;
+      fsInfo.bindingCount = dxvkBindings.size();
+      fsInfo.bindings = dxvkBindings.data();
+
+      if (pDesc->PushConstantSize)
+        fsInfo.localPushData = DxvkPushDataBlock(VK_SHADER_STAGE_FRAGMENT_BIT, 0u, pDesc->PushConstantSize, 4u, pushResourceMask);
+
+      if (pDesc->UsesSamplerHeap)
+        fsInfo.samplerHeap = DxvkShaderBinding(VK_SHADER_STAGE_FRAGMENT_BIT, pDesc->SamplerHeapSet, pDesc->SamplerHeapBinding);
+
+      fsInfo.debugName = std::string(name) + " FS";
+
+      Rc<DxvkShader> fs = new DxvkSpirvShader(fsInfo,
+        SpirvCodeBuffer(pDesc->FragmentSpirvSize / 4u, reinterpret_cast<const uint32_t*>(pDesc->pFragmentSpirv)));
+
+      if (fs->metadata().stage != VK_SHADER_STAGE_FRAGMENT_BIT) {
+        Logger::err(str::format("NVR ext: ", name, ": the SPIR-V is not a fragment shader"));
+        return D3DERR_INVALIDCALL;
+      }
+
+      DxvkSpirvShaderCreateInfo vsInfo;
+      vsInfo.debugName = std::string(name) + " VS";
+
+      Rc<DxvkShader> vs = pDesc->pVertexSpirv
+        ? new DxvkSpirvShader(vsInfo, SpirvCodeBuffer(pDesc->VertexSpirvSize / 4u, reinterpret_cast<const uint32_t*>(pDesc->pVertexSpirv)))
+        : new DxvkSpirvShader(vsInfo, d3d9_nvr_fullscreen_vert);
+
+      if (vs->metadata().stage != VK_SHADER_STAGE_VERTEX_BIT) {
+        Logger::err(str::format("NVR ext: ", name, ": the vertex SPIR-V is not a vertex shader"));
+        return D3DERR_INVALIDCALL;
+      }
+
+      *ppPipeline = ref(new D3D9NvrExtPipeline(std::move(vs), std::move(fs), pDesc->PushConstantSize,
+        std::move(ownBindings), pDesc->ColorTargetCount, blend));
+      Logger::info(str::format("NVR ext: graphics pipeline '", name, "' created (", pDesc->BindingCount, " bindings, ",
+        pDesc->PushConstantSize, " push bytes, ", pDesc->ColorTargetCount, " targets)"));
+      return D3D_OK;
+    } catch (const DxvkError& e) {
+      Logger::err(str::format("NVR ext: ", name, ": ", e.message()));
+      return D3DERR_INVALIDCALL;
+    }
+  }

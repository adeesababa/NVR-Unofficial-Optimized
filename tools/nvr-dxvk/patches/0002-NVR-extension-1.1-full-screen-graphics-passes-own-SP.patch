@@ -963,6 +963,34 @@ namespace dxvk {
       m_flags.set(DxvkContextFlag::DirtyPushData);
     }
 
+    /**
+     * \brief NVR extension: whole context state snapshot
+     *
+     * An injected graphics pass (own render targets, viewport, shaders and
+     * pipeline state) takes a copy before and puts it back afterwards with
+     * \ref nvrSetState, which ends the current pass and marks everything
+     * dirty so the client API's state is re-applied at its next draw.
+     */
+    DxvkContextState nvrGetState() const {
+      return m_state;
+    }
+
+    void nvrSetState(DxvkContextState&& state) {
+      this->endCurrentPass(false);
+
+      m_state = std::move(state);
+
+      this->unbindGraphicsPipeline();
+      this->unbindComputePipeline();
+
+      m_flags.set(DxvkContextFlag::GpDirtyRenderTargets,
+                  DxvkContextFlag::GpDirtySpecDataBlock,
+                  DxvkContextFlag::DirtyDrawBuffer,
+                  DxvkContextFlag::DirtyPushData);
+
+      m_descriptorState.dirtyStages(VK_SHADER_STAGE_ALL);
+    }
+
     /**
      * \brief Updates push data

+  /** CS thread: binds the resolved resources to the extension's slots for one stage. */
+  static void NvrBindResources(DxvkContext* ctx, VkShaderStageFlags stage, const small_vector<D3D9NvrExtBound, 8>& bound) {
+    for (size_t i = 0; i < bound.size(); i++) {
+      const auto& b = bound[i];
+
+      switch (b.type) {
+        case NVR_EXT_BIND_SAMPLED_IMAGE:
+          ctx->bindResourceImageView(stage, NvrExtImageSlotBase + b.slot, b.image->createView(b.viewKey));
+          break;
+
+        case NVR_EXT_BIND_STORAGE_IMAGE: {
+          DxvkImageUsageInfo usage = { };
+          usage.usage  = VK_IMAGE_USAGE_STORAGE_BIT;
+          usage.stages = util::pipelineStages(stage);
+          usage.access = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT;
+          usage.layout = VK_IMAGE_LAYOUT_GENERAL;
+
+          if (!ctx->ensureImageCompatibility(b.image, usage)) {
+            Logger::err("NVR ext: a texture cannot be used as a storage image (format?)");
+            ctx->bindResourceImageView(stage, NvrExtImageSlotBase + b.slot, nullptr);
+            break;
+          }
+
+          ctx->bindResourceImageView(stage, NvrExtImageSlotBase + b.slot, b.image->createView(b.viewKey));
+        } break;
+
+        case NVR_EXT_BIND_STORAGE_BUFFER:
+          if (b.writes) {
+            DxvkBufferViewKey viewKey = { };
+            viewKey.format = VK_FORMAT_UNDEFINED;
+            viewKey.usage  = VK_BUFFER_USAGE_STORAGE_BUFFER_BIT;
+            viewKey.offset = b.buffer.offset();
+            viewKey.size   = b.buffer.length();
+            ctx->bindResourceBufferView(stage, NvrExtBufferViewSlotBase + b.slot, b.buffer.buffer()->createView(viewKey));
+            break;
+          }
+          ctx->bindUniformBuffer(stage, NvrExtBufferSlotBase + b.slot, DxvkBufferSlice(b.buffer));
+          break;
+
+        case NVR_EXT_BIND_UNIFORM_BUFFER:
+          ctx->bindUniformBuffer(stage, NvrExtBufferSlotBase + b.slot, DxvkBufferSlice(b.buffer));
+          break;
+
+        case NVR_EXT_BIND_SAMPLER:
+          ctx->bindResourceSampler(stage, NvrExtSamplerSlotBase + b.slot, Rc<DxvkSampler>(b.sampler));
+          break;
+
+        default:
+          break;
+      }
+    }
+  }
+
+
+  /** CS thread: drops the references again so textures and buffers do not stay alive or tracked through the frame. */
+  static void NvrUnbindResources(DxvkContext* ctx, VkShaderStageFlags stage, const small_vector<D3D9NvrExtBound, 8>& bound) {
+    for (size_t i = 0; i < bound.size(); i++) {
+      const auto& b = bound[i];
+
+      switch (b.type) {
+        case NVR_EXT_BIND_SAMPLED_IMAGE:
+        case NVR_EXT_BIND_STORAGE_IMAGE:
+          ctx->bindResourceImageView(stage, NvrExtImageSlotBase + b.slot, nullptr);
+          break;
+
+        case NVR_EXT_BIND_STORAGE_BUFFER:
+          if (b.writes) {
+            ctx->bindResourceBufferView(stage, NvrExtBufferViewSlotBase + b.slot, nullptr);
+            break;
+          }
+          ctx->bindUniformBuffer(stage, NvrExtBufferSlotBase + b.slot, DxvkBufferSlice());
+          break;
+
+        case NVR_EXT_BIND_UNIFORM_BUFFER:
+          ctx->bindUniformBuffer(stage, NvrExtBufferSlotBase + b.slot, DxvkBufferSlice());
+          break;
+
+        case NVR_EXT_BIND_SAMPLER:
+          ctx->bindResourceSampler(stage, NvrExtSamplerSlotBase + b.slot, nullptr);
+          break;
+
+        default:
+          break;
+      }
+    }
+  }

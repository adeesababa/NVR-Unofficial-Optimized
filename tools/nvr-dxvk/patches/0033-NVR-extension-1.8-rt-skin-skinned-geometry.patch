@@ -53,6 +58,46 @@ void main() {
   if (id >= p.count)
     return;
 
+  if (p.mode == MODE_SKIN) {
+    Words b = Words(p.src);
+    uint at = (p.srcOffset + id * p.stride) >> 2u;
+    vec4 pos = vec4(uintBitsToFloat(b.w[at]), uintBitsToFloat(b.w[at + 1u]), uintBitsToFloat(b.w[at + 2u]), 1.0);
+    uint weightCount = p.vertexCount & 15u, bones = (p.vertexCount >> 4u) & 15u, weightsFormat = (p.vertexCount >> 8u) & 15u;
+    uint indicesFormat = (p.vertexCount >> 12u) & 15u;
+    uint wAt = (uint(p.baseVertex) + id * p.stride) >> 2u;
+    float w[4] = float[4](0.0, 0.0, 0.0, 0.0);
+    for (uint k = 0u; k < 4u; k++) {
+      if (k >= weightCount) break;
+      if (weightsFormat == 0u) w[k] = uintBitsToFloat(b.w[wAt + k]);
+      else if (weightsFormat == 1u) w[k] = unpackHalf2x16(b.w[wAt + (k >> 1u)])[k & 1u];
+      else w[k] = float((b.w[wAt] >> (8u * k)) & 255u) / 255.0;
+    }
+    if (weightCount < bones) {
+      float sum = 0.0;
+      for (uint k = 0u; k < 3u; k++) if (k < bones - 1u) sum += w[k];
+      w[bones - 1u] = 1.0 - sum;
+    }
+    uint packedIndices = b.w[(p.dstOffset + id * p.stride) >> 2u];
+    Bones palette = Bones(p.palette);
+    vec3 posed = vec3(0.0);
+    float total = 0.0;
+    for (uint k = 0u; k < 4u; k++) {
+      if (k >= bones) break;
+      uint byteIndex = indicesFormat == 1u ? (k == 0u ? 2u : k == 2u ? 0u : k) : k;   // D3DCOLOR keeps b, g, r, a
+      uint bone = min((packedIndices >> (8u * byteIndex)) & 255u, max(p.pad, 1u) - 1u);
+      posed += w[k] * vec3(dot(palette.rows[bone * 3u], pos), dot(palette.rows[bone * 3u + 1u], pos), dot(palette.rows[bone * 3u + 2u], pos));
+      total += w[k];
+    }
+    if (total > 1.0e-4) posed /= total;
+    if (any(isnan(posed)) || any(isinf(posed)))
+      posed = vec3(0.0);
+    Floats o = Floats(p.dst);
+    o.f[id * 3u + 0u] = posed.x;
+    o.f[id * 3u + 1u] = posed.y;
+    o.f[id * 3u + 2u] = posed.z;
+    return;
+  }
+
   if (p.mode == MODE_UV_FLOAT2 || p.mode == MODE_UV_HALF2) {

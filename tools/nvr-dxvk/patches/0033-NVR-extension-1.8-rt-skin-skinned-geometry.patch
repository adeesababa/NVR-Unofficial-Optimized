+++ b/src/d3d9/d3d9_nvr_rt.cpp
@@ -27,6 +27,8 @@ namespace dxvk {
       uint32_t dstOffset;
       uint32_t vertexCount;
       uint32_t pad;
+      uint64_t palette;   // 1.8-rt-skin: the bone palette (12 floats a bone)
+      uint32_t pad2[2];
     };
 
     constexpr uint32_t ModePositionsFloat = 0u;
@@ -35,6 +37,7 @@ namespace dxvk {
     constexpr uint32_t ModeStrip          = 3u;
     constexpr uint32_t ModeUvFloat2       = 4u;   // 1.8-rt-uv
     constexpr uint32_t ModeUvHalf2        = 5u;
+    constexpr uint32_t ModeSkin           = 6u;   // 1.8-rt-skin
 
     constexpr size_t   MaxPendingJobs      = 512u;
     constexpr uint64_t MaxPendingTriangles = 4u << 20;
@@ -529,7 +532,7 @@ namespace dxvk {
   }
 
 
-  void D3D9NvrRt::RecordConversions(DxvkContext* ctx, const Rc<DxvkShader>& convert, const std::vector<D3D9NvrRtJob>& jobs) {
+  void D3D9NvrRt::RecordConversions(DxvkContext* ctx, const Rc<DxvkShader>& convert, const std::vector<D3D9NvrRtJob>& jobs, uint64_t palettes) {
     DxvkPushDataState savedPushData = ctx->nvrGetPushDataState();
     ctx->bindShader<VK_SHADER_STAGE_COMPUTE_BIT>(Rc<DxvkShader>(convert));
 
@@ -539,10 +542,17 @@ namespace dxvk {
       D3D9NvrRtConvertPush push = { };
       push.src       = job.vertexBuffer->getSliceInfo().gpuAddress;
       push.dst       = dst + job.dstPositions;
-      push.mode      = job.half ? ModePositionsHalf4 : ModePositionsFloat;
+      push.mode      = job.skin ? ModeSkin : job.half ? ModePositionsHalf4 : ModePositionsFloat;
       push.count     = job.vertexCount;
       push.srcOffset = job.positionOffset;
       push.stride    = job.stride;
+      if (job.skin) {   // 1.8-rt-skin: baseVertex / dstOffset / vertexCount carry the weights, the indices and the formats
+        push.baseVertex  = int32_t(job.weightsOffset);
+        push.dstOffset   = job.indicesOffset;
+        push.vertexCount = job.skinBits;
+        push.palette     = palettes + job.paletteOffset;
+        push.pad         = uint32_t(job.palette.size() / 12u);
+      }
       ctx->pushData(VK_SHADER_STAGE_COMPUTE_BIT, 0u, sizeof(push), &push);
       ctx->dispatch((job.vertexCount + 63u) / 64u, 1u, 1u);
 
@@ -616,6 +626,28 @@ namespace dxvk {
           ID3D9NvrExtSharedImage*         pArena,
           UINT                            DstTexel,
           NVR_EXT_RT_GEOMETRY_INFO*       pInfo) {
+    return StageImpl(pDesc, nullptr, pArena, DstTexel, pInfo);
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9NvrRt::StageSkinnedGeometry(
+    const NVR_EXT_RT_GEOMETRY_DESC*       pDesc,
+    const NVR_EXT_RT_SKIN_DESC*           pSkin,
+          ID3D9NvrExtSharedImage*         pArena,
+          UINT                            DstTexel,
+          NVR_EXT_RT_GEOMETRY_INFO*       pInfo) {
+    if (pSkin == nullptr)
+      return D3DERR_INVALIDCALL;
+    return StageImpl(pDesc, pSkin, pArena, DstTexel, pInfo);
+  }
+
+
+  HRESULT D3D9NvrRt::StageImpl(
+    const NVR_EXT_RT_GEOMETRY_DESC*       pDesc,
+    const NVR_EXT_RT_SKIN_DESC*           pSkin,
+          ID3D9NvrExtSharedImage*         pArena,
+          UINT                            DstTexel,
+          NVR_EXT_RT_GEOMETRY_INFO*       pInfo) {
     if (pInfo != nullptr)
       *pInfo = NVR_EXT_RT_GEOMETRY_INFO();
 
@@ -641,6 +673,27 @@ namespace dxvk {
     if (FAILED(hr))
       return hr;
 
+    // 1.8-rt-skin: the posing (positions float3 / float4 only; the weights and indices in the position's stream)
+    if (pSkin != nullptr) {
+      const char* name = pDesc->pDebugName ? pDesc->pDebugName : "(unnamed)";
+      const uint64_t vbSize = job.vertexBuffer->info().size;
+      const int64_t weights = int64_t(job.positionOffset) + pSkin->WeightsDelta;
+      const int64_t indices = int64_t(job.positionOffset) + pSkin->IndicesDelta;
+      const uint64_t last = uint64_t(job.vertexCount - 1u) * job.stride;
+      if (job.half || pSkin->BonesPerVertex < 1u || pSkin->BonesPerVertex > 4u || pSkin->WeightCount > 4u ||
+          pSkin->PaletteCount == 0u || pSkin->PaletteCount > NVR_EXT_RT_SKIN_MAX_BONES || pSkin->pPalette == nullptr ||
+          weights < 0 || (weights & 3) || indices < 0 || (indices & 3) ||
+          uint64_t(weights) + last + 4u > vbSize || uint64_t(indices) + last + 4u > vbSize) {
+        Logger::warn(str::format("NVR ext rt: skinned geometry ", name, " refused: the skin description is out of range"));
+        return D3DERR_INVALIDCALL;
+      }
+      job.skin = true;   // texcoords (Flags) still welcome: posed positions + the static texcoords (textured actors, 2026-10-30)
+      job.weightsOffset = uint32_t(weights);
+      job.indicesOffset = uint32_t(indices);
+      job.skinBits = pSkin->WeightCount | (pSkin->BonesPerVertex << 4u) | (uint32_t(pSkin->WeightsFormat) << 8u) | (uint32_t(pSkin->IndicesFormat) << 12u);
+      job.palette.assign(pSkin->pPalette, pSkin->pPalette + size_t(pSkin->PaletteCount) * 12u);
+    }
+
     const uint64_t texels = 3ull * (uint64_t(job.vertexCount) + job.triangles) + (job.uv ? 2ull * job.vertexCount : 0ull);
     const uint64_t capacity = uint64_t(arena.Width) * arena.Height;
 
@@ -699,7 +752,28 @@ namespace dxvk {
     const uint32_t rowFirst = m_stagedMin / size.width;
     const uint32_t rowEnd = std::min<uint32_t>((m_stagedMax + size.width - 1u) / size.width, size.height);
 
+    // 1.8-rt-skin: the skinned jobs' palettes, packed into one buffer (refilled at this flush)
+    std::vector<float> paletteData;
+    for (auto& job : m_staged) {
+      if (!job.skin)
+        continue;
+      job.paletteOffset = VkDeviceSize(paletteData.size()) * 4u;
+      paletteData.insert(paletteData.end(), job.palette.begin(), job.palette.end());
+      while (paletteData.size() & 3u)
+        paletteData.push_back(0.0f);
+    }
+    const VkDeviceSize paletteBytes = VkDeviceSize(paletteData.size()) * 4u;
+    if (paletteBytes && (m_palettes == nullptr || m_palettes->info().size < paletteBytes))
+      m_palettes = CreateRtBuffer(std::max<VkDeviceSize>(paletteBytes * 2u, 64u << 10),
+        VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT, "NVR rt bone palettes");
+    if (paletteBytes && m_palettes == nullptr) {
+      m_staged.erase(std::remove_if(m_staged.begin(), m_staged.end(), [] (const D3D9NvrRtJob& j) { return j.skin; }), m_staged.end());
+      paletteData.clear();
+    }
+
     m_device->EmitCs([
+      cPalettes    = paletteData.empty() ? Rc<DxvkBuffer>() : m_palettes,
+      cPaletteData = std::move(paletteData),
       cJobs    = std::move(m_staged),
       cConvert = m_convert,
       cStaging = m_staging,
@@ -708,10 +782,19 @@ namespace dxvk {
       cRows    = rowEnd - rowFirst,
       cWidth   = size.width
     ] (DxvkContext* ctx) {
-      // Everything earlier (the game's uploads of these buffers, the last copy out of the staging) before the conversions
+      // 1.8-rt-skin: the palettes first (DXVK orders this write after the last flush's reads: tracked below)
+      if (cPalettes != nullptr) {
+        const VkDeviceSize bytes = VkDeviceSize(cPaletteData.size()) * 4u;
+        for (VkDeviceSize at = 0u; at < bytes; at += 65536u)
+          ctx->updateBuffer(cPalettes, at, std::min<VkDeviceSize>(65536u, bytes - at), reinterpret_cast<const char*>(cPaletteData.data()) + at);
+      }
+
+      // Everything earlier (the game's uploads of these buffers, the last copy out of the staging, the palettes) before the conversions
       ctx->nvrBeginRawCommands();
 
-      RecordConversions(ctx, cConvert, cJobs);
+      RecordConversions(ctx, cConvert, cJobs, cPalettes != nullptr ? cPalettes->getSliceInfo().gpuAddress : 0u);
+      if (cPalettes != nullptr)
+        ctx->nvrTrackResource(cPalettes, DxvkAccess::Read);
 
       // The conversions' writes before the copy reads them (DXVK does not see writes by address)
       ctx->nvrBeginRawCommands();

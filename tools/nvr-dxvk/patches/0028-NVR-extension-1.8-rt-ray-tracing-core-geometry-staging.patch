+  ////////////////////////////////
+  // The interface
+  ///////////////////////////////
+
+  D3D9NvrRt::D3D9NvrRt(D3D9DeviceEx* pDevice)
+  : m_device(pDevice) {
+    Rc<DxvkDevice> device = m_device->GetDXVKDevice();
+    const DxvkDeviceFeatures& features = device->features();
+
+    // The conversion shader serves both paths (the helper's arena and in-process builds)
+    try {
+      DxvkSpirvShaderCreateInfo info;
+      info.localPushData = DxvkPushDataBlock(VK_SHADER_STAGE_COMPUTE_BIT, 0u, sizeof(D3D9NvrRtConvertPush), 4u, 0u);
+      info.debugName = "NVR rt convert";
+      m_convert = new DxvkSpirvShader(info, d3d9_nvr_rt_convert);
+    } catch (const DxvkError& e) {
+      m_reason = str::format("the conversion shader failed: ", e.message());
+      Logger::err(str::format("NVR ext rt: ", m_reason));
+      return;
+    }
+
+    if (!features.khrAccelerationStructure.accelerationStructure || !features.khrRayQuery.rayQuery) {
+      m_reason = "no in-process ray tracing (dxvk.conf nvr.rayTracing is off, or this 32-bit driver has no VK_KHR_ray_query): use the helper";
+      Logger::info(str::format("NVR ext rt: geometry staging for the ray tracing helper ready; ", m_reason));
+      return;
+    }
+
+    VkPhysicalDeviceAccelerationStructurePropertiesKHR asProperties = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_ACCELERATION_STRUCTURE_PROPERTIES_KHR };
+    VkPhysicalDeviceProperties2 properties = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2 };
+    properties.pNext = &asProperties;
+
+    Rc<DxvkAdapter> adapter = device->adapter();
+    adapter->vki()->vkGetPhysicalDeviceProperties2(adapter->handle(), &properties);
+
+    m_scratchAlign  = std::max<VkDeviceSize>(asProperties.minAccelerationStructureScratchOffsetAlignment, 256u);
+    m_maxInstances  = uint32_t(std::min<uint64_t>(asProperties.maxInstanceCount, 1u << 20));
+    m_maxPrimitives = asProperties.maxPrimitiveCount;
+
+    m_supported = true;
+    Logger::info(str::format("NVR ext rt: in-process ray tracing on ", properties.properties.deviceName,
+      " (max ", m_maxInstances, " instances a scene, ", m_maxPrimitives, " triangles a geometry, scratch alignment ",
+      asProperties.minAccelerationStructureScratchOffsetAlignment, ")"));
+  }

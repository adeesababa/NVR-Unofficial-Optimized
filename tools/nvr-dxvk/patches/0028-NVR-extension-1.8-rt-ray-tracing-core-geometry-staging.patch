diff --git a/src/d3d9/shaders/d3d9_nvr_rt_convert.comp b/src/d3d9/shaders/d3d9_nvr_rt_convert.comp
new file mode 100644
index 0000000..f8199c9
--- /dev/null
+++ b/src/d3d9/shaders/d3d9_nvr_rt_convert.comp
@@ -0,0 +1,97 @@
+#version 460
+
+// NVR ray tracing core (fork patch 0028): the input of one bottom-level structure build, from the game's D3D9 buffers.
+// One dispatch per job: the positions (any stride and offset; float3, float4 or half4) into a packed float3 array, or
+// one draw range's indices (16 or 32 bit, list or strip, or none) into a uint triangle list. Everything by device
+// address (every DXVK buffer has one): no descriptors. An index that would reach past the vertices makes its triangle
+// degenerate (all three corners vertex 0): zero area, never hit, and the build never reads out of range.
+
+#extension GL_EXT_buffer_reference : require
+#extension GL_EXT_buffer_reference_uvec2 : require
+
+layout(local_size_x = 64) in;
+
+layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Words { uint w[]; };
+layout(buffer_reference, std430, buffer_reference_align = 4) writeonly buffer Floats { float f[]; };
+layout(buffer_reference, std430, buffer_reference_align = 4) writeonly buffer Uints { uint u[]; };
+
+#define MODE_POSITIONS_FLOAT  0u   // float3 or float4
+#define MODE_POSITIONS_HALF4  1u
+#define MODE_LIST             2u
+#define MODE_STRIP            3u
+
+layout(push_constant) uniform Push {
+  uvec2 src;          // the D3D9 buffer (vertex or index buffer) at offset 0
+  uvec2 dst;          // positions: float3 array; indices: uint array
+  uint  mode;
+  uint  count;        // positions: vertices; indices: triangles
+  uint  srcOffset;    // positions: bytes to vertex 0's position; indices: first index (in indices; or first vertex without an index buffer)
+  uint  stride;       // positions: vertex stride in bytes; indices: index size in bytes (2 or 4), 0 = no index buffer
+  int   baseVertex;   // indices: added to each index
+  uint  dstOffset;    // indices: first uint written
+  uint  vertexCount;  // indices: the vertices available
+  uint  pad;
+} p;
+
+uint readU16(Words b, uint byteOffset) {
+  uint word = b.w[byteOffset >> 2u];
+  return (byteOffset & 2u) != 0u ? (word >> 16u) : (word & 0xFFFFu);
+}
+
+uint readIndex(uint i) {
+  if (p.stride == 0u)
+    return p.srcOffset + i;
+  Words b = Words(p.src);
+  uint at = p.srcOffset + i;
+  return p.stride == 2u ? readU16(b, at * 2u) : b.w[at];
+}
+
+void main() {
+  uint id = gl_GlobalInvocationID.x;
+  if (id >= p.count)
+    return;
+
+  if (p.mode <= MODE_POSITIONS_HALF4) {
+    Words b = Words(p.src);
+    uint at = p.srcOffset + id * p.stride;   // bytes, 4-aligned (checked on the host)
+    vec3 pos;
+    if (p.mode == MODE_POSITIONS_FLOAT) {
+      pos = vec3(uintBitsToFloat(b.w[at >> 2u]), uintBitsToFloat(b.w[(at >> 2u) + 1u]), uintBitsToFloat(b.w[(at >> 2u) + 2u]));
+    } else {
+      vec2 xy = unpackHalf2x16(b.w[at >> 2u]);
+      vec2 zw = unpackHalf2x16(b.w[(at >> 2u) + 1u]);
+      pos = vec3(xy, zw.x);
+    }
+    // NaN or infinite corners would make the build undefined: such a vertex goes to the origin
+    if (any(isnan(pos)) || any(isinf(pos)))
+      pos = vec3(0.0);
+    Floats o = Floats(p.dst);
+    o.f[id * 3u + 0u] = pos.x;
+    o.f[id * 3u + 1u] = pos.y;
+    o.f[id * 3u + 2u] = pos.z;
+    return;
+  }
+
+  uvec3 tri;
+  if (p.mode == MODE_LIST) {
+    tri = uvec3(readIndex(id * 3u), readIndex(id * 3u + 1u), readIndex(id * 3u + 2u));
+  } else {
+    tri = uvec3(readIndex(id), readIndex(id + 1u), readIndex(id + 2u));
+    if ((id & 1u) != 0u)
+      tri.xy = tri.yx;   // a strip's odd triangles have the other winding
+  }
+
+  if (p.stride != 0u) {
+    ivec3 v = ivec3(tri) + p.baseVertex;
+    tri = uvec3(max(v, ivec3(0)));
+    if (any(lessThan(v, ivec3(0))))
+      tri = uvec3(0u);
+  }
+  if (any(greaterThanEqual(tri, uvec3(p.vertexCount))))
+    tri = uvec3(0u);
+
+  Uints o = Uints(p.dst);
+  o.u[p.dstOffset + id * 3u + 0u] = tri.x;
+  o.u[p.dstOffset + id * 3u + 1u] = tri.y;
+  o.u[p.dstOffset + id * 3u + 2u] = tri.z;
+}

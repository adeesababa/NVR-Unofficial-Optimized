+
+  D3D9CommonBuffer* D3D9NvrRt::ResolveBuffer(IUnknown* pResource, D3DRESOURCETYPE type) {
+    if (pResource == nullptr)
+      return nullptr;
+
+    Com<IDirect3DResource9> resource;
+    if (FAILED(pResource->QueryInterface(__uuidof(IDirect3DResource9), reinterpret_cast<void**>(&resource))))
+      return nullptr;
+
+    if (resource->GetType() != type)
+      return nullptr;
+
+    if (type == D3DRTYPE_VERTEXBUFFER)
+      return static_cast<D3D9VertexBuffer*>(static_cast<IDirect3DVertexBuffer9*>(resource.ptr()))->GetCommonBuffer();
+
+    return static_cast<D3D9IndexBuffer*>(static_cast<IDirect3DIndexBuffer9*>(resource.ptr()))->GetCommonBuffer();
+  }
+
+
+  Rc<DxvkBuffer> D3D9NvrRt::CreateRtBuffer(VkDeviceSize size, VkBufferUsageFlags usage, const char* name) {
+    DxvkBufferCreateInfo info;
+    info.size   = std::max<VkDeviceSize>(size, 256u);
+    info.usage  = usage | VK_BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT;
+    info.stages = VK_PIPELINE_STAGE_ALL_COMMANDS_BIT;
+    info.access = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT;
+    info.debugName = name;
+
+    try {
+      Rc<DxvkBuffer> buffer = m_device->GetDXVKDevice()->createBuffer(info, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+      buffer->enableStableAddress();   // structures and the instances refer to it by address
+      return buffer;
+    } catch (const DxvkError& e) {
+      Logger::err(str::format("NVR ext rt: ", name, ": ", e.message()));
+      return nullptr;
+    }
+  }
+
+
+  Rc<D3D9NvrRtAccel> D3D9NvrRt::CreateAccel(VkAccelerationStructureTypeKHR type, VkDeviceSize size, const char* name) {
+    Rc<DxvkBuffer> storage = CreateRtBuffer(size, VK_BUFFER_USAGE_ACCELERATION_STRUCTURE_STORAGE_BIT_KHR, name);
+
+    if (storage == nullptr)
+      return nullptr;
+
+    DxvkResourceBufferInfo slice = storage->getSliceInfo();
+
+    if (slice.offset % 256u) {
+      Logger::err(str::format("NVR ext rt: ", name, ": storage offset ", slice.offset, " is not 256-aligned"));
+      return nullptr;
+    }
+
+    Rc<vk::DeviceFn> vkd = m_device->GetDXVKDevice()->vkd();
+
+    VkAccelerationStructureCreateInfoKHR info = { VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_CREATE_INFO_KHR };
+    info.buffer = slice.buffer;
+    info.offset = slice.offset;
+    info.size   = size;
+    info.type   = type;
+
+    VkAccelerationStructureKHR handle = VK_NULL_HANDLE;
+    VkResult vr = vkd->vkCreateAccelerationStructureKHR(vkd->device(), &info, nullptr, &handle);
+
+    if (vr != VK_SUCCESS) {
+      Logger::err(str::format("NVR ext rt: ", name, ": vkCreateAccelerationStructureKHR failed: ", vr));
+      return nullptr;
+    }
+
+    VkAccelerationStructureDeviceAddressInfoKHR addressInfo = { VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_DEVICE_ADDRESS_INFO_KHR };
+    addressInfo.accelerationStructure = handle;
+    uint64_t address = vkd->vkGetAccelerationStructureDeviceAddressKHR(vkd->device(), &addressInfo);
+
+    return new D3D9NvrRtAccel(vkd, handle, std::move(storage), address);
+  }
+
+
+  HRESULT D3D9NvrRt::PrepareJob(const NVR_EXT_RT_GEOMETRY_DESC* pDesc, D3D9NvrRtJob& job, bool Upload) {
+    if (pDesc == nullptr)
+      return D3DERR_INVALIDCALL;
+
+    const char* name = pDesc->pDebugName ? pDesc->pDebugName : "(unnamed)";
+    auto refuse = [name] (const std::string& why) {
+      Logger::warn(str::format("NVR ext rt: geometry ", name, " refused: ", why));
+      return D3DERR_INVALIDCALL;
+    };
+
+    D3D9CommonBuffer* vb = ResolveBuffer(pDesc->pVertexBuffer, D3DRTYPE_VERTEXBUFFER);
+    D3D9CommonBuffer* ib = pDesc->pIndexBuffer ? ResolveBuffer(pDesc->pIndexBuffer, D3DRTYPE_INDEXBUFFER) : nullptr;
+
+    if (vb == nullptr)
+      return refuse("no D3D9 vertex buffer");
+    if (pDesc->pIndexBuffer && ib == nullptr)
+      return refuse("the index buffer is not a D3D9 index buffer");
+    if (pDesc->RangeCount == 0u || pDesc->RangeCount > NVR_EXT_RT_MAX_RANGES || pDesc->pRanges == nullptr)
+      return refuse(str::format("range count ", pDesc->RangeCount));
+    if (pDesc->VertexStride == 0u || (pDesc->VertexStride & 3u) || (pDesc->PositionOffset & 3u))
+      return refuse(str::format("stride ", pDesc->VertexStride, " / position offset ", pDesc->PositionOffset, " (both must be multiples of 4)"));
+
+    uint32_t positionSize = 0u;
+    switch (pDesc->PositionFormat) {
+      case NVR_EXT_RT_POSITION_FLOAT3: positionSize = 12u; break;
+      case NVR_EXT_RT_POSITION_FLOAT4: positionSize = 16u; break;
+      case NVR_EXT_RT_POSITION_HALF4:  positionSize =  8u; break;
+      default: return refuse("position format");
+    }
+
+    const uint64_t vbSize = vb->Desc()->Size;
+
+    if (pDesc->PositionOffset + positionSize > vbSize)
+      return refuse("the position offset is past the vertex buffer");
+
+    uint32_t vertexCount = pDesc->VertexCount
+      ? pDesc->VertexCount
+      : uint32_t((vbSize - pDesc->PositionOffset - positionSize) / pDesc->VertexStride + 1u);
+
+    if (vertexCount == 0u || pDesc->PositionOffset + uint64_t(vertexCount - 1u) * pDesc->VertexStride + positionSize > vbSize)
+      return refuse(str::format(vertexCount, " vertices do not fit the vertex buffer (", vbSize, " bytes)"));
+
+    const uint32_t indexSize = ib ? (ib->Desc()->Format == D3D9Format::INDEX32 ? 4u : 2u) : 0u;
+    const uint64_t ibSize = ib ? ib->Desc()->Size : 0u;
+
+    job.positionOffset = pDesc->PositionOffset;
+    job.stride         = pDesc->VertexStride;
+    job.vertexCount    = vertexCount;
+    job.indexSize      = indexSize;
+    job.half           = pDesc->PositionFormat == NVR_EXT_RT_POSITION_HALF4;
+
+    uint64_t triangles = 0u;
+
+    for (uint32_t i = 0u; i < pDesc->RangeCount; i++) {
+      const NVR_EXT_RT_RANGE& r = pDesc->pRanges[i];
+
+      if (r.PrimitiveCount == 0u)
+        continue;
+
+      const bool strip = r.Topology == NVR_EXT_RT_TRIANGLE_STRIP;
+
+      if (!strip && r.Topology != NVR_EXT_RT_TRIANGLE_LIST)
+        return refuse(str::format("range ", i, ": topology"));
+
+      const uint64_t elements = strip ? uint64_t(r.PrimitiveCount) + 2u : uint64_t(r.PrimitiveCount) * 3u;
+
+      if (ib ? (uint64_t(r.StartIndex) + elements) * indexSize > ibSize : uint64_t(r.StartIndex) + elements > vertexCount)
+        return refuse(str::format("range ", i, " (start ", r.StartIndex, ", ", r.PrimitiveCount, " triangles) reads past the ", ib ? "index" : "vertex", " buffer"));
+
+      D3D9NvrRtJob::Range range;
+      range.mode       = strip ? ModeStrip : ModeList;
+      range.triangles  = r.PrimitiveCount;
+      range.start      = r.StartIndex;
+      range.dstOffset  = uint32_t(triangles * 3u);
+      range.baseVertex = ib ? r.BaseVertex : 0;
+      job.ranges.push_back(range);
+
+      triangles += r.PrimitiveCount;
+    }
+
+    if (triangles == 0u || (m_supported && triangles > m_maxPrimitives) || triangles > (1u << 28))
+      return refuse(str::format(triangles, " triangles"));
+
+    job.triangles = uint32_t(triangles);
+
+    if (!Upload)
+      return D3D_OK;
+
+    // Managed buffers may still have data only on the CPU side: upload it now, in order before the job
+    if (vb->NeedsUpload())
+      m_device->FlushBuffer(vb);
+    if (ib && ib->NeedsUpload())
+      m_device->FlushBuffer(ib);
+
+    job.vertexBuffer = vb->GetBuffer<D3D9_COMMON_BUFFER_TYPE_REAL>();
+    job.indexBuffer  = ib ? ib->GetBuffer<D3D9_COMMON_BUFFER_TYPE_REAL>() : nullptr;
+
+    return D3D_OK;
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9NvrRt::CreateGeometry(
+    const NVR_EXT_RT_GEOMETRY_DESC*       pDesc,
+          ID3D9NvrExtRtGeometry**         ppGeometry) {
+    if (ppGeometry == nullptr || pDesc == nullptr)
+      return D3DERR_INVALIDCALL;
+
+    *ppGeometry = nullptr;
+
+    if (!m_supported)
+      return D3DERR_NOTAVAILABLE;
+
+    D3D9DeviceLock lock = m_device->LockDevice();
+
+    D3D9NvrRtJob job;
+    HRESULT hr = PrepareJob(pDesc, job, true);
+
+    if (FAILED(hr))
+      return hr;
+
+    const uint32_t vertexCount = job.vertexCount;
+    const uint64_t triangles = job.triangles;
+
+    // Build sizes (the addresses do not matter for the query)
+    VkAccelerationStructureGeometryKHR geometry = { VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_GEOMETRY_KHR };
+    geometry.geometryType = VK_GEOMETRY_TYPE_TRIANGLES_KHR;
+    geometry.flags = VK_GEOMETRY_OPAQUE_BIT_KHR;
+    geometry.geometry.triangles.sType = VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_GEOMETRY_TRIANGLES_DATA_KHR;
+    geometry.geometry.triangles.vertexFormat = VK_FORMAT_R32G32B32_SFLOAT;
+    geometry.geometry.triangles.vertexStride = 12u;
+    geometry.geometry.triangles.maxVertex = vertexCount - 1u;
+    geometry.geometry.triangles.indexType = VK_INDEX_TYPE_UINT32;
+
+    VkAccelerationStructureBuildGeometryInfoKHR buildInfo = { VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_BUILD_GEOMETRY_INFO_KHR };
+    buildInfo.type = VK_ACCELERATION_STRUCTURE_TYPE_BOTTOM_LEVEL_KHR;
+    buildInfo.flags = VK_BUILD_ACCELERATION_STRUCTURE_PREFER_FAST_TRACE_BIT_KHR;
+    buildInfo.mode = VK_BUILD_ACCELERATION_STRUCTURE_MODE_BUILD_KHR;
+    buildInfo.geometryCount = 1u;
+    buildInfo.pGeometries = &geometry;
+
+    Rc<vk::DeviceFn> vkd = m_device->GetDXVKDevice()->vkd();
+    VkAccelerationStructureBuildSizesInfoKHR sizes = { VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_BUILD_SIZES_INFO_KHR };
+    vkd->vkGetAccelerationStructureBuildSizesKHR(vkd->device(), VK_ACCELERATION_STRUCTURE_BUILD_TYPE_DEVICE_KHR,
+      &buildInfo, &job.triangles, &sizes);
+
+    job.dstPositions = 0u;
+    job.dstIndices = AlignUp(VkDeviceSize(vertexCount) * 12u, 256u);
+    job.dst = CreateRtBuffer(job.dstIndices + VkDeviceSize(job.triangles) * 12u,
+      VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_ACCELERATION_STRUCTURE_BUILD_INPUT_READ_ONLY_BIT_KHR, "NVR rt geometry input");
+    job.scratchSize = sizes.buildScratchSize;
+    job.accel = CreateAccel(VK_ACCELERATION_STRUCTURE_TYPE_BOTTOM_LEVEL_KHR, sizes.accelerationStructureSize, "NVR rt geometry");
+
+    if (job.dst == nullptr || job.accel == nullptr)
+      return E_OUTOFMEMORY;
+
+    Rc<D3D9NvrRtAccel> accel = job.accel;
+    m_pendingTriangles += job.triangles;
+    m_pending.push_back(std::move(job));
+
+    if (m_pending.size() >= MaxPendingJobs || m_pendingTriangles >= MaxPendingTriangles)
+      FlushJobs();
+
+    m_geometries++;
+    m_triangles += triangles;
+    m_geometryBytes += accel->size();
+    m_geometriesBuilt++;
+
+    *ppGeometry = ref(new D3D9NvrRtGeometry(this, std::move(accel), uint32_t(triangles)));
+    return D3D_OK;
+  }
+
+
+  void D3D9NvrRt::FlushJobs() {
+    if (m_pending.empty())
+      return;
+
+    // One scratch buffer for the whole batch (every build of one call needs its own region)
+    std::vector<VkDeviceSize> scratchOffsets;
+    VkDeviceSize scratchTotal = 0u;
+
+    for (const auto& job : m_pending) {
+      scratchOffsets.push_back(scratchTotal);
+      scratchTotal += AlignUp(job.scratchSize, m_scratchAlign);
+    }
+
+    Rc<DxvkBuffer> scratch = CreateRtBuffer(scratchTotal + m_scratchAlign, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT, "NVR rt build scratch");
+
+    if (scratch == nullptr) {
+      Logger::err(str::format("NVR ext rt: no scratch memory for ", m_pending.size(), " builds: dropped (their geometries stay empty)"));
+      m_pending.clear();
+      m_pendingTriangles = 0u;
+      return;
+    }
+
+    m_device->EmitCs([
+      cJobs    = std::move(m_pending),
+      cScratch = std::move(scratch),
+      cOffsets = std::move(scratchOffsets),
+      cAlign   = m_scratchAlign,
+      cConvert = m_convert,
+      cVkd     = m_device->GetDXVKDevice()->vkd()
+    ] (DxvkContext* ctx) {
+      // Everything earlier (the game's uploads of these buffers among it) before the conversion reads them
+      ctx->nvrBeginRawCommands();
+
+      RecordConversions(ctx, cConvert, cJobs);
+
+      // The conversions' writes before the builds read them
+      VkCommandBuffer cmd = ctx->nvrBeginRawCommands();
+
+      const uint64_t scratchBase = AlignUp(cScratch->getSliceInfo().gpuAddress, cAlign);
+
+      std::vector<VkAccelerationStructureGeometryKHR> geometries(cJobs.size());
+      std::vector<VkAccelerationStructureBuildGeometryInfoKHR> infos(cJobs.size());
+      std::vector<VkAccelerationStructureBuildRangeInfoKHR> ranges(cJobs.size());
+      std::vector<const VkAccelerationStructureBuildRangeInfoKHR*> rangePointers(cJobs.size());
+
+      for (size_t i = 0u; i < cJobs.size(); i++) {
+        const auto& job = cJobs[i];
+        const uint64_t input = job.dst->getSliceInfo().gpuAddress;
+
+        VkAccelerationStructureGeometryKHR& g = geometries[i];
+        g = { VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_GEOMETRY_KHR };
+        g.geometryType = VK_GEOMETRY_TYPE_TRIANGLES_KHR;
+        g.flags = VK_GEOMETRY_OPAQUE_BIT_KHR;
+        g.geometry.triangles.sType = VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_GEOMETRY_TRIANGLES_DATA_KHR;
+        g.geometry.triangles.vertexFormat = VK_FORMAT_R32G32B32_SFLOAT;
+        g.geometry.triangles.vertexData.deviceAddress = input;
+        g.geometry.triangles.vertexStride = 12u;
+        g.geometry.triangles.maxVertex = job.vertexCount - 1u;
+        g.geometry.triangles.indexType = VK_INDEX_TYPE_UINT32;
+        g.geometry.triangles.indexData.deviceAddress = input + job.dstIndices;
+
+        VkAccelerationStructureBuildGeometryInfoKHR& b = infos[i];
+        b = { VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_BUILD_GEOMETRY_INFO_KHR };
+        b.type = VK_ACCELERATION_STRUCTURE_TYPE_BOTTOM_LEVEL_KHR;
+        b.flags = VK_BUILD_ACCELERATION_STRUCTURE_PREFER_FAST_TRACE_BIT_KHR;
+        b.mode = VK_BUILD_ACCELERATION_STRUCTURE_MODE_BUILD_KHR;
+        b.dstAccelerationStructure = job.accel->handle();
+        b.geometryCount = 1u;
+        b.pGeometries = &g;
+        b.scratchData.deviceAddress = scratchBase + cOffsets[i];
+
+        ranges[i] = VkAccelerationStructureBuildRangeInfoKHR { job.triangles, 0u, 0u, 0u };
+        rangePointers[i] = &ranges[i];
+      }
+
+      cVkd->vkCmdBuildAccelerationStructuresKHR(cmd, uint32_t(infos.size()), infos.data(), rangePointers.data());
+
+      // The builds before anything that reads the structures (a scene build, a pass)
+      ctx->nvrEndRawCommands(cmd);
+
+      ctx->nvrTrackResource(cScratch, DxvkAccess::Write);
+
+      for (const auto& job : cJobs) {
+        ctx->nvrTrackResource(job.dst, DxvkAccess::Write);
+        ctx->nvrTrack(job.accel);
+      }
+    });
+
+    m_pending.clear();
+    m_pendingTriangles = 0u;
+  }
+
+
+  void D3D9NvrRt::RecordConversions(DxvkContext* ctx, const Rc<DxvkShader>& convert, const std::vector<D3D9NvrRtJob>& jobs) {
+    DxvkPushDataState savedPushData = ctx->nvrGetPushDataState();
+    ctx->bindShader<VK_SHADER_STAGE_COMPUTE_BIT>(Rc<DxvkShader>(convert));
+
+    for (const auto& job : jobs) {
+      const uint64_t dst = job.dst->getSliceInfo().gpuAddress;
+
+      D3D9NvrRtConvertPush push = { };
+      push.src       = job.vertexBuffer->getSliceInfo().gpuAddress;
+      push.dst       = dst + job.dstPositions;
+      push.mode      = job.half ? ModePositionsHalf4 : ModePositionsFloat;
+      push.count     = job.vertexCount;
+      push.srcOffset = job.positionOffset;
+      push.stride    = job.stride;
+      ctx->pushData(VK_SHADER_STAGE_COMPUTE_BIT, 0u, sizeof(push), &push);
+      ctx->dispatch((job.vertexCount + 63u) / 64u, 1u, 1u);
+
+      const uint64_t indices = job.indexBuffer != nullptr ? job.indexBuffer->getSliceInfo().gpuAddress : 0u;
+
+      for (const auto& range : job.ranges) {
+        push = D3D9NvrRtConvertPush();
+        push.src         = indices;
+        push.dst         = dst + job.dstIndices;
+        push.mode        = range.mode;
+        push.count       = range.triangles;
+        push.srcOffset   = range.start;
+        push.stride      = job.indexSize;
+        push.baseVertex  = range.baseVertex;
+        push.dstOffset   = range.dstOffset;
+        push.vertexCount = job.vertexCount;
+        ctx->pushData(VK_SHADER_STAGE_COMPUTE_BIT, 0u, sizeof(push), &push);
+        ctx->dispatch((range.triangles + 63u) / 64u, 1u, 1u);
+      }
+
+      ctx->nvrTrackResource(job.vertexBuffer, DxvkAccess::Read);
+      if (job.indexBuffer != nullptr)
+        ctx->nvrTrackResource(job.indexBuffer, DxvkAccess::Read);
+    }
+
+    ctx->bindShader<VK_SHADER_STAGE_COMPUTE_BIT>(nullptr);
+    ctx->nvrSetPushDataState(savedPushData);
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9NvrRt::MeasureGeometry(
+    const NVR_EXT_RT_GEOMETRY_DESC*       pDesc,
+          NVR_EXT_RT_GEOMETRY_INFO*       pInfo) {
+    if (pInfo == nullptr)
+      return D3DERR_INVALIDCALL;
+
+    *pInfo = NVR_EXT_RT_GEOMETRY_INFO();
+
+    if (m_convert == nullptr)
+      return D3DERR_NOTAVAILABLE;
+
+    D3D9DeviceLock lock = m_device->LockDevice();
+
+    D3D9NvrRtJob job;
+    HRESULT hr = PrepareJob(pDesc, job, false);
+
+    if (FAILED(hr))
+      return hr;
+
+    pInfo->VertexCount   = job.vertexCount;
+    pInfo->TriangleCount = job.triangles;
+    pInfo->Texels        = 3u * (job.vertexCount + job.triangles);
+    return D3D_OK;
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9NvrRt::StageGeometry(
+    const NVR_EXT_RT_GEOMETRY_DESC*       pDesc,
+          ID3D9NvrExtSharedImage*         pArena,
+          UINT                            DstTexel,
+          NVR_EXT_RT_GEOMETRY_INFO*       pInfo) {
+    if (pInfo != nullptr)
+      *pInfo = NVR_EXT_RT_GEOMETRY_INFO();
+
+    if (m_convert == nullptr)
+      return D3DERR_NOTAVAILABLE;
+
+    if (pArena == nullptr)
+      return D3DERR_INVALIDCALL;
+
+    NVR_EXT_SHARED_IMAGE_INFO arena = { };
+    pArena->GetInfo(&arena);
+
+    if (arena.VkFormat != uint32_t(VK_FORMAT_R32_SFLOAT)) {
+      Logger::warn("NVR ext rt: StageGeometry: the arena must be an NVR_EXT_SHARED_R32F image");
+      return D3DERR_INVALIDCALL;
+    }
+
+    D3D9DeviceLock lock = m_device->LockDevice();
+
+    D3D9NvrRtJob job;
+    HRESULT hr = PrepareJob(pDesc, job, true);
+
+    if (FAILED(hr))
+      return hr;
+
+    const uint64_t texels = 3ull * (uint64_t(job.vertexCount) + job.triangles);
+    const uint64_t capacity = uint64_t(arena.Width) * arena.Height;
+
+    if (uint64_t(DstTexel) + texels > capacity) {
+      Logger::warn(str::format("NVR ext rt: StageGeometry: ", texels, " texels at ", DstTexel, " do not fit the arena (", capacity, ")"));
+      return D3DERR_INVALIDCALL;
+    }
+
+    // The staging copy of the arena (the conversion writes buffers by address; one copy into the image at the flush)
+    if (m_staging == nullptr || m_stagingBytes < capacity * 4u) {
+      if (!m_staged.empty())
+        FlushStagedGeometry(pArena);
+
+      m_staging = CreateRtBuffer(capacity * 4u, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_TRANSFER_SRC_BIT, "NVR rt arena staging");
+      m_stagingBytes = m_staging != nullptr ? capacity * 4u : 0u;
+
+      if (m_staging == nullptr)
+        return E_OUTOFMEMORY;
+    }
+
+    job.dst = m_staging;
+    job.dstPositions = VkDeviceSize(DstTexel) * 4u;
+    job.dstIndices = (VkDeviceSize(DstTexel) + 3u * job.vertexCount) * 4u;
+
+    m_stagedMin = std::min<uint32_t>(m_stagedMin, DstTexel);
+    m_stagedMax = std::max<uint32_t>(m_stagedMax, uint32_t(DstTexel + texels));
+
+    if (pInfo != nullptr) {
+      pInfo->VertexCount   = job.vertexCount;
+      pInfo->TriangleCount = job.triangles;
+      pInfo->Texels        = uint32_t(texels);
+    }
+
+    m_staged.push_back(std::move(job));
+    return D3D_OK;
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9NvrRt::FlushStagedGeometry(
+          ID3D9NvrExtSharedImage*         pArena) {
+    if (m_convert == nullptr)
+      return D3DERR_NOTAVAILABLE;
+
+    if (pArena == nullptr)
+      return D3DERR_INVALIDCALL;
+
+    D3D9DeviceLock lock = m_device->LockDevice();
+
+    if (m_staged.empty())
+      return D3D_OK;
+
+    Rc<DxvkImage> image = static_cast<D3D9NvrExtSharedImage*>(pArena)->GetImage();
+    const VkExtent3D size = image->info().extent;
+
+    const uint32_t rowFirst = m_stagedMin / size.width;
+    const uint32_t rowEnd = std::min<uint32_t>((m_stagedMax + size.width - 1u) / size.width, size.height);
+
+    m_device->EmitCs([
+      cJobs    = std::move(m_staged),
+      cConvert = m_convert,
+      cStaging = m_staging,
+      cImage   = std::move(image),
+      cRow     = rowFirst,
+      cRows    = rowEnd - rowFirst,
+      cWidth   = size.width
+    ] (DxvkContext* ctx) {
+      // Everything earlier (the game's uploads of these buffers, the last copy out of the staging) before the conversions
+      ctx->nvrBeginRawCommands();
+
+      RecordConversions(ctx, cConvert, cJobs);
+
+      // The conversions' writes before the copy reads them (DXVK does not see writes by address)
+      ctx->nvrBeginRawCommands();
+
+      VkImageSubresourceLayers layers = { VK_IMAGE_ASPECT_COLOR_BIT, 0u, 0u, 1u };
+      ctx->copyBufferToImage(cImage, layers, VkOffset3D { 0, int32_t(cRow), 0 }, VkExtent3D { cWidth, cRows, 1u },
+        cStaging, VkDeviceSize(cRow) * cWidth * 4u, 0u, 0u, cImage->info().format);
+
+      ctx->nvrTrackResource(cStaging, DxvkAccess::Write);
+    });
+
+    m_staged.clear();
+    m_stagedMin = ~0u;
+    m_stagedMax = 0u;
+    return D3D_OK;
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9NvrRt::CreateScene(
+          UINT                            MaxInstances,
+    const char*                           pDebugName,
+          ID3D9NvrExtRtScene**            ppScene) {
+    if (ppScene == nullptr)
+      return D3DERR_INVALIDCALL;
+
+    *ppScene = nullptr;
+
+    if (!m_supported)
+      return D3DERR_NOTAVAILABLE;
+
+    const char* name = pDebugName ? pDebugName : "(unnamed)";
+
+    if (MaxInstances == 0u || MaxInstances > m_maxInstances) {
+      Logger::warn(str::format("NVR ext rt: scene ", name, " refused: ", MaxInstances, " instances (1..", m_maxInstances, ")"));
+      return D3DERR_INVALIDCALL;
+    }
+
+    D3D9DeviceLock lock = m_device->LockDevice();
+
+    VkAccelerationStructureGeometryKHR geometry = { VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_GEOMETRY_KHR };
+    geometry.geometryType = VK_GEOMETRY_TYPE_INSTANCES_KHR;
+    geometry.geometry.instances.sType = VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_GEOMETRY_INSTANCES_DATA_KHR;
+    geometry.geometry.instances.arrayOfPointers = VK_FALSE;
+
+    VkAccelerationStructureBuildGeometryInfoKHR buildInfo = { VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_BUILD_GEOMETRY_INFO_KHR };
+    buildInfo.type = VK_ACCELERATION_STRUCTURE_TYPE_TOP_LEVEL_KHR;
+    buildInfo.flags = VK_BUILD_ACCELERATION_STRUCTURE_PREFER_FAST_BUILD_BIT_KHR;
+    buildInfo.mode = VK_BUILD_ACCELERATION_STRUCTURE_MODE_BUILD_KHR;
+    buildInfo.geometryCount = 1u;
+    buildInfo.pGeometries = &geometry;
+
+    Rc<vk::DeviceFn> vkd = m_device->GetDXVKDevice()->vkd();
+    uint32_t maxCount = MaxInstances;
+    VkAccelerationStructureBuildSizesInfoKHR sizes = { VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_BUILD_SIZES_INFO_KHR };
+    vkd->vkGetAccelerationStructureBuildSizesKHR(vkd->device(), VK_ACCELERATION_STRUCTURE_BUILD_TYPE_DEVICE_KHR,
+      &buildInfo, &maxCount, &sizes);
+
+    Rc<D3D9NvrRtAccel> tlas = CreateAccel(VK_ACCELERATION_STRUCTURE_TYPE_TOP_LEVEL_KHR, sizes.accelerationStructureSize, name);
+    Rc<DxvkBuffer> instances = CreateRtBuffer(VkDeviceSize(MaxInstances) * sizeof(VkAccelerationStructureInstanceKHR),
+      VK_BUFFER_USAGE_ACCELERATION_STRUCTURE_BUILD_INPUT_READ_ONLY_BIT_KHR | VK_BUFFER_USAGE_TRANSFER_DST_BIT, "NVR rt scene instances");
+    Rc<DxvkBuffer> scratch = CreateRtBuffer(sizes.buildScratchSize + m_scratchAlign, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT, "NVR rt scene scratch");
+
+    if (tlas == nullptr || instances == nullptr || scratch == nullptr)
+      return E_OUTOFMEMORY;
+
+    m_scenes++;
+    m_sceneBytes += tlas->size() + instances->info().size;
+
+    D3D9NvrRtScene* scene = new D3D9NvrRtScene(this, MaxInstances, std::move(tlas), std::move(instances), std::move(scratch), sizes.buildScratchSize);
+
+    // An empty build at once: the address is valid (every ray misses) before the first BuildScene
+    *ppScene = ref(scene);
+    BuildScene(scene, 0u, nullptr);
+
+    Logger::info(str::format("NVR ext rt: scene ", name, " created (", MaxInstances, " instances, ",
+      (sizes.accelerationStructureSize + 1023u) >> 10, " KiB structure, ", (sizes.buildScratchSize + 1023u) >> 10, " KiB scratch)"));
+    return D3D_OK;
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D9NvrRt::BuildScene(
+          ID3D9NvrExtRtScene*             pScene,
+          UINT                            Count,
+    const NVR_EXT_RT_INSTANCE*            pInstances) {
+    if (!m_supported)
+      return D3DERR_NOTAVAILABLE;
+
+    if (pScene == nullptr || (Count && pInstances == nullptr))
+      return D3DERR_INVALIDCALL;
+
+    D3D9NvrRtScene* scene = static_cast<D3D9NvrRtScene*>(pScene);
+
+    if (Count > scene->m_maxInstances) {
+      Logger::warn(str::format("NVR ext rt: BuildScene refused: ", Count, " instances, the scene holds ", scene->m_maxInstances));
+      return D3DERR_INVALIDCALL;
+    }
+
+    D3D9DeviceLock lock = m_device->LockDevice();
+
+    // Geometries made since the last scene build are built first (same block order on the CS thread)
+    FlushJobs();
+
+    std::vector<VkAccelerationStructureInstanceKHR> instances;
+    std::vector<Rc<D3D9NvrRtAccel>> referenced;
+    instances.reserve(Count);
+    referenced.reserve(Count);
+
+    for (uint32_t i = 0u; i < Count; i++) {
+      const NVR_EXT_RT_INSTANCE& src = pInstances[i];
+
+      if (src.pGeometry == nullptr)
+        continue;
+
+      const Rc<D3D9NvrRtAccel>& accel = static_cast<D3D9NvrRtGeometry*>(src.pGeometry)->GetAccel();
+
+      VkAccelerationStructureInstanceKHR dst = { };
+      std::memcpy(&dst.transform, src.Transform, sizeof(dst.transform));
+      dst.instanceCustomIndex = src.InstanceId & 0xFFFFFFu;
+      dst.mask = src.Mask & 0xFFu;
+      dst.instanceShaderBindingTableRecordOffset = 0u;
+      dst.flags = src.Flags & 0xFFu;
+      dst.accelerationStructureReference = accel->address();
+      instances.push_back(dst);
+
+      if (referenced.empty() || referenced.back().ptr() != accel.ptr())
+        referenced.push_back(accel);
+    }
+
+    std::sort(referenced.begin(), referenced.end(), [] (const Rc<D3D9NvrRtAccel>& a, const Rc<D3D9NvrRtAccel>& b) { return a.ptr() < b.ptr(); });
+    referenced.erase(std::unique(referenced.begin(), referenced.end(), [] (const Rc<D3D9NvrRtAccel>& a, const Rc<D3D9NvrRtAccel>& b) { return a.ptr() == b.ptr(); }), referenced.end());
+
+    m_lastInstances = uint32_t(instances.size());
+    m_sceneBuilds++;
+
+    m_device->EmitCs([
+      cInstances  = std::move(instances),
+      cReferenced = std::move(referenced),
+      cState      = scene->m_state,
+      cTlas       = scene->m_tlas,
+      cBuffer     = scene->m_instances,
+      cScratch    = scene->m_scratch,
+      cAlign      = m_scratchAlign,
+      cVkd        = m_device->GetDXVKDevice()->vkd()
+    ] (DxvkContext* ctx) mutable {
+      VkCommandBuffer cmd = ctx->nvrBeginRawCommands();
+
+      DxvkResourceBufferInfo buffer = cBuffer->getSliceInfo();
+      const VkDeviceSize bytes = VkDeviceSize(cInstances.size()) * sizeof(VkAccelerationStructureInstanceKHR);
+      const char* data = reinterpret_cast<const char*>(cInstances.data());
+
+      for (VkDeviceSize done = 0u; done < bytes; ) {
+        VkDeviceSize chunk = std::min<VkDeviceSize>(bytes - done, 65536u);
+        cVkd->vkCmdUpdateBuffer(cmd, buffer.buffer, buffer.offset + done, chunk, data + done);
+        done += chunk;
+      }
+
+      // The upload before the build reads the instances
+      ctx->nvrFullBarrier(cmd);
+
+      VkAccelerationStructureGeometryKHR geometry = { VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_GEOMETRY_KHR };
+      geometry.geometryType = VK_GEOMETRY_TYPE_INSTANCES_KHR;
+      geometry.geometry.instances.sType = VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_GEOMETRY_INSTANCES_DATA_KHR;
+      geometry.geometry.instances.arrayOfPointers = VK_FALSE;
+      geometry.geometry.instances.data.deviceAddress = buffer.gpuAddress;
+
+      VkAccelerationStructureBuildGeometryInfoKHR info = { VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_BUILD_GEOMETRY_INFO_KHR };
+      info.type = VK_ACCELERATION_STRUCTURE_TYPE_TOP_LEVEL_KHR;
+      info.flags = VK_BUILD_ACCELERATION_STRUCTURE_PREFER_FAST_BUILD_BIT_KHR;
+      info.mode = VK_BUILD_ACCELERATION_STRUCTURE_MODE_BUILD_KHR;
+      info.dstAccelerationStructure = cTlas->handle();
+      info.geometryCount = 1u;
+      info.pGeometries = &geometry;
+      info.scratchData.deviceAddress = AlignUp(cScratch->getSliceInfo().gpuAddress, cAlign);
+
+      VkAccelerationStructureBuildRangeInfoKHR range = { uint32_t(cInstances.size()), 0u, 0u, 0u };
+      const VkAccelerationStructureBuildRangeInfoKHR* rangePointer = &range;
+      cVkd->vkCmdBuildAccelerationStructuresKHR(cmd, 1u, &info, &rangePointer);
+
+      ctx->nvrEndRawCommands(cmd);
+
+      // Keep this build's structures, and the last build's once more (passes of earlier command lists may
+      // still trace them), until this command list is done; the scene keeps this build's until the next one
+      ctx->nvrTrack(cTlas);
+      ctx->nvrTrackResource(cBuffer, DxvkAccess::Write);
+      ctx->nvrTrackResource(cScratch, DxvkAccess::Write);
+
+      for (const auto& accel : cReferenced)
+        ctx->nvrTrack(accel);
+      for (const auto& accel : cState->referenced)
+        ctx->nvrTrack(accel);
+
+      cState->referenced = std::move(cReferenced);
+    });
+
+    return D3D_OK;
+  }
+
+
+  void STDMETHODCALLTYPE D3D9NvrRt::GetRtStats(NVR_EXT_RT_STATS* pStats) {
+    if (pStats == nullptr)
+      return;
+
+    *pStats = NVR_EXT_RT_STATS();
+    pStats->Geometries      = m_geometries.load();
+    pStats->Triangles       = m_triangles.load();
+    pStats->GeometryBytes   = m_geometryBytes.load();
+    pStats->GeometriesBuilt = m_geometriesBuilt.load();
+    pStats->Scenes          = m_scenes.load();
+    pStats->LastInstances   = m_lastInstances.load();
+    pStats->SceneBuilds     = m_sceneBuilds.load();
+    pStats->SceneBytes      = m_sceneBytes.load();
+  }
+
+
+  void D3D9NvrRt::OnGeometryGone(uint32_t triangles, VkDeviceSize bytes) {
+    m_geometries--;
+    m_triangles -= triangles;
+    m_geometryBytes -= bytes;
+  }
+
+
+  void D3D9NvrRt::OnSceneGone(VkDeviceSize bytes, const Rc<D3D9NvrRtSceneState>& state, const Rc<D3D9NvrRtAccel>& tlas) {
+    m_scenes--;
+    m_sceneBytes -= bytes;
+
+    // Passes recorded before this may still trace the scene: keep it and what it refers to until the
+    // command list being recorded now is done
+    D3D9DeviceLock lock = m_device->LockDevice();
+
+    m_device->EmitCs([
+      cState = state,
+      cTlas  = tlas
+    ] (DxvkContext* ctx) {
+      ctx->nvrTrack(cTlas);
+
+      for (const auto& accel : cState->referenced)
+        ctx->nvrTrack(accel);
+    });
+  }
+
+}
diff --git a/src/d3d9/d3d9_nvr_rt.h b/src/d3d9/d3d9_nvr_rt.h
new file mode 100644
index 0000000..e7ba508
--- /dev/null
+++ b/src/d3d9/d3d9_nvr_rt.h
@@ -0,0 +1,234 @@
+#pragma once
+
+/*
+ * NVR extension, ray tracing core ("1.8-rt", fork patch 0028): the implementation of ID3D9NvrExtRt
+ * (d3d9_nvr_ext_api.h). Acceleration structures from the game's D3D9 vertex/index buffers and scenes of
+ * them; NVR's passes trace rays against a scene through its GPU address (GL_EXT_ray_query).
+ *
+ * Recording: CreateGeometry queues a job (its own input and structure memory are made at once, on the
+ * caller's thread); the queue is recorded by the next BuildScene (or when it grows large) as ONE block on the
+ * CS thread: a full barrier, the conversion dispatches (d3d9_nvr_rt_convert.comp: the game's positions and
+ * indices by device address into the job's input buffer), a full barrier, every build in one
+ * vkCmdBuildAccelerationStructuresKHR, a full barrier. BuildScene then uploads the instances (vkCmdUpdateBuffer)
+ * and rebuilds the top level between full barriers. DXVK's hazard tracking never sees these accesses, hence
+ * the full barriers (DxvkContext::nvrBeginRawCommands); a frame with no new geometry costs two of them.
+ *
+ * Lifetimes: a structure is an RcObject (D3D9NvrRtAccel) that destroys its Vulkan handle when the last
+ * reference goes. Command lists track (keep) every structure their builds write or their scenes refer to;
+ * each scene keeps the structures of its last build until the next one, and that next build's command list
+ * tracks them once more, so a pass recorded after a build (in any later command list) never sees a freed one.
+ */
+
+#include "d3d9_nvr_ext_api.h"
+#include "d3d9_include.h"
+
+#include "../dxvk/dxvk_buffer.h"
+#include "../dxvk/dxvk_shader.h"
+
+#include <atomic>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace dxvk {
+
+  class D3D9DeviceEx;
+  class D3D9CommonBuffer;
+  class DxvkContext;
+
+  /** One acceleration structure and its memory. Destroyed (Vulkan handle) with its last reference. */
+  class D3D9NvrRtAccel : public RcObject {
+
+  public:
+
+    D3D9NvrRtAccel(Rc<vk::DeviceFn> vkd, VkAccelerationStructureKHR handle, Rc<DxvkBuffer> storage, uint64_t address)
+    : m_vkd(std::move(vkd)), m_handle(handle), m_storage(std::move(storage)), m_address(address) { }
+
+    ~D3D9NvrRtAccel();
+
+    VkAccelerationStructureKHR handle() const { return m_handle; }
+
+    uint64_t address() const { return m_address; }
+
+    VkDeviceSize size() const { return m_storage->info().size; }
+
+  private:
+
+    Rc<vk::DeviceFn>            m_vkd;
+    VkAccelerationStructureKHR  m_handle;
+    Rc<DxvkBuffer>              m_storage;
+    uint64_t                    m_address;
+
+  };
+
+  class D3D9NvrRt;
+
+  class D3D9NvrRtGeometry final : public ComObject<ID3D9NvrExtRtGeometry> {
+
+  public:
+
+    D3D9NvrRtGeometry(D3D9NvrRt* pRt, Rc<D3D9NvrRtAccel> accel, uint32_t triangles)
+    : m_rt(pRt), m_accel(std::move(accel)), m_triangles(triangles) { }
+
+    ~D3D9NvrRtGeometry();
+
+    HRESULT STDMETHODCALLTYPE QueryInterface(REFIID riid, void** ppvObject);
+
+    UINT STDMETHODCALLTYPE GetTriangleCount() { return m_triangles; }
+
+    const Rc<D3D9NvrRtAccel>& GetAccel() const { return m_accel; }
+
+  private:
+
+    D3D9NvrRt*          m_rt;
+    Rc<D3D9NvrRtAccel>  m_accel;
+    uint32_t            m_triangles;
+
+  };
+
+  /** What a scene's builds share on the CS thread: the structures of its last build (kept until the next one). */
+  struct D3D9NvrRtSceneState : public RcObject {
+    std::vector<Rc<D3D9NvrRtAccel>> referenced;
+  };
+
+  class D3D9NvrRtScene final : public ComObject<ID3D9NvrExtRtScene> {
+
+  public:
+
+    D3D9NvrRtScene(D3D9NvrRt* pRt, uint32_t maxInstances, Rc<D3D9NvrRtAccel> tlas,
+      Rc<DxvkBuffer> instances, Rc<DxvkBuffer> scratch, VkDeviceSize scratchSize)
+    : m_rt(pRt), m_maxInstances(maxInstances), m_tlas(std::move(tlas)), m_instances(std::move(instances)),
+      m_scratch(std::move(scratch)), m_scratchSize(scratchSize), m_state(new D3D9NvrRtSceneState()) { }
+
+    ~D3D9NvrRtScene();
+
+    HRESULT STDMETHODCALLTYPE QueryInterface(REFIID riid, void** ppvObject);
+
+    UINT64 STDMETHODCALLTYPE GetAddress() { return m_tlas->address(); }
+
+    UINT STDMETHODCALLTYPE GetMaxInstances() { return m_maxInstances; }
+
+    D3D9NvrRt*                  m_rt;
+    uint32_t                    m_maxInstances;
+    Rc<D3D9NvrRtAccel>          m_tlas;
+    Rc<DxvkBuffer>              m_instances;
+    Rc<DxvkBuffer>              m_scratch;
+    VkDeviceSize                m_scratchSize;
+    Rc<D3D9NvrRtSceneState>     m_state;
+
+  };
+
+  /** One geometry's conversion (and, in-process, its bottom-level build). */
+  struct D3D9NvrRtJob {
+    struct Range { uint32_t mode, triangles, start, dstOffset; int32_t baseVertex; };
+    Rc<DxvkBuffer>          vertexBuffer;   // the game's
+    Rc<DxvkBuffer>          indexBuffer;    // the game's (null: non-indexed)
+    uint32_t                positionOffset = 0u, stride = 0u, vertexCount = 0u, indexSize = 0u;
+    bool                    half = false;
+    std::vector<Range>      ranges;
+    uint32_t                triangles = 0u;
+    Rc<DxvkBuffer>          dst;            // where the conversion writes: float3 positions at dstPositions, the uint list at dstIndices
+    VkDeviceSize            dstPositions = 0u;
+    VkDeviceSize            dstIndices = 0u;
+    VkDeviceSize            scratchSize = 0u;   // in-process build only
+    Rc<D3D9NvrRtAccel>      accel;              // in-process build only
+  };
+
+  class D3D9NvrRt final : public ID3D9NvrExtRt {
+
+  public:
+
+    explicit D3D9NvrRt(D3D9DeviceEx* pDevice);
+
+    ~D3D9NvrRt();
+
+    ULONG STDMETHODCALLTYPE AddRef();
+
+    ULONG STDMETHODCALLTYPE Release();
+
+    HRESULT STDMETHODCALLTYPE QueryInterface(REFIID riid, void** ppvObject);
+
+    void STDMETHODCALLTYPE GetRtInfo(
+            NVR_EXT_RT_INFO*                pInfo);
+
+    HRESULT STDMETHODCALLTYPE CreateGeometry(
+      const NVR_EXT_RT_GEOMETRY_DESC*       pDesc,
+            ID3D9NvrExtRtGeometry**         ppGeometry);
+
+    HRESULT STDMETHODCALLTYPE CreateScene(
+            UINT                            MaxInstances,
+      const char*                           pDebugName,
+            ID3D9NvrExtRtScene**            ppScene);
+
+    HRESULT STDMETHODCALLTYPE BuildScene(
+            ID3D9NvrExtRtScene*             pScene,
+            UINT                            Count,
+      const NVR_EXT_RT_INSTANCE*            pInstances);
+
+    void STDMETHODCALLTYPE GetRtStats(
+            NVR_EXT_RT_STATS*               pStats);
+
+    HRESULT STDMETHODCALLTYPE MeasureGeometry(
+      const NVR_EXT_RT_GEOMETRY_DESC*       pDesc,
+            NVR_EXT_RT_GEOMETRY_INFO*       pInfo);
+
+    HRESULT STDMETHODCALLTYPE StageGeometry(
+      const NVR_EXT_RT_GEOMETRY_DESC*       pDesc,
+            ID3D9NvrExtSharedImage*         pArena,
+            UINT                            DstTexel,
+            NVR_EXT_RT_GEOMETRY_INFO*       pInfo);
+
+    HRESULT STDMETHODCALLTYPE FlushStagedGeometry(
+            ID3D9NvrExtSharedImage*         pArena);
+
+    /** Object bookkeeping (stats) */
+    void OnGeometryGone(uint32_t triangles, VkDeviceSize bytes);
+    void OnSceneGone(VkDeviceSize bytes, const Rc<D3D9NvrRtSceneState>& state, const Rc<D3D9NvrRtAccel>& tlas);
+
+  private:
+
+    D3D9DeviceEx*     m_device;
+    bool              m_supported = false;   // in-process acceleration structures (CreateGeometry ... BuildScene)
+    std::string       m_reason;
+    VkDeviceSize      m_scratchAlign = 256u;
+    uint32_t          m_maxInstances = 0u;
+    uint64_t          m_maxPrimitives = 0u;
+    Rc<DxvkShader>    m_convert;
+
+    std::vector<D3D9NvrRtJob> m_pending;
+    uint64_t                  m_pendingTriangles = 0u;
+
+    // Helper geometry (StageGeometry): the conversions queued for the arena, into a staging copy of it
+    std::vector<D3D9NvrRtJob> m_staged;
+    Rc<DxvkBuffer>            m_staging;
+    VkDeviceSize              m_stagingBytes = 0u;
+    uint32_t                  m_stagedMin = ~0u;    // texels touched since the last flush
+    uint32_t                  m_stagedMax = 0u;
+
+    std::atomic<uint32_t>  m_geometries = { 0u };
+    std::atomic<uint64_t>  m_triangles = { 0u };
+    std::atomic<uint64_t>  m_geometryBytes = { 0u };
+    std::atomic<uint64_t>  m_geometriesBuilt = { 0u };
+    std::atomic<uint32_t>  m_scenes = { 0u };
+    std::atomic<uint32_t>  m_lastInstances = { 0u };
+    std::atomic<uint64_t>  m_sceneBuilds = { 0u };
+    std::atomic<uint64_t>  m_sceneBytes = { 0u };
+
+    /** Records the queued bottom-level builds (one block). Device lock held. */
+    void FlushJobs();
+
+    /** Validates a description and fills a job (no memory, nothing recorded). Device lock held when Upload. */
+    HRESULT PrepareJob(const NVR_EXT_RT_GEOMETRY_DESC* pDesc, D3D9NvrRtJob& job, bool Upload);
+
+    /** CS thread: the conversion dispatches of jobs into their dst (the caller puts the barriers around them). */
+    static void RecordConversions(DxvkContext* ctx, const Rc<DxvkShader>& convert, const std::vector<D3D9NvrRtJob>& jobs);
+
+    Rc<DxvkBuffer> CreateRtBuffer(VkDeviceSize size, VkBufferUsageFlags usage, const char* name);
+
+    Rc<D3D9NvrRtAccel> CreateAccel(VkAccelerationStructureTypeKHR type, VkDeviceSize size, const char* name);
+

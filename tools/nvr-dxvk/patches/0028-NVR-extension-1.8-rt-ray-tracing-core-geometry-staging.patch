+    /**
+     * \brief NVR ray tracing core (fork patch 0028): raw commands in the exec buffer
+     *
+     * Acceleration structure builds have no DXVK context call. This ends the current
+     * render pass, flushes the barriers DXVK has queued and puts a global memory barrier
+     * (everything before -> everything after), then hands out the exec command buffer;
+     * \ref nvrEndRawCommands puts the same barrier after the raw commands. DXVK's own
+     * hazard tracking never sees what the raw commands read or write, so the two full
+     * barriers order them against all D3D9 work on either side. Objects the raw commands
+     * use must be kept alive with \ref nvrTrack.
+     */
+    VkCommandBuffer nvrBeginRawCommands() {
+      this->endCurrentPass(true);
+      this->flushBarriers();
+      VkCommandBuffer cmd = m_cmd->nvrExecBuffer();
+      nvrFullBarrier(cmd);
+      return cmd;
+    }
+
+    void nvrEndRawCommands(VkCommandBuffer cmd) {
+      nvrFullBarrier(cmd);
+    }
+
+    void nvrFullBarrier(VkCommandBuffer cmd);
+
+    template<typename T>
+    void nvrTrack(Rc<T> object) {
+      m_cmd->track(std::move(object));
+    }
+
+    template<typename T>

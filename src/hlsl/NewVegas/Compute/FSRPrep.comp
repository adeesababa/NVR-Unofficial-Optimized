#version 450
// FSR 2 inputs NVR builds itself (needs NVR DXVK; effects/TAA.cpp FSR path). One thread per render pixel:
//  o_motion:  camera motion vector in uv units, from this pixel to where its surface was last frame (FSR 2's convention:
//             previous uv - current uv, unjittered). Same reprojection as TAA's (TAA.glsl Reproject): the depth buffer gives the
//             surface's offset from the camera, last frame's camera rotation and the camera's move give last frame's screen
//             position. Camera motion only: skinned characters, doors and other moving objects get the motion of the camera
//             (FSR's depth clip and locks then decide; their own motion would need the game's per-object transforms).
//             The first-person weapon is fixed to the camera: motion 0.
//  o_depth:   r = a device-style depth FSR 2 can read with its standard (not inverted, finite) depth formula:
//             d = far / (far - near) * (1 - near / z), z = linear depth * far; 1 at the far plane. 0 on weapon pixels.
//             g = reactive mask: 1 on weapon pixels (NVR puts the weapon back as rendered after FSR), else 0.
#extension GL_GOOGLE_include_directive : require
#include "Common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 1, binding = 0) uniform texture2D t_depth;       // TESR_DepthBuffer (linear depth / far)
layout(set = 1, binding = 1) uniform texture2D t_viewmodel;   // TESR_DepthBufferViewModel (> 0 on the weapon)
layout(set = 1, binding = 2, rg16f) writeonly uniform image2D o_motion;
layout(set = 1, binding = 3, rg32f) writeonly uniform image2D o_depth;
layout(set = 1, binding = 4) uniform texture2D t_objmotion;   // UNOFFICIAL 2026-10-29 TESR_ObjectMotionBuffer (world move since last frame; a placeholder while cameraDelta.w is 0)

layout(set = 2, binding = 0, std140) uniform Constants {
    mat4 projectionTransform;   // TESR_ProjectionTransform (unjittered)
    mat4 viewTransform;         // TESR_ViewTransform
    mat4 prevViewTransform;     // last frame's viewMatrix
    vec4 cameraData;            // TESR_CameraData: x near, y far
    vec4 prevProjection;        // x, y: last frame's projMatrix._11, _22
    vec4 cameraDelta;           // xyz: camera position this frame minus last frame's
    vec4 size;                  // xy render size, z: 1 = no history (motion 0), w: reactive value on weapon pixels
} cb;

layout(push_constant) uniform Push {
    uint pointIndex;            // 0: POINT, CLAMP (the extension writes the heap index)
} pc;

#define POINT_S NVR_SAMPLER(pc.pointIndex)
#define nearZ cb.cameraData.x
#define farZ cb.cameraData.y

vec3 toWorld(vec2 tex) {
    vec3 v = vec3(cb.viewTransform[0][2], cb.viewTransform[1][2], cb.viewTransform[2][2]);
    v += (1.0 / cb.projectionTransform[0][0] * (2.0 * tex.x - 1.0)) * vec3(cb.viewTransform[0][0], cb.viewTransform[1][0], cb.viewTransform[2][0]);
    v += (-1.0 / cb.projectionTransform[1][1] * (2.0 * tex.y - 1.0)) * vec3(cb.viewTransform[0][1], cb.viewTransform[1][1], cb.viewTransform[2][1]);
    return v;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, ivec2(cb.size.xy)))) return;
    vec2 uv = (vec2(pixel) + 0.5) / cb.size.xy;

    float linear01 = texelFetch(sampler2D(t_depth, POINT_S), pixel, 0).x;
    bool weapon = texelFetch(sampler2D(t_viewmodel, POINT_S), pixel, 0).x > 0.0;

    // TAA.glsl Reproject, line for line.
    vec3 cameraVector = toWorld(uv) * (linear01 * farZ);
    // UNOFFICIAL 2026-10-29 ObjectMotion: things that moved themselves get their own motion (was: the camera's only).
    if (cb.cameraDelta.w > 0.0) cameraVector -= texelFetch(sampler2D(t_objmotion, POINT_S), pixel, 0).xyz;
    vec3 fromPrevCamera = cameraVector + cb.cameraDelta.xyz;
    vec3 prevRight   = vec3(cb.prevViewTransform[0][0], cb.prevViewTransform[1][0], cb.prevViewTransform[2][0]);
    vec3 prevUp      = vec3(cb.prevViewTransform[0][1], cb.prevViewTransform[1][1], cb.prevViewTransform[2][1]);
    vec3 prevForward = vec3(cb.prevViewTransform[0][2], cb.prevViewTransform[1][2], cb.prevViewTransform[2][2]);
    float viewZ = dot(fromPrevCamera, prevForward);
    vec2 ndc = vec2(dot(fromPrevCamera, prevRight) * cb.prevProjection.x,
                    dot(fromPrevCamera, prevUp) * cb.prevProjection.y) / max(viewZ, 1e-4);
    vec2 prevUV = vec2(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5);

    vec2 motion = prevUV - uv;
    if (weapon || cb.size.z > 0.5 || viewZ <= 0.0) motion = vec2(0.0);   // behind last frame's camera: no usable motion

    float z = max(linear01 * farZ, nearZ);
    float device = clamp(farZ / (farZ - nearZ) * (1.0 - nearZ / z), 0.0, 1.0);

    imageStore(o_motion, pixel, vec4(motion, 0.0, 0.0));
    imageStore(o_depth, pixel, vec4(weapon ? 0.0 : device, weapon ? cb.size.w : 0.0, 0.0, 0.0));
}

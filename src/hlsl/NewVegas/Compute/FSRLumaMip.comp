#version 450
// FSR 2's shading-change luma for NVR DXVK (effects/TAA.cpp FSR path): what AMD's luminance pyramid (SPD) stores in its mip 4,
// the average log luma of each 32x32 block of the frame (log(max(1e-3, luma)); pixels past the frame's edge count as 0, as in
// AMD's SpdLoadSourceImage). One 16x16 workgroup per output texel, each thread four pixels. The rest of the pyramid (auto
// exposure) is not needed: NVR feeds FSR the tonemapped frame with exposure 1.
#extension GL_GOOGLE_include_directive : require
#include "Common.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 1, binding = 0) uniform texture2D t_color;      // the frame FSR reads
layout(set = 1, binding = 1, r16f) writeonly uniform image2D o_luma;

layout(push_constant) uniform Push {
    uint pointIndex;            // 0: POINT, CLAMP (the extension writes the heap index)
    uint pad;
    ivec2 renderSize;           // 8
} pc;

#define POINT_S NVR_SAMPLER(pc.pointIndex)

shared float partial[256];

float logLuma(ivec2 p) {
    if (any(greaterThanEqual(p, pc.renderSize))) return 0.0;
    vec3 c = texelFetch(sampler2D(t_color, POINT_S), p, 0).rgb;
    return log(max(1e-3, dot(c, vec3(0.2126, 0.7152, 0.0722))));
}

void main() {
    ivec2 base = ivec2(gl_WorkGroupID.xy) * 32 + ivec2(gl_LocalInvocationID.xy) * 2;
    float sum = logLuma(base) + logLuma(base + ivec2(1, 0)) + logLuma(base + ivec2(0, 1)) + logLuma(base + ivec2(1, 1));
    uint index = gl_LocalInvocationIndex;
    partial[index] = sum;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1) {
        if (index < stride) partial[index] += partial[index + stride];
        barrier();
    }
    if (index == 0u) imageStore(o_luma, ivec2(gl_WorkGroupID.xy), vec4(partial[0] / 1024.0, 0.0, 0.0, 0.0));
}

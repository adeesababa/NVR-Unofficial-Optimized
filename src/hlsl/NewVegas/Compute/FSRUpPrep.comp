#version 450
// FSR 2 inputs for RenderScale (needs NVR DXVK; effects/TAAUpscale.cpp): FSRPrep.comp for the world scene drawn at a lower
// internal resolution, right after it was drawn (before the first-person weapon and before any NVR effect: CombineDepth has not
// run yet). One thread per render pixel, the render picture in the top-left cb.size.xy of every texture.
//  o_motion:  camera motion vector in uv units of the render picture, from this pixel to where its surface was last frame (FSR 2's
//             convention: previous uv - current uv, unjittered). TAA.glsl Reproject, line for line, as FSRPrep.comp. Camera motion
//             only (skinned characters, doors and other moving objects get the camera's; FSR's depth clip and locks then decide).
//  o_depth:   r = a device-style depth FSR 2 reads with its standard (not inverted, finite) formula:
//             d = far / (far - near) * (1 - near / z); 1 at the far plane. g = reactive mask: 0 (the weapon is not drawn yet; it is
//             drawn after the upscale at full resolution).
// The world depth is the game's INTZ depth buffer (TESR_DepthBufferWorld), read as CombineDepth.frag reads it (toVS).
#extension GL_GOOGLE_include_directive : require
#include "Common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 1, binding = 0) uniform texture2D t_worldDepth;  // TESR_DepthBufferWorld (INTZ, this frame's world)
layout(set = 1, binding = 2, rg16f) writeonly uniform image2D o_motion;
layout(set = 1, binding = 3, rg32f) writeonly uniform image2D o_depth;

layout(set = 2, binding = 0, std140) uniform Constants {
    mat4 projectionTransform;   // TESR_ProjectionTransform (unjittered)
    mat4 viewTransform;         // TESR_ViewTransform
    mat4 prevViewTransform;     // last upscaled frame's viewMatrix
    vec4 cameraData;            // TESR_CameraData: x near, y far
    vec4 prevProjection;        // x, y: last upscaled frame's projMatrix._11, _22
    vec4 cameraDelta;           // xyz: camera position this frame minus last upscaled frame's
    vec4 size;                  // xy render size, z: 1 = no history (motion 0)
} cb;

layout(push_constant) uniform Push {
    uint pointIndex;            // 0: POINT, CLAMP (the extension writes the heap index)
} pc;

#define POINT_S NVR_SAMPLER(pc.pointIndex)
#define nearZ cb.cameraData.x
#define farZ cb.cameraData.y

// CombineDepth.frag toVS: the game's depth buffer to view space z.
float toVS(float depth) {
    return nearZ * farZ / (nearZ + depth * (farZ - nearZ));
}

vec3 toWorld(vec2 tex) {
    vec3 v = vec3(cb.viewTransform[0][2], cb.viewTransform[1][2], cb.viewTransform[2][2]);
    v += (1.0 / cb.projectionTransform[0][0] * (2.0 * tex.x - 1.0)) * vec3(cb.viewTransform[0][0], cb.viewTransform[1][0], cb.viewTransform[2][0]);
    v += (-1.0 / cb.projectionTransform[1][1] * (2.0 * tex.y - 1.0)) * vec3(cb.viewTransform[0][1], cb.viewTransform[1][1], cb.viewTransform[2][1]);
    return v;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, ivec2(cb.size.xy)))) return;
    vec2 uv = (vec2(pixel) + 0.5) / cb.size.xy;

    float viewZ0 = toVS(texelFetch(sampler2D(t_worldDepth, POINT_S), pixel, 0).x);
    float linear01 = viewZ0 / farZ;

    // TAA.glsl Reproject, line for line (as FSRPrep.comp).
    vec3 cameraVector = toWorld(uv) * (linear01 * farZ);
    vec3 fromPrevCamera = cameraVector + cb.cameraDelta.xyz;
    vec3 prevRight   = vec3(cb.prevViewTransform[0][0], cb.prevViewTransform[1][0], cb.prevViewTransform[2][0]);
    vec3 prevUp      = vec3(cb.prevViewTransform[0][1], cb.prevViewTransform[1][1], cb.prevViewTransform[2][1]);
    vec3 prevForward = vec3(cb.prevViewTransform[0][2], cb.prevViewTransform[1][2], cb.prevViewTransform[2][2]);
    float viewZ = dot(fromPrevCamera, prevForward);
    vec2 ndc = vec2(dot(fromPrevCamera, prevRight) * cb.prevProjection.x,
                    dot(fromPrevCamera, prevUp) * cb.prevProjection.y) / max(viewZ, 1e-4);
    vec2 prevUV = vec2(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5);

    vec2 motion = prevUV - uv;
    if (cb.size.z > 0.5 || viewZ <= 0.0) motion = vec2(0.0);   // no history / behind last frame's camera: no usable motion

    float z = max(linear01 * farZ, nearZ);
    float device = clamp(farZ / (farZ - nearZ) * (1.0 - nearZ / z), 0.0, 1.0);

    imageStore(o_motion, pixel, vec4(motion, 0.0, 0.0));
    imageStore(o_depth, pixel, vec4(device, 0.0, 0.0, 0.0));
}

// BloodFluid (BloodFlow v2, needs NVR DXVK): the blood's particle simulation, as compute work.
// One shader, five modes (the push block's `mode`); src/effects/BloodFluid.cpp records them each frame in this order:
//   4 rebase    the anchor moved: every particle moves with it (rare)
//   0 emit      new blood from this frame's emitters (a splat thrown at a wall, a body bleeding, the test throw)
//   per fixed step of 1/120 s:  ClearBuffer(grid), 1 splat, 2 integrate
//   ClearBuffer(tile counts), 3 tiles
// then BloodFluidDraw.frag paints what the tiles list.
//
//  - splat: each moving particle adds its weight and momentum to the 8 grid nodes round it (trilinear "cloud in cell"),
//    in a hashed grid, with integer atomics: the sums are exact whatever order the threads run in, so the same start
//    gives the same blood (two shots of the same moment look alike).
//  - integrate: gravity; the grid's density pushes particles apart above the rest density and pulls them together
//    below it (pressure, cohesion), and its mean velocity drags them along (viscosity); then collision with the depth
//    buffer (the surface and its normal rebuilt from depth): no bounce, a hard hit spreads sideways, film friction that
//    differs a little per particle (a sheet breaks into runs), cling within a short range (blood under an overhang
//    gathers and drips). As it settles: more friction, then still. Off screen or hidden behind something, blood lying on
//    a surface is held where it is until it can be seen (the depth buffer says nothing there); blood in the air keeps
//    falling, down to its fallback ground height (pools under a body spread on it even where the body hides the floor).
//  - tiles: each particle on screen goes into the list of every 16 x 16 pixel tile its circle touches.
//
// Build: glslangValidator -V --target-env vulkan1.1 -o BloodFluidSim.spv BloodFluidSim.comp

#version 450
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_samplerless_texture_functions : enable
#extension GL_EXT_nonuniform_qualifier : enable

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "BloodFluid.glsl"

layout(set = 1, binding = 0, std430) buffer Particles { Particle P[]; };
layout(set = 1, binding = 1, std430) buffer Grid { ivec4 G[]; };            // x: weight x WeightScale, yzw: momentum x MomentumScale
struct Emitter {
    vec4  origin;   // xyz (anchor space): thrown blood: where it hits; a pool: its centre on the ground; w: fallback ground z
    vec4  dir;      // xyz: the way it is thrown (unit); w: speed (units/s)
    vec4  shape;    // x: spread radius, y: cone, z: back-off before the hit (thrown: starts this far before the surface), w: birth window (s)
    uvec4 data;     // x: first slot, y: count, z: seed, w: colour (0xRRGGBB) | kind << 24
};
layout(set = 1, binding = 2, std430) readonly buffer Emitters { Emitter E[]; };
layout(set = 1, binding = 3, std430) buffer Draws { DrawRec D[]; };
layout(set = 1, binding = 4, std430) buffer TileCounts { uint TileCount[]; };
layout(set = 1, binding = 5, std430) buffer TileLists { uint TileList[]; };
layout(set = 1, binding = 6) uniform texture2D t_depth;      // TESR_DepthBuffer (CombineDepth): view depth / farZ
layout(set = 1, binding = 7) uniform texture2D t_viewModel;  // TESR_DepthBufferViewModel
layout(set = 0, binding = 0) uniform sampler s_samplers[];   // DXVK's sampler heap (POINT / CLAMP at pc.samplerIndex)

layout(push_constant) uniform Push {
    uint  mode;      // 0 emit, 1 splat, 2 integrate, 3 tiles, 4 rebase
    uint  total;     // emit: particles to spawn this frame; else unused
    uint  samplerIndex;  // POINT / CLAMP (low 16 bits)
    uint  pad1;
    vec4  shift;     // rebase: xyz added to every position
} pc;

const float WeightScale = 4096.0;
const float MomentumScale = 16.0;

uint CellIndex(ivec3 c) {
    return ((uint(c.x) * 73856093u) ^ (uint(c.y) * 19349663u) ^ (uint(c.z) * 83492791u)) & F.counts2.y;
}

// ---------------------------------------------------------------- depth buffer
// (Read through a sampler at the texel centre, as every working NVR pass reads it; 2026-10-26 in game: texelFetch on this
// texture gave 1.0 everywhere.)
float RawDepthAt(ivec2 px) { return textureLod(sampler2D(t_depth, s_samplers[pc.samplerIndex & 0xFFFFu]), (vec2(px) + 0.5) * F.screen.zw, 0.0).x; }
float ViewModelAt(ivec2 px) { return textureLod(sampler2D(t_viewModel, s_samplers[pc.samplerIndex & 0xFFFFu]), (vec2(px) + 0.5) * F.screen.zw, 0.0).x; }
float SceneDepthAt(ivec2 px) { return RawDepthAt(px) * F.eyeRel.w; }

// The surface point (eye-relative) at pixel px of depth z, and its normal from the neighbours on the side with the
// smaller step each way (as the spike: edges do not bend it), facing the camera.
vec3 SurfaceAt(ivec2 px, float z) { return RayAt(vec2(px) + 0.5) * z; }
vec3 NormalAt(ivec2 px, float z) {
    ivec2 lim = ivec2(F.screen.xy) - 1;
    vec3 c = SurfaceAt(px, z);
    ivec2 pr = min(px + ivec2(1, 0), lim), pl = max(px - ivec2(1, 0), ivec2(0)), pd = min(px + ivec2(0, 1), lim), pu = max(px - ivec2(0, 1), ivec2(0));
    float zr = SceneDepthAt(pr), zl = SceneDepthAt(pl), zd = SceneDepthAt(pd), zu = SceneDepthAt(pu);
    vec3 dx = abs(zr - z) < abs(z - zl) ? SurfaceAt(pr, zr) - c : c - SurfaceAt(pl, zl);
    vec3 dy = abs(zd - z) < abs(z - zu) ? SurfaceAt(pd, zd) - c : c - SurfaceAt(pu, zu);
    vec3 n = cross(dy, dx);
    float l = length(n);
    n = l > 1e-8 ? n / l : -normalize(c);
    return dot(n, -c) < 0.0 ? -n : n;
}

// ---------------------------------------------------------------- grid (trilinear nodes)
void Splat(vec3 p, vec3 v) {
    vec3 g = p * F.gridf.y;
    vec3 b = floor(g);
    vec3 f = g - b;
    ivec3 base = ivec3(b);
    for (int k = 0; k < 8; k++) {
        ivec3 o = ivec3(k & 1, (k >> 1) & 1, (k >> 2) & 1);
        vec3 w3 = mix(1.0 - f, f, vec3(o));
        float w = w3.x * w3.y * w3.z;
        if (w <= 1e-4) continue;
        uint c = CellIndex(base + o);
        atomicAdd(G[c].x, int(w * WeightScale + 0.5));
        ivec3 m = ivec3(round(v * (w * MomentumScale)));
        atomicAdd(G[c].y, m.x);
        atomicAdd(G[c].z, m.y);
        atomicAdd(G[c].w, m.z);
    }
}

// Density at p (grid weight), its gradient (per unit) and the mean velocity there.
void Sample(vec3 p, out float density, out vec3 grad, out vec3 meanVel) {
    vec3 g = p * F.gridf.y;
    vec3 b = floor(g);
    vec3 f = g - b;
    ivec3 base = ivec3(b);
    density = 0.0; grad = vec3(0.0);
    vec3 mom = vec3(0.0);
    for (int k = 0; k < 8; k++) {
        ivec3 o = ivec3(k & 1, (k >> 1) & 1, (k >> 2) & 1);
        ivec4 n = G[CellIndex(base + o)];
        float rho = float(n.x) / WeightScale;
        vec3 w3 = mix(1.0 - f, f, vec3(o));
        vec3 s = vec3(o) * 2.0 - 1.0;   // d(weight)/d(f) per axis
        float w = w3.x * w3.y * w3.z;
        density += w * rho;
        grad += rho * vec3(s.x * w3.y * w3.z, w3.x * s.y * w3.z, w3.x * w3.y * s.z);
        mom += w * vec3(n.yzw) / MomentumScale;
    }
    grad *= F.gridf.y;
    meanVel = mom / max(density, 1e-3);
}

// ---------------------------------------------------------------- modes
void Emit(uint i) {
    if (i >= pc.total) return;
    // Which emitter this thread belongs to (at most 64 a frame).
    uint start = 0u, k = 0u;
    for (; k < F.counts2.w; k++) {
        if (i < start + E[k].data.y) break;
        start += E[k].data.y;
    }
    if (k >= F.counts2.w) return;
    Emitter e = E[k];
    uint j = i - start;
    uint slot = (e.data.x + j) % F.counts.x;
    uint seed = hashU(e.data.z * 7919u + j * 104729u + 17u);
    float u1 = hash01(seed), u2 = hash01(seed ^ 0x9E3779B9u), u3 = hash01(seed + 0x632BE5ABu), u4 = hash01(seed * 3u + 1u), u5 = hash01(seed * 5u + 7u);
    uint kind = e.data.w >> 24;
    vec3 dir = e.dir.xyz;
    vec3 side = normalize(abs(dir.z) < 0.95 ? cross(dir, vec3(0.0, 0.0, 1.0)) : cross(dir, vec3(1.0, 0.0, 0.0)));
    vec3 side2 = cross(dir, side);
    float ang = u2 * 6.2831853, rad = sqrt(u1);
    vec3 pos, vel;
    float delay;
    if (kind == 1u) {
        // A body bleeding: on the ground round the pool's centre, sliding outward slowly; most of it early.
        vec2 off = vec2(cos(ang), sin(ang)) * rad * e.shape.x;
        pos = e.origin.xyz + vec3(off, 0.0);
        vel = vec3(vec2(cos(ang), sin(ang)) * e.dir.w * (0.5 + u3), 0.0);
        delay = e.shape.w * pow(u4, 1.6);
    }
    else {
        // Thrown: a small cloud a little before the surface, flying at it in a cone, the front first.
        vec3 cone = (vec3(u3, u4, u5) * 2.0 - 1.0) * e.shape.y;
        pos = e.origin.xyz - dir * (e.shape.z * (0.3 + 0.7 * u3)) + (side * cos(ang) + side2 * sin(ang)) * rad * e.shape.x;
        vel = normalize(dir + cone) * e.dir.w * (0.75 + 0.5 * u5);
        delay = e.shape.w * u4;
    }
    Particle q;
    q.pos = vec4(pos, -delay - 1e-4);
    q.vel = vec4(vel, 0.0);
    q.info = vec4(e.origin.w, hash01(seed * 11u + 3u), float(e.data.w & 0xFFFFFFu), float(kind));
    q.nrm = vec4(0.0, 0.0, 0.0, 1.0);
    P[slot] = q;
}

void SplatMode(uint i) {
    if (i >= F.counts.y) return;
    vec4 pos = P[i].pos;
    if (pos.w < 0.0) return;
    vec4 vel = P[i].vel;
    if ((Flags(vel.w) & FlagSettled) != 0u) return;   // dried blood: fresh blood runs over it freely
    Splat(pos.xyz, vel.xyz);
}

void Integrate(uint i) {
    if (i >= F.counts.y) return;
    Particle q = P[i];
    if (q.pos.w <= -1e29) return;
    const float dt = F.sim.x;
    if (q.pos.w < 0.0) {        // not born yet
        q.pos.w = min(q.pos.w + dt, 0.0);
        P[i].pos.w = q.pos.w;
        return;
    }
    float age = q.pos.w + dt;
    if (age > F.gridf.w) { P[i].pos.w = DeadAge; return; }
    uint flags = Flags(q.vel.w);
    if ((flags & FlagSettled) != 0u) { P[i].pos.w = age; return; }

    const float r = F.sim.z;
    vec3 p = q.pos.xyz, v = q.vel.xyz;
    float ground = q.info.x;
    float h1 = q.info.y, h2 = fract(q.info.y * 97.31), h3 = fract(q.info.y * 13.17);

    // Where the camera sees it. Unknown (off screen, behind the camera, the first-person weapon) or hidden behind
    // something: blood that lies on a surface is held there (nothing tells where that surface goes); blood in the air
    // keeps falling, and blood on the fallback ground keeps spreading on it.
    vec3 rel0 = p - F.eyeRel.xyz;
    vec3 s0 = ProjectRel(rel0);
    bool onScreen = s0.z > 1.0 && s0.x >= 1.0 && s0.y >= 1.0 && s0.x < F.screen.x - 1.0 && s0.y < F.screen.y - 1.0;
    // How far behind the surface the camera sees it may be and still count as on it: far for blood in flight (a fast drop
    // can pass the surface within one step: it is put back in front), a few units for blood already lying on something
    // (blood under a body is under the body, not on it).
    float behind = (flags & FlagContact) != 0u ? 2.5 * r : F.wall.w;
    bool hidden = true;
    if (onScreen) {
        ivec2 px = ivec2(s0.xy);
        if (!IsViewModel(ViewModelAt(px))) hidden = s0.z > SceneDepthAt(px) + behind;
    }
    bool onGround = p.z <= ground + r + 0.25;
    if (hidden && !onGround && (flags & FlagTouched) != 0u) {
        P[i].pos.w = age;
        P[i].vel.w = float(flags | FlagFrozen);
        return;
    }
    flags &= ~(FlagFrozen | FlagContact | FlagGround);

    float settle = clamp((age - F.settle.x) / F.settle.y, 0.0, 1.0);
    v.z -= F.sim.y * dt;

    // Neighbours through the grid.
    float density; vec3 grad, meanVel;
    Sample(p, density, grad, meanVel);
    float rest = F.fluid.w;
    float k = density > rest ? -F.fluid.x * min((density - rest) / rest, 1.5) : F.fluid.y;   // capped: a dense throw must not explode
    v += grad * k * dt;
    v = mix(v, meanVel, clamp((F.fluid.z + 30.0 * settle) * dt, 0.0, 1.0));
    v *= 1.0 - F.settle.z * dt;
    float speed = length(v);
    if (speed > F.gridf.z) v *= F.gridf.z / speed;

    float friction = F.wall.x * (0.5 + h1) * (1.0 + 6.0 * settle);
    p += v * dt;

    // Collision with what the camera sees.
    vec3 nrm = q.nrm.xyz;
    vec3 rel = p - F.eyeRel.xyz;
    vec3 s = ProjectRel(rel);
    bool seenInAir = false;   // on screen with the surface it shows behind it: it is falling through the air there
    if (!hidden && s.z > 1.0 && s.x >= 1.0 && s.y >= 1.0 && s.x < F.screen.x - 1.0 && s.y < F.screen.y - 1.0) {
        ivec2 px = ivec2(s.xy);
        float sz = SceneDepthAt(px);
        seenInAir = s.z <= sz - 4.0 * r - F.wall.z && !IsViewModel(ViewModelAt(px));
        if (sz < F.eyeRel.w * 0.979 && s.z > sz - 4.0 * r - F.wall.z && s.z < sz + behind && !IsViewModel(ViewModelAt(px))) {
            vec3 surf = SurfaceAt(px, sz), n = NormalAt(px, sz);
            float d = dot(rel - surf, n);
            if (d < r) {
                p += n * (r - d);
                float vn = dot(v, n);
                if (vn < 0.0) {
                    // No bounce (blood does not bounce): a hard hit spreads sideways instead, away from the crowd.
                    v -= n * vn;
                    vec3 sideways = -grad - n * dot(-grad, n) + (vec3(h1, h2, h3) - 0.5) * 0.02;
                    sideways -= n * dot(sideways, n);
                    if (vn < -60.0) v += normalize(sideways + 1e-5) * (-vn) * F.settle.w * (0.5 + h2);
                }
                vec3 vt = v - n * dot(v, n);
                if (vn > -60.0) v -= vt * clamp(friction * dt, 0.0, 1.0);   // film friction, not on the hit itself
                flags |= FlagContact | FlagTouched;
                nrm = n;
            }
            if (d < r + F.wall.z) v -= n * F.wall.y * dt;   // cling: undersides drip once enough gathers
        }
    }
    // The fallback ground: only where the camera cannot tell (hidden or off screen). Where it sees the surface below, the drop
    // falls on to it (the fallback height, the player's floor, can be above a lower floor in view).
    if (p.z < ground + r && !seenInAir) {
        p.z = ground + r;
        v.z = max(v.z, 0.0);
        v.xy -= v.xy * clamp(friction * dt, 0.0, 1.0);
        if ((flags & FlagContact) == 0u) nrm = vec3(0.0, 0.0, 1.0);   // (on what the camera sees, its normal stays)
        flags |= FlagContact | FlagTouched | FlagGround;
    }
    if (settle >= 1.0 && (flags & FlagContact) != 0u) { v = vec3(0.0); flags |= FlagSettled; }
    // A run down a wall leaves a trail: about half the particles stop for good somewhere along the way, each at its own
    // moment (2026-10-26 in game: without this a run drained to the floor in a few seconds and left the wall clean).
    if ((flags & FlagContact) != 0u && abs(nrm.z) < 0.6 && h3 < 0.55 && age > 0.25 + 5.0 * h3) { v = vec3(0.0); flags |= FlagSettled; }

    P[i].pos = vec4(p, age);
    P[i].vel = vec4(v, float(flags));
    P[i].nrm.xyz = nrm;
}

void Tiles(uint i) {
    if (i >= F.counts.y) return;
    Particle q = P[i];
    if (q.pos.w < 0.0) return;
    uint flags = Flags(q.vel.w);
    // Lying on something (now, or held, settled, on the fallback ground): a stain on that surface. Otherwise a drop in the air,
    // also blood that has left a wall (a drip falling off a ledge).
    bool stain = (flags & (FlagContact | FlagFrozen | FlagSettled | FlagGround)) != 0u && dot(q.nrm.xyz, q.nrm.xyz) > 0.5;
    float R = stain ? F.look.x : F.look.y;
    vec3 rel = q.pos.xyz - F.eyeRel.xyz;
    vec3 s = ProjectRel(rel);
    if (s.z < 1.0) return;
    // The circle it can cover on screen (a sphere of radius R round it is conservative for a stain on any plane).
    float rpx = R * max(F.right.w * F.screen.x, F.up.w * F.screen.y) * 0.5 / max(s.z - R, 1.0) + 1.0;
    ivec2 lo = ivec2(floor((s.xy - rpx) / 16.0)), hi = ivec2(floor((s.xy + rpx) / 16.0));
    lo = max(lo, ivec2(0)); hi = min(hi, ivec2(F.counts.zw) - 1);
    if (any(greaterThan(lo, hi))) return;
    if ((hi.x - lo.x + 1) * (hi.y - lo.y + 1) > 400) return;   // right in front of the lens: left out

    if (F.counts2.z == 3u && i < 8u) {   // TEST (DebugView 3): what the first particles see, for BloodFluid.cpp Stats (the grid's last nodes; nothing reads them after this pass)
        ivec2 px = clamp(ivec2(s.xy), ivec2(0), ivec2(F.screen.xy) - 1);
        G[F.counts2.y - i] = floatBitsToInt(vec4(s.z, SceneDepthAt(px), ViewModelAt(px), texelFetch(t_depth, px, 0).x));
    }
    float life = clamp((F.gridf.w - q.pos.w) / 10.0, 0.0, 1.0);
    DrawRec d;
    d.a = vec4(stain ? rel - normalize(q.nrm.xyz) * F.sim.z : rel, stain ? R : -R);   // (a stain on the surface itself: the particle lies a radius off it)
    d.b = vec4(stain ? normalize(q.nrm.xyz) : vec3(0.0), q.pos.w * F.look2.x);
    d.c = vec4(q.info.z, q.nrm.w * life, q.info.w, q.vel.w);
    D[i] = d;
    for (int ty = lo.y; ty <= hi.y; ty++) {
        for (int tx = lo.x; tx <= hi.x; tx++) {
            uint t = uint(ty) * F.counts.z + uint(tx);
            uint at = atomicAdd(TileCount[t], 1u);
            if (at < F.counts2.x) TileList[t * F.counts2.x + at] = i;
        }
    }
}

void Rebase(uint i) {
    if (i >= F.counts.y) return;
    if (P[i].pos.w <= -1e29) return;
    P[i].pos.xyz += pc.shift.xyz;
    P[i].info.x += pc.shift.z;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (pc.mode == 0u) Emit(i);
    else if (pc.mode == 1u) SplatMode(i);
    else if (pc.mode == 2u) Integrate(i);
    else if (pc.mode == 3u) Tiles(i);
    else Rebase(i);
}

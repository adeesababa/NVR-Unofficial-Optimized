#version 450
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_samplerless_texture_functions : enable
#include "GpuParticles.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 1, binding = 0) uniform texture2D t_depth;
layout(set = 1, binding = 1) uniform texture2D t_ortho;
layout(set = 1, binding = 2, std430) buffer Particles { Particle particles[]; };
layout(set = 1, binding = 3, std140) uniform Frame { GP_FRAME_BLOCK } f;

float sceneDepthAt(vec4 c) {
    if (c.w <= f.camFwd.w || abs(c.x) > c.w || abs(c.y) > c.w) return -1.0;
    vec2 uv = vec2(c.x / c.w * 0.5 + 0.5, -c.y / c.w * 0.5 + 0.5);
    ivec2 size = textureSize(t_depth, 0);
    ivec2 px = clamp(ivec2(uv * vec2(size)), ivec2(0), size - 1);
    return texelFetch(t_depth, px, 0).x * f.origin.w;
}

bool underCover(vec3 p) {
    vec4 o = f.orthoProj * vec4(p, 1.0);
    o.xyz /= o.w;
    if (o.x < -1.0 || o.x > 1.0 || o.y < -1.0 || o.y > 1.0 || o.z < 0.0 || o.z > 1.0) return false;
    ivec2 size = textureSize(t_ortho, 0);
    ivec2 px = clamp(ivec2(vec2(o.x * 0.5 + 0.5, -o.y * 0.5 + 0.5) * vec2(size)), ivec2(0), size - 1);
    return texelFetch(t_ortho, px, 0).r < o.z - 0.0002;
}

vec3 fallVelocity(float seed, float t) {
    float speed = f.box.w;
    if (f.sim.w > 0.5)
        return vec3(sin(t * 1.3 + seed * 40.0) * 18.0, cos(t * 0.9 + seed * 17.0) * 18.0, -speed * (0.7 + 0.6 * seed));
    return vec3(0.0, 0.0, -speed * (0.85 + 0.3 * seed));
}

void spawn(inout Particle p, inout uint rng, bool anywhere) {
    float R = f.box.x;
    float seed = max(gpRand(rng), 1e-4);
    vec3 pos;
    for (int k = 0; k < 4; k++) {
        pos.xy = (vec2(gpRand(rng), gpRand(rng)) * 2.0 - 1.0) * R;
        pos.z = anywhere ? mix(-f.box.z, f.box.y, gpRand(rng)) : f.box.y - gpRand(rng) * f.box.w * 0.25;
        if (!gpFlag(f.look.w, GP_ORTHO) || !underCover(pos)) break;
        pos.z = f.box.y;
    }
    p.a = vec4(pos, -1.0);
    p.b = vec4(fallVelocity(seed, f.light.a), seed);
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(f.sim.x)) return;

    Particle p = particles[i];
    uint rng = gpHash(i * 9781u + uint(f.sim.y) * 6271u + 17u);
    float dt = f.camDelta.w;

    if (p.b.w <= 0.0 || gpFlag(f.look.w, GP_RESET)) {
        spawn(p, rng, true);
        particles[i] = p;
        return;
    }

    vec3 pos = p.a.xyz - f.camDelta.xyz;
    float R = f.box.x;

    if (p.a.w < 0.0) {
        pos.xy = mod(pos.xy + R, 2.0 * R) - R;
        vec3 vel = fallVelocity(p.b.w, f.light.a);
        vec3 next = pos + vel * dt;
        bool landed = false;

        if (gpFlag(f.look.w, GP_ORTHO)) {
            bool coverNow = underCover(next);
            if (coverNow && !underCover(pos)) landed = true;
            else if (coverNow) { spawn(p, rng, false); particles[i] = p; return; }
        }

        if (!landed) {
            vec4 c = f.viewProj * vec4(next + f.origin.xyz, 1.0);
            float d = sceneDepthAt(c);
            float margin = abs(vel.z) * dt + 30.0;
            if (d > 60.0 && c.w > d && c.w < d + margin) {
                next *= d / c.w;
                landed = true;
            }
        }

        if (landed) {
            if (gpFlag(f.look.w, GP_SPLASHES)) {
                next -= normalize(next) * 2.0;
                p.a = vec4(next, 0.0);
                p.b.xyz = vec3(0.0);
            }
            else spawn(p, rng, false);
        }
        else if (next.z < -f.box.z) spawn(p, rng, false);
        else {
            p.a = vec4(next, -1.0);
            p.b.xyz = vel;
        }
    }
    else {
        float age = p.a.w + dt;
        if (age > f.sim.z || abs(pos.x) > R * 1.2 || abs(pos.y) > R * 1.2) spawn(p, rng, false);
        else p.a = vec4(pos, age);
    }
    particles[i] = p;
}

// FSR 3.1 upscaler (AMD FidelityFX SDK 1.1.4, MIT; see LICENSE-FidelityFX-SDK.txt) pass for NVR DXVK: AMD's
// ffx_fsr3upscaler_prepare_inputs_pass.glsl with NVR's callbacks header (fsr3upscaler/ffx_fsr3upscaler_callbacks_nvr.h). AMD's binding numbers are
// kept; the ones NVR has no resource for (exposure, transparency mask) declare nothing there.
#version 450

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_samplerless_texture_functions : require

#define FSR3UPSCALER_BIND_SRV_INPUT_MOTION_VECTORS              0
#define FSR3UPSCALER_BIND_SRV_INPUT_DEPTH                       1
#define FSR3UPSCALER_BIND_SRV_INPUT_COLOR                       2
#define FSR3UPSCALER_BIND_UAV_DILATED_MOTION_VECTORS            3
#define FSR3UPSCALER_BIND_UAV_DILATED_DEPTH                     4
#define FSR3UPSCALER_BIND_UAV_RECONSTRUCTED_PREV_NEAREST_DEPTH  5
#define FSR3UPSCALER_BIND_UAV_FARTHEST_DEPTH                    6
#define FSR3UPSCALER_BIND_UAV_CURRENT_LUMA                      7
#define FSR3UPSCALER_BIND_CB_FSR3UPSCALER                       8

#include "fsr3upscaler/ffx_fsr3upscaler_callbacks_nvr.h"
#include "fsr3upscaler/ffx_fsr3upscaler_common.h"
#include "fsr3upscaler/ffx_fsr3upscaler_prepare_inputs.h"

layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
void main()
{
    PrepareInputs(FfxInt32x2(gl_GlobalInvocationID.xy));
}

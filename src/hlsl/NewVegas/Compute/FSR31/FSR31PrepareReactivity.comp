// FSR 3.1 upscaler (AMD FidelityFX SDK 1.1.4, MIT; see LICENSE-FidelityFX-SDK.txt) pass for NVR DXVK: AMD's
// ffx_fsr3upscaler_prepare_reactivity_pass.glsl with NVR's callbacks header (fsr3upscaler/ffx_fsr3upscaler_callbacks_nvr.h). AMD's binding numbers are
// kept; the ones NVR has no resource for (exposure, transparency mask) declare nothing there.
#version 450

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_samplerless_texture_functions : require

#define FSR3UPSCALER_BIND_SRV_RECONSTRUCTED_PREV_NEAREST_DEPTH  0
#define FSR3UPSCALER_BIND_SRV_DILATED_MOTION_VECTORS            1
#define FSR3UPSCALER_BIND_SRV_DILATED_DEPTH                     2
#define FSR3UPSCALER_BIND_SRV_REACTIVE_MASK                     3   // NVR: the input depth texture (reactive mask in green)
#define FSR3UPSCALER_BIND_SRV_TRANSPARENCY_AND_COMPOSITION_MASK 4   // NVR: none (0)
#define FSR3UPSCALER_BIND_SRV_ACCUMULATION                      5
#define FSR3UPSCALER_BIND_SRV_SHADING_CHANGE                    6
#define FSR3UPSCALER_BIND_SRV_CURRENT_LUMA                      7
#define FSR3UPSCALER_BIND_SRV_INPUT_EXPOSURE                    8   // NVR: none (1)
#define FSR3UPSCALER_BIND_UAV_DILATED_REACTIVE_MASKS            9
#define FSR3UPSCALER_BIND_UAV_NEW_LOCKS                         10
#define FSR3UPSCALER_BIND_UAV_ACCUMULATION                      11
#define FSR3UPSCALER_BIND_CB_FSR3UPSCALER                       12

#include "fsr3upscaler/ffx_fsr3upscaler_callbacks_nvr.h"
#include "fsr3upscaler/ffx_fsr3upscaler_common.h"
#include "fsr3upscaler/ffx_fsr3upscaler_prepare_reactivity.h"

layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
void main()
{
    PrepareReactivity(FfxInt32x2(gl_GlobalInvocationID.xy));
}

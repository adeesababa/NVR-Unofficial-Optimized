// FSR 3.1 upscaler (AMD FidelityFX SDK 1.1.4, MIT; see LICENSE-FidelityFX-SDK.txt) pass for NVR DXVK: AMD's
// ffx_fsr3upscaler_accumulate_pass.glsl with NVR's callbacks header (fsr3upscaler/ffx_fsr3upscaler_callbacks_nvr.h). AMD's binding numbers are
// kept; the ones NVR has no resource for (exposure, transparency mask) declare nothing there.
#version 450

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_samplerless_texture_functions : require

// Built as FSR31Accumulate[Sharpen][Hdr].spv: FFX_FSR3UPSCALER_OPTION_APPLY_SHARPENING 0 writes the output, 1 leaves it to
// RCAS; FFX_FSR3UPSCALER_OPTION_HDR_COLOR_INPUT 1 for the world scene before tonemapping (RenderScale).
#define FSR3UPSCALER_BIND_SRV_INPUT_EXPOSURE                    0   // NVR: none (1)
#define FSR3UPSCALER_BIND_SRV_DILATED_REACTIVE_MASKS            1
#define FSR3UPSCALER_BIND_SRV_DILATED_MOTION_VECTORS            2   // low-resolution motion vectors (NVR's)
#define FSR3UPSCALER_BIND_SRV_INTERNAL_UPSCALED                 3
#define FSR3UPSCALER_BIND_SRV_FARTHEST_DEPTH_MIP1               5
#define FSR3UPSCALER_BIND_SRV_CURRENT_LUMA                      6
#define FSR3UPSCALER_BIND_SRV_LUMA_INSTABILITY                  7
#define FSR3UPSCALER_BIND_SRV_INPUT_COLOR                       8
#define FSR3UPSCALER_BIND_UAV_INTERNAL_UPSCALED                 9
#define FSR3UPSCALER_BIND_UAV_UPSCALED_OUTPUT                   10
#define FSR3UPSCALER_BIND_UAV_NEW_LOCKS                         11
#define FSR3UPSCALER_BIND_CB_FSR3UPSCALER                       12

#include "fsr3upscaler/ffx_fsr3upscaler_callbacks_nvr.h"
#include "fsr3upscaler/ffx_fsr3upscaler_common.h"
#include "fsr3upscaler/ffx_fsr3upscaler_sample.h"
#include "fsr3upscaler/ffx_fsr3upscaler_upsample.h"
#include "fsr3upscaler/ffx_fsr3upscaler_reproject.h"
#include "fsr3upscaler/ffx_fsr3upscaler_accumulate.h"

layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
void main()
{
    Accumulate(FfxInt32x2(gl_GlobalInvocationID.xy));
}

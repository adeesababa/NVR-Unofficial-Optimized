
#version 450
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_EXT_samplerless_texture_functions : enable

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler s_samplers[];

layout(set = 1, binding = 0) uniform texture2D t_color;
layout(set = 1, binding = 1) uniform texture2D t_depth;

layout(set = 1, binding = 2, std430) buffer Partials {
    float partial[];
};

layout(set = 1, binding = 3, std430) readonly buffer StateIn {
    vec4  prev;
    uvec2 prevPacked;
};

layout(set = 1, binding = 4, std430) writeonly buffer StateOut {
    vec4  cur;
    uvec2 packed;
    float average;
    float pad;
};

layout(push_constant) uniform Push {
    uint  width;
    uint  height;
    uint  groupsX;
    uint  groupsY;
    uint  phase;
    uint  samplerIndex;
    uint  pad0;
    uint  pad1;
    vec4  motionBlurData;
    vec4  depthOfFieldData;
    vec4  gameTime;
    vec4  exposureData;
    vec4  cameraData;
} pc;

shared float s_sum[256];

vec3 linearize(vec3 c) {
    vec3 lo = c / 12.92;
    vec3 hi = pow(abs((c + 0.055) / 1.055), vec3(2.4));
    return mix(hi, lo, lessThanEqual(c, vec3(0.04045)));
}

float luma(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

float readDepth(vec2 uv) {
    float farZ = pc.cameraData.y;
    return texture(sampler2D(t_depth, s_samplers[pc.samplerIndex & 0xFFFFu]), uv).x * farZ;
}

const vec2 taps[12] = vec2[12](
    vec2(-0.326212, -0.405810),
    vec2(-0.840144, -0.073580),
    vec2(-0.695914,  0.457137),
    vec2(-0.203345,  0.620716),
    vec2( 0.962340, -0.194983),
    vec2( 0.473434, -0.480026),
    vec2( 0.519456,  0.767022),
    vec2( 0.185461, -0.893124),
    vec2( 0.507431,  0.064425),
    vec2( 0.896420,  0.412458),
    vec2(-0.321940, -0.932615),
    vec2(-0.791559, -0.597710)
);

const vec2 center = vec2(0.5, 0.5);

float stepTo(float startValue, float endValue, float minStep, float maxStep) {
    minStep = abs(minStep) * -1.0;
    maxStep = abs(maxStep);
    float diff = clamp(endValue - startValue, minStep, maxStep);
    return startValue + diff;
}

float getFocalDistance(float oldFocus) {
    float hyperFocalDistance = max(0.0000001, pc.depthOfFieldData.x * 1000.0);

    vec2 speed = clamp(abs(pc.motionBlurData.xy), 0.0, 1.0) + 0.1;

    float centerDepth = readDepth(center);
    float depth = centerDepth;
    vec2 samplingRange = speed;
    for (int i = 0; i < 12; i++)
        depth += readDepth(center + 0.3 * taps[i] * samplingRange);
    depth /= 12.0;

    depth = centerDepth > depth ? centerDepth : depth;
    depth = clamp(depth / hyperFocalDistance, 0.0, 1.0);

    float step = pow(max(oldFocus, depth), 0.1);
    return stepTo(oldFocus, depth, 3.0 * step * pc.gameTime.w, 1.0 * step * pc.gameTime.w);
}

void reduceShared() {
    barrier();
    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (gl_LocalInvocationIndex < s)
            s_sum[gl_LocalInvocationIndex] += s_sum[gl_LocalInvocationIndex + s];
        barrier();
    }
}

void main() {
    if (pc.phase == 0u) {
        ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
        float value = 0.0;
        if (pos.x < int(pc.width) && pos.y < int(pc.height))
            value = luma(linearize(texelFetch(t_color, pos, 0).rgb));

        s_sum[gl_LocalInvocationIndex] = value;
        reduceShared();

        if (gl_LocalInvocationIndex == 0u)
            partial[gl_WorkGroupID.y * pc.groupsX + gl_WorkGroupID.x] = s_sum[0];
    }
    else {
        uint tiles = pc.groupsX * pc.groupsY;
        float sum = 0.0;
        for (uint i = gl_LocalInvocationIndex; i < tiles; i += 256u)
            sum += partial[i];

        s_sum[gl_LocalInvocationIndex] = sum;
        reduceShared();

        if (gl_LocalInvocationIndex == 0u) {
            float average_ = s_sum[0] / float(pc.width * pc.height);

            vec2 oldLuma = prev.rg;
            float newLuma = (average_ + (7.0 * oldLuma.r)) / 8.0;

            float decreaseRate = -pc.exposureData.z;
            float increaseRate = pc.exposureData.w;
            float animatedLuma = stepTo(oldLuma.g, newLuma, pc.gameTime.w * decreaseRate, pc.gameTime.w * increaseRate);

            float focus = getFocalDistance(prev.b);

            vec4 result = vec4(newLuma, animatedLuma, focus, 1.0);
            cur = result;
            packed = uvec2(packHalf2x16(result.rg), packHalf2x16(result.ba));
            average = average_;
            pad = 0.0;
        }
    }
}

// UNOFFICIAL 2026-10-28 (RT reflections; docs/next/FORK-RT-REFLECTIONS.md): the RT helper's pass for Reflections (runs in NvrRtHelper.exe,
// the RT core's 64-bit process, docs/next/FORK-RT-CORE.md; the game's 32-bit Vulkan driver has no ray tracing). One thread per
// half-resolution pixel: where Reflections' RayGen asked for a ray (origin.a = 1), one closest-hit ray query from the surface along the
// reflected direction, then from the hit one shadow ray toward the sun (outdoors by day only). Writes the hit image ReflectionsRTResolve
// reads: x hit distance (-1 no ray asked, 0 nothing within Distance), y instance custom index, z sun visible at the hit, w primitive.
// Bindings: the RT core's fixed layout (tools/nvr-rt-helper/NvrRtProtocol.h, 253a5c32): set 0, binding 0 the scene (camera-relative world
// space, as NVR's effect space), 1 the pass constants (up to 512 bytes), 2.. the pass's shared images as storage images (GENERAL).
#version 460
#extension GL_EXT_ray_query : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT scene;
layout(set = 0, binding = 1, std140) uniform Pass {
    vec4 size;      // xy the images' size, z Distance, w 1 = sun shadow rays
    vec4 sunDir;    // world, toward the sun; w sun amount (0: no shadow ray)
    vec4 offset;    // xyz camera-relative -> the scene's space (0: the RT core's scene is camera-relative)
} pc;
layout(set = 0, binding = 2, rgba32f) uniform readonly image2D dirImage;      // RayGen out 1: direction (world), roughness
layout(set = 0, binding = 3, rgba32f) uniform readonly image2D originImage;   // RayGen out 2: the surface (camera-relative), a = 1 cast
layout(set = 0, binding = 4, rgba32f) uniform writeonly image2D hitImage;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, ivec2(pc.size.xy)))) return;
    vec4 origin = imageLoad(originImage, p);
    if (origin.a < 0.5) { imageStore(hitImage, p, vec4(-1.0, -1.0, 1.0, -1.0)); return; }
    vec3 dir = normalize(imageLoad(dirImage, p).xyz);
    vec3 o = origin.xyz + pc.offset.xyz;
    // Start a little way along the ray: past the depth buffer's own error far away (no hit on the surface itself).
    float tMin = 1.0 + length(origin.xyz) * 0.0015;

    rayQueryEXT q;
    rayQueryInitializeEXT(q, scene, gl_RayFlagsOpaqueEXT, 0xFFu, o, tMin, dir, pc.size.z);
    while (rayQueryProceedEXT(q)) {}
    if (rayQueryGetIntersectionTypeEXT(q, true) != gl_RayQueryCommittedIntersectionTriangleEXT) {
        imageStore(hitImage, p, vec4(0.0, -1.0, 1.0, -1.0));
        return;
    }
    float t = rayQueryGetIntersectionTEXT(q, true);
    float instance = float(rayQueryGetIntersectionInstanceCustomIndexEXT(q, true));
    float primitive = float(rayQueryGetIntersectionPrimitiveIndexEXT(q, true));

    // The sun at the hit: one shadow ray, starting back off the hit along the incoming ray (no normal here yet).
    float sun = 1.0;
    if (pc.size.w > 0.5 && pc.sunDir.w > 0.0) {
        vec3 L = normalize(pc.sunDir.xyz);
        vec3 h = o + dir * t - dir * max(2.0, t * 0.002);
        rayQueryEXT s;
        rayQueryInitializeEXT(s, scene, gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT, 0xFFu, h, 0.5, L, 30000.0);
        while (rayQueryProceedEXT(s)) {}
        sun = rayQueryGetIntersectionTypeEXT(s, true) == gl_RayQueryCommittedIntersectionNoneEXT ? 1.0 : 0.0;
    }
    imageStore(hitImage, p, vec4(t, instance, sun, primitive));
}

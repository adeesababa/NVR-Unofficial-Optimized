
#version 450
#extension GL_EXT_samplerless_texture_functions : enable

layout(local_size_x = 8, local_size_y = 32, local_size_z = 1) in;

layout(set = 1, binding = 0) uniform texture2D t_prep;

layout(set = 1, binding = 1, std430) writeonly buffer Result {
    vec4 result[];
};

layout(push_constant) uniform Push {
    uint  width;
    uint  height;
    uint  tileRows;
    uint  reachTexels;
    float reach;
    float drawDistance;
    float invWidth;
    float invHeight;
    float uvOffsetX;
    float uvOffsetY;
    float proj00;
    float proj11;
} pc;

const uint REGION_ROWS = 256u;
shared uvec2 s_x[REGION_ROWS * 8u];

float saturate(float v) { return v > 0.0 ? min(v, 1.0) : 0.0; }

vec3 PositionFromViewZ(vec2 uv, float z) {
    return vec3((uv.x * 2.0 - 1.0) / pc.proj00, (1.0 - uv.y * 2.0) / pc.proj11, 1.0) * z;
}

float Pack2(vec2 v) { v = floor(clamp(v, 0.0, 1.0) * 4095.0 + 0.5); return v.x * 4096.0 + v.y; }
vec2 Unpack2(float p) { float high = floor(p / 4096.0); return vec2(high, p - high * 4096.0) / 4095.0; }
vec2 OctEncode(vec3 n) {
    n /= abs(n.x) + abs(n.y) + abs(n.z);
    vec2 s = vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
    vec2 e = n.z >= 0.0 ? n.xy : (1.0 - abs(n.yx)) * s;
    return e * 0.5 + 0.5;
}
vec3 OctDecode(vec2 e) {
    e = e * 2.0 - 1.0;
    vec3 n = vec3(e, 1.0 - abs(e.x) - abs(e.y));
    float t = saturate(-n.z);
    n.x += n.x >= 0.0 ? -t : t;
    n.y += n.y >= 0.0 ? -t : t;
    return normalize(n);
}

int PointTexel(float u, uint size) { return clamp(int(floor(u * float(size))), 0, int(size) - 1); }

float TapWeight(vec2 tapUV, float tapZ, vec3 tapNormal, vec3 origin, vec3 normal, float viewZ, float dist, float onScreen) {
    float tolerance = max(viewZ * 0.001 * dist, 0.5);
    float plane = abs(dot(PositionFromViewZ(tapUV, tapZ) - origin, normal));
    return saturate(1.0 - plane / tolerance) * smoothstep(0.5, 0.8, dot(tapNormal, normal)) * onScreen;
}

float OnScreen(vec2 t) { return step(0.0, t.x) * step(t.x, 1.0) * step(0.0, t.y) * step(t.y, 1.0); }

vec4 SmoothX(int x, int y) {
    vec2 uv = vec2(float(x) * pc.invWidth + pc.uvOffsetX, float(y) * pc.invHeight + pc.uvOffsetY);
    vec4 c = texelFetch(t_prep, ivec2(x, y), 0);
    float viewZ = c.x;
    vec3 normal = OctDecode(Unpack2(c.y));
    if (viewZ < pc.drawDistance && pc.reach > 0.5) {
        vec3 origin = PositionFromViewZ(uv, viewZ);
        float spacing = pc.reach / 3.0;
        vec3 sum = normal;
        for (int k = -3; k <= 3; k++) {
            if (k == 0) continue;
            float dist = abs(float(k)) * spacing;
            vec2 tapUV = uv + vec2(1.0, 0.0) * (float(k) * spacing) * vec2(pc.invWidth, pc.invHeight);
            float onScreen = OnScreen(tapUV);
            tapUV = clamp(tapUV, 0.0, 1.0);
            vec4 t = texelFetch(t_prep, ivec2(PointTexel(tapUV.x, pc.width), y), 0);
            float tapZ = t.x;
            vec3 tapNormal = OctDecode(Unpack2(t.y));
            sum += tapNormal * TapWeight(tapUV, tapZ, tapNormal, origin, normal, viewZ, dist, onScreen);
        }
        normal = normalize(sum);
    }
    return vec4(normal, viewZ);
}

vec4 ReadX(uint row, uint column) {
    uvec2 p = s_x[row * 8u + column];
    return vec4(unpackHalf2x16(p.x), unpackHalf2x16(p.y));
}

void main() {
    uint column = gl_LocalInvocationID.x;
    int x = int(gl_WorkGroupID.x * 8u + column);
    int firstRow = int(gl_WorkGroupID.y * pc.tileRows);
    int regionTop = firstRow - int(pc.reachTexels);
    bool inX = x < int(pc.width);

    for (uint row = gl_LocalInvocationID.y; row < REGION_ROWS; row += 32u) {
        int y = regionTop + int(row);
        if (inX && y >= 0 && y < int(pc.height)) {
            vec4 v = SmoothX(x, y);
            s_x[row * 8u + column] = uvec2(packHalf2x16(v.xy), packHalf2x16(v.zw));
        }
    }
    barrier();

    for (uint row = gl_LocalInvocationID.y; row < pc.tileRows; row += 32u) {
        int y = firstRow + int(row);
        if (!inX || y >= int(pc.height)) continue;
        vec2 uv = vec2(float(x) * pc.invWidth + pc.uvOffsetX, float(y) * pc.invHeight + pc.uvOffsetY);
        vec4 c = ReadX(uint(y - regionTop), column);
        vec3 normal = c.xyz;
        float viewZ = c.w;
        if (viewZ < pc.drawDistance && pc.reach > 0.5) {
            vec3 origin = PositionFromViewZ(uv, viewZ);
            float spacing = pc.reach / 3.0;
            vec3 sum = normal;
            for (int k = -3; k <= 3; k++) {
                if (k == 0) continue;
                float dist = abs(float(k)) * spacing;
                vec2 tapUV = uv + vec2(0.0, 1.0) * (float(k) * spacing) * vec2(pc.invWidth, pc.invHeight);
                float onScreen = OnScreen(tapUV);
                tapUV = clamp(tapUV, 0.0, 1.0);
                vec4 t = ReadX(uint(PointTexel(tapUV.y, pc.height) - regionTop), column);
                vec3 tapNormal = t.xyz;
                float tapZ = t.w;
                sum += tapNormal * TapWeight(tapUV, tapZ, tapNormal, origin, normal, viewZ, dist, onScreen);
            }
            normal = normalize(sum);
        }
        result[uint(y) * pc.width + uint(x)] = vec4(viewZ, Pack2(OctEncode(normal)), 0.0, 0.0);
    }
}

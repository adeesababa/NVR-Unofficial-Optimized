#version 460
// UNOFFICIAL 2026-10-28 RT lamp shadows, the trace pass ([Shaders.ShadowsInteriors.RT], core\RtLampShadows.cpp;
// docs\next\FORK-RT-LAMPS.md). Runs in the 64-bit RT helper (NvrRtHelper.exe; its binding layout: FORK-RT-CORE.md), not in the game.
// Per pixel of the frame's depth, for each of up to 9 shadowed lamps (NVR's cube slots 0-8): how much of the lamp the point sees, in
// 16 steps. Output RG32F, exact integers below 2^24 in both channels:
//   r = lamps 0-5, 4 bits each (lamp k at bits 4k)
//   g = lamps 6-8 (bits 0-11) + 4096 x the view depth's 12-bit log code (round(log2(z) / log2(far) x 4095); 0 = sky / none)
// The lamp shaders of the next frame (PointShadowForward.hlsl, POINT_SHADOW_RT) reproject into this frame and use a lamp's value where
// the depth matches theirs; elsewhere their cube map.
// Each lamp: Rays rays aimed over a disc of the lamp's radius facing the point (golden-angle spiral turned per pixel and frame), each
// in two segments: the whole ray with the far mask, the last LampModelDistance next to the lamp with the near mask (lamp models
// skipped too), stopping LampStop short of the lamp, starting off the surface along its normal.
// Compile: glslangValidator -V --target-env vulkan1.2 -o RtLampTrace.spv RtLampTrace.comp
#extension GL_EXT_ray_query : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT scene;
layout(set = 0, binding = 1, std140) uniform Pass {
	vec4 size;          // x width, y height, z 1 / width, w 1 / height
	vec4 forward;       // xyz camera forward (scene space), w farZ (the depth buffer holds view z / farZ)
	vec4 right;         // xyz camera right / projection[0][0]
	vec4 up;            // xyz camera up / projection[1][1]
	vec4 origin;        // xyz the view origin in scene space (CameraLocation - CameraPosition, ~0), w 4095 / log2(farZ)
	vec4 params;        // x rays per lamp (1-8), y StartOffset (units), z LampStop (units), w noise offset (0..1)
	vec4 params2;       // x LampModelDistance (0 = one segment), y far cull mask, z near cull mask, w lamp count (0-9)
	vec4 lamps[9];      // xyz the lamp (scene space), w its reach (units; 0 = no lamp in this slot)
	vec4 radius[3];     // the radius the rays aim over for lamp k: radius[k / 4][k % 4]
} p;
layout(set = 0, binding = 2, r32f) uniform readonly image2D depthImage;      // TESR_DepthBuffer's red: view z / farZ
layout(set = 0, binding = 3, rgba16f) uniform readonly image2D normalImage;  // TESR_NormalsBuffer: view-space normal * 0.5 + 0.5
layout(set = 0, binding = 4, rg32f) uniform writeonly image2D resultImage;

float hash12(vec2 q) {
	vec3 h = fract(vec3(q.xyx) * 0.1031);
	h += dot(h, h.yzx + 33.33);
	return fract((h.x + h.y) * h.z);
}

bool blocked(vec3 origin, vec3 segment, float tMin, float tMax, uint mask) {
	if (!(tMax > tMin)) return false;
	rayQueryEXT q;
	rayQueryInitializeEXT(q, scene, gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT, mask, origin, tMin, segment, tMax);
	while (rayQueryProceedEXT(q)) { }
	return rayQueryGetIntersectionTypeEXT(q, true) != gl_RayQueryCommittedIntersectionNoneEXT;
}

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	if (pixel.x >= int(p.size.x) || pixel.y >= int(p.size.y))
		return;

	const float allLit = 16777215.0;          // every nibble 15
	float linear01 = imageLoad(depthImage, pixel).r;
	float viewZ = linear01 * p.forward.w;
	if (!(linear01 > 0.0) || linear01 >= 0.9999 || viewZ < 1.0) {
		imageStore(resultImage, pixel, vec4(allLit, 4095.0, 0.0, 0.0));     // sky / nothing: depth code 0 never matches
		return;
	}

	// The position and normal as RtSunShadow.comp (SunShadows.glsl's toWorld())
	vec2 uv = (vec2(pixel) + 0.5) * p.size.zw;
	vec3 position = p.origin.xyz + (p.forward.xyz + p.right.xyz * (2.0 * uv.x - 1.0) - p.up.xyz * (2.0 * uv.y - 1.0)) * viewZ;
	vec3 n = imageLoad(normalImage, pixel).xyz * 2.0 - 1.0;
	vec3 normal = normalize(normalize(p.right.xyz) * n.x + normalize(p.up.xyz) * n.y + normalize(p.forward.xyz) * n.z);

	uint rays = uint(clamp(p.params.x, 1.0, 8.0));
	float offset = p.params.y, stop = p.params.z;
	float spin = 6.2831853 * fract(hash12(vec2(pixel)) + p.params.w);
	uint farMask = uint(p.params2.y), nearMask = uint(p.params2.z);
	vec3 origin = position + normal * offset;
	int count = min(int(p.params2.w), 9);

	float r = 0.0, g = 0.0;
	for (int s = 0; s < 9; s++) {
		float steps = 15.0;                                   // lit: no lamp, out of reach, at the lamp, or facing away (the
		vec4 lamp = p.lamps[s];                               // object shader's own lighting takes that to 0 with its finer normal)
		vec3 toLamp = lamp.xyz - origin;
		float dist = length(toLamp);
		if (s < count && lamp.w > 0.0 && dist < lamp.w && dist > stop + offset && dot(toLamp, normal) > 0.0) {
			vec3 dir = toLamp / dist;
			vec3 t = normalize(cross(dir, abs(dir.z) < 0.9 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0)));
			vec3 b = cross(dir, t);
			float radius = p.radius[s / 4][s % 4];
			uint lit = 0u;
			for (uint i = 0u; i < rays; i++) {
				float rr = radius * sqrt((float(i) + 0.5) / float(rays));
				float a = float(i) * 2.3999632 + spin;
				vec3 segment = toLamp + (t * cos(a) + b * sin(a)) * rr;
				float invLen = inversesqrt(dot(segment, segment));
				float tEnd = clamp(1.0 - stop * invLen, 0.0, 1.0);
				float tMin = min(offset * invLen, tEnd);
				float tSplit = clamp(1.0 - p.params2.x * invLen, tMin, tEnd);
				if (!blocked(origin, segment, tMin, tSplit, farMask) && !blocked(origin, segment, tSplit, tEnd, nearMask))
					lit++;
			}
			steps = floor(15.0 * float(lit) / float(rays) + 0.5);
		}
		if (s < 6) r += steps * exp2(4.0 * float(s));
		else       g += steps * exp2(4.0 * float(s - 6));
	}
	float depthCode = clamp(floor(log2(viewZ) * p.origin.w + 0.5), 1.0, 4095.0);
	imageStore(resultImage, pixel, vec4(r, g + 4096.0 * depthCode, 0.0, 0.0));
}

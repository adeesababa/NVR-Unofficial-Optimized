#version 460
// UNOFFICIAL 2026-10-30 RT lamp shadows Flashlight ([Shaders.ShadowsInteriors.RT] Flashlight, off; core\RtLampShadows.h;
// docs\next\FORK-RT-LAMPS.md): the flashlight's (the Pip-Boy light's) shadow traced. Runs in the RT helper. One ray a pixel from the
// surface (off it along its normal) toward the flashlight, stopping FlashlightStop short of it (past the player's own body and
// weapon); out of the light's reach the pixel is lit. Output R32F: 1 lit, 0 blocked, what Flashlight's shadow pass
// (FlashlightShadows.frag) makes of its shadow map; FlashlightShadowsRT.frag reads it in its place.
// Compile: glslangValidator -V --target-env vulkan1.2 -o RtFlashTrace.spv RtFlashTrace.comp
#extension GL_EXT_ray_query : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT scene;
layout(set = 0, binding = 1, std140) uniform Pass {
	vec4 size;          // x width, y height
	vec4 forward;       // xyz camera forward (scene space), w farZ
	vec4 right;         // xyz camera right / projection[0][0]
	vec4 up;            // xyz camera up / projection[1][1]
	vec4 origin;        // xyz the view origin in scene space (RtCore::Eye)
	vec4 light;         // xyz the flashlight (scene space), w its reach
	vec4 params;        // x StartOffset, y FlashlightStop, z cull mask
} p;
layout(set = 0, binding = 2, r32f) uniform readonly image2D depthImage;      // view z / farZ
layout(set = 0, binding = 3, rgba16f) uniform readonly image2D normalImage;  // view-space normal * 0.5 + 0.5
layout(set = 0, binding = 4, r32f) uniform writeonly image2D resultImage;

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	if (pixel.x >= int(p.size.x) || pixel.y >= int(p.size.y))
		return;
	float linear01 = imageLoad(depthImage, pixel).r;
	float viewZ = linear01 * p.forward.w;
	if (!(linear01 > 0.0) || linear01 >= 0.9999 || viewZ < 1.0) {
		imageStore(resultImage, pixel, vec4(1.0));
		return;
	}
	vec2 uv = (vec2(pixel) + 0.5) / p.size.xy;
	vec3 position = p.origin.xyz + (p.forward.xyz + p.right.xyz * (2.0 * uv.x - 1.0) - p.up.xyz * (2.0 * uv.y - 1.0)) * viewZ;
	vec3 n = imageLoad(normalImage, pixel).xyz * 2.0 - 1.0;
	vec3 normal = normalize(normalize(p.right.xyz) * n.x + normalize(p.up.xyz) * n.y + normalize(p.forward.xyz) * n.z);
	vec3 origin = position + normal * p.params.x;
	vec3 toLight = p.light.xyz - origin;
	float dist = length(toLight);
	float lit = 1.0;
	if (dist < p.light.w && dist > p.params.y + p.params.x) {
		float tEnd = 1.0 - p.params.y / dist;
		float tMin = min(p.params.x / dist, tEnd);
		rayQueryEXT q;
		rayQueryInitializeEXT(q, scene, gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT, uint(p.params.z), origin, tMin, toLight, tEnd);
		while (rayQueryProceedEXT(q)) { }
		if (rayQueryGetIntersectionTypeEXT(q, true) != gl_RayQueryCommittedIntersectionNoneEXT) lit = 0.0;
	}
	imageStore(resultImage, pixel, vec4(lit));
}

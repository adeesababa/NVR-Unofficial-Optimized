#version 460
// UNOFFICIAL 2026-10-28 RT sun shadows ([Shaders.ShadowsExteriors.RT], core\RtSunShadows.cpp; docs\next\FORK-RT-SUN.md): one ray
// per pixel toward the sun against the helper's scene (NvrRtHelper.exe; the binding layout is the helper's: FORK-RT-CORE.md).
// Runs in the 64-bit helper, not in the game. Output: sun visibility 0 (blocked) .. 1 (free), 1 for sky, back faces and pixels
// beyond the RT range (fading to 1 over the last FadeLength units).
// Compile: glslangValidator -V --target-env vulkan1.2 -o RtSunShadow.spv RtSunShadow.comp
#extension GL_EXT_ray_query : require
#extension GL_GOOGLE_include_directive : enable

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT scene;
layout(set = 0, binding = 1, std140) uniform Pass {
	vec4 size;          // x width, y height (of the images), z 1 / width, w 1 / height
	vec4 forward;       // xyz camera forward (scene space), w farZ (the depth buffer holds view z / farZ)
	vec4 right;         // xyz camera right / projection[0][0]
	vec4 up;            // xyz camera up / projection[1][1]
	vec4 origin;        // xyz the eye in scene space (RtCore::Eye(): 0), w unused
	vec4 sun;           // xyz toward the sun (scene space, normalized), w 1: the sun is up
	vec4 bias;          // x normal offset (units), y normal offset per unit of view distance, z start offset along the ray, w ray length
	vec4 range;         // x RT range (view distance), y fade length, z cull mask, w debug (1: hit distance / 4096 instead of visibility,
	                    // 2: state codes, 3: a primary camera ray's hit distance / 8192: FORK-RT-SUN.md "Debug views")
	vec4 alpha;         // x 1: test alpha-tested casters (the core's AlphaTested; binding 5 is the alpha atlas), 0: binding 5 is a stand-in;
	                    // y the frame (jitter), z tan(the sun disc's half-angle): 0 = one hard ray toward the sun's centre,
	                    // w 1: write each pixel's blocker distance into binding 7 (2026-10-31 Penumbra; 0: binding 7 is a stand-in, untouched)
	vec4 full;          // xy the full screen size (depth and normals are full size; size is the traced one: half with HalfResolution)
	// UNOFFICIAL 2026-10-30 CloudShadows ([Shaders.ShadowsExteriors.RT]): the volumetric clouds' shadow map (binding 6), as
	// VolumetricClouds.fx.hlsl CloudShadowAt reads it; cloud.x 0 = none (binding 6 is a stand-in)
	vec4 cloud;         // x strength (ShadowStrengthForSunFar: day and sun height in it), y map width (m), z map size (texels), w cloud base (m)
	vec4 cloudCentre;   // xy the map's centre (m, on the cloud base), z metres per unit (1 / 70)
	vec4 cloudLight;    // xyz the light the map was drawn along (z >= 0.25)
	vec4 camera;        // xyz the camera's world position (units): the scene is camera relative
} p;
layout(set = 0, binding = 2, r32f) uniform readonly image2D depthImage;      // TESR_DepthBuffer's red: view z / farZ
layout(set = 0, binding = 3, rgba16f) uniform readonly image2D normalImage;  // TESR_NormalsBuffer: view-space normal * 0.5 + 0.5
layout(set = 0, binding = 4, r16f) uniform writeonly image2D visibilityImage;
layout(set = 0, binding = 5, r16f) uniform readonly image2D alphaAtlas;          // RtCore::AlphaAtlasImage() (or a stand-in, alpha.x 0)
layout(set = 0, binding = 6, rgba16f) uniform readonly image2D cloudImage;       // the clouds' shadow map, red = sunlight let through (cloud.x > 0)
layout(set = 0, binding = 7, r16f) uniform writeonly image2D hitImage;          // 2026-10-31 Penumbra: the blocker's distance (units), 0 = free / not traced
#define RT_ALPHA_ATLAS alphaAtlas
#include "RtAlpha.glsl"

// UNOFFICIAL 2026-10-30 CloudShadows: the sunlight the clouds let through to a scene-space point (VolumetricClouds.fx.hlsl CloudShadowAt:
// the map where the light from the point meets the cloud base, bilinear, 1 outside it faded in over its last tenth)
float cloudTransmittance(vec3 position) {
	const vec3 world = (p.camera.xyz + position) * p.cloudCentre.z;
	const vec2 q = world.xy + p.cloudLight.xy * ((p.cloud.w - world.z) / p.cloudLight.z);
	const vec2 suv = (q - p.cloudCentre.xy) / p.cloud.y + 0.5;
	const vec2 edge = min(suv, 1.0 - suv);
	const float inside = clamp(min(edge.x, edge.y) * 10.0, 0.0, 1.0);
	if (inside <= 0.0) return 1.0;
	const int n = int(p.cloud.z);
	const vec2 t = suv * p.cloud.z - 0.5;
	const ivec2 i0 = ivec2(floor(t));
	const vec2 f = t - vec2(i0);
	const float a = imageLoad(cloudImage, clamp(i0, ivec2(0), ivec2(n - 1))).r;
	const float b = imageLoad(cloudImage, clamp(i0 + ivec2(1, 0), ivec2(0), ivec2(n - 1))).r;
	const float c = imageLoad(cloudImage, clamp(i0 + ivec2(0, 1), ivec2(0), ivec2(n - 1))).r;
	const float d = imageLoad(cloudImage, clamp(i0 + ivec2(1, 1), ivec2(0), ivec2(n - 1))).r;
	return mix(1.0, mix(mix(a, b, f.x), mix(c, d, f.x), f.y), inside);
}

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	if (pixel.x >= int(p.size.x) || pixel.y >= int(p.size.y))
		return;

	float result = 1.0;
	float blocker = 0.0;	// 2026-10-31 Penumbra: the hit's distance along the sun ray (0: free, or not traced)
	// the full-size pixel this traced pixel stands for (the same one at full resolution)
	const ivec2 source = ivec2((vec2(pixel) + 0.5) * p.full.xy * p.size.zw);
	float linear01 = imageLoad(depthImage, source).r;
	float viewZ = linear01 * p.forward.w;
	vec2 uv = (vec2(pixel) + 0.5) * p.size.zw;
	const int debug = int(p.range.w + 0.5);

	if (debug == 3) {
		// The scene alone: a ray from the camera through the pixel, every instance (white = nothing hit within 8192 units)
		vec3 direction = normalize(p.forward.xyz + p.right.xyz * (2.0 * uv.x - 1.0) - p.up.xyz * (2.0 * uv.y - 1.0));
		rayQueryEXT q;
		const bool testAlpha = p.alpha.x > 0.5;
		rayQueryInitializeEXT(q, scene, testAlpha ? 0u : gl_RayFlagsOpaqueEXT, testAlpha ? 0xFFu : 0xEFu, p.origin.xyz, 1.0, direction, 8192.0);
		while (rayQueryProceedEXT(q))
			if (rayQueryGetIntersectionTypeEXT(q, false) == gl_RayQueryCandidateIntersectionTriangleEXT &&
				rtAlphaPass(rayQueryGetIntersectionInstanceIdEXT(q, false), rayQueryGetIntersectionPrimitiveIndexEXT(q, false),
					rayQueryGetIntersectionBarycentricsEXT(q, false)))
				rayQueryConfirmIntersectionEXT(q);
		bool hit = rayQueryGetIntersectionTypeEXT(q, true) != gl_RayQueryCommittedIntersectionNoneEXT;
		imageStore(visibilityImage, pixel, vec4(hit ? rayQueryGetIntersectionTEXT(q, true) / 8192.0 : 1.0, 0.0, 0.0, 0.0));
		return;
	}
	// State codes (debug 2): 0.1 no depth / sky, 0.2 the sun is down, 0.3 beyond the RT range, 0.45 facing away from the sun,
	// 0.6 traced and hit, 0.8 traced and free
	float state = !(linear01 > 0.0 && linear01 < 0.9999) ? 0.1 : p.sun.w <= 0.0 ? 0.2 : viewZ >= p.range.x ? 0.3 : 0.45;

	if (p.sun.w > 0.0 && linear01 > 0.0 && linear01 < 0.9999 && viewZ < p.range.x) {
		// The pixel's position as SunShadows.glsl's toWorld() does it: forward + right * (2u - 1) / P00 - up * (2v - 1) / P11, times view z
		vec3 position = p.origin.xyz + (p.forward.xyz + p.right.xyz * (2.0 * uv.x - 1.0) - p.up.xyz * (2.0 * uv.y - 1.0)) * viewZ;

		// The normal: view space in the buffer; scene space = its components along right, up and forward
		vec3 n = imageLoad(normalImage, source).xyz * 2.0 - 1.0;
		vec3 right = normalize(p.right.xyz), up = normalize(p.up.xyz), forward = normalize(p.forward.xyz);
		vec3 normal = normalize(right * n.x + up * n.y + forward * n.z);

		float facing = dot(normal, p.sun.xyz);
		if (facing > 0.0) {
			// Bias: along the normal (grows with distance: depth and normal precision), then a little toward the sun
			vec3 start = position + normal * (p.bias.x + p.bias.y * viewZ) + p.sun.xyz * p.bias.z;
			rayQueryEXT q;
			// Soft shadows: one ray a pixel toward a point of the sun's disc, a different one each pixel and frame (the denoiser averages)
			vec3 toSun = p.sun.xyz;
			if (p.alpha.z > 0.0) {
				const vec3 t1 = normalize(abs(toSun.z) < 0.9 ? cross(toSun, vec3(0.0, 0.0, 1.0)) : cross(toSun, vec3(1.0, 0.0, 0.0)));
				const vec3 t2 = cross(toSun, t1);
				// interleaved gradient noise + the frame's golden-ratio step: a low-discrepancy disc point
				const float n1 = fract(52.9829189 * fract(0.06711056 * float(pixel.x) + 0.00583715 * float(pixel.y)) + 0.618034 * p.alpha.y);
				const float n2 = fract(n1 * 1.618034 + 0.7548777 * p.alpha.y + 0.5 * float((pixel.x ^ pixel.y) & 1));
				const float r = sqrt(n1) * p.alpha.z, phi = 6.2831853 * n2;
				toSun = normalize(toSun + (t1 * cos(phi) + t2 * sin(phi)) * r);
			}
			// Alpha-tested casters (non-opaque, mask 0x10) come as candidates: their diffuse alpha decides (RtAlpha.glsl)
			const bool testAlpha = p.alpha.x > 0.5;
			rayQueryInitializeEXT(q, scene, gl_RayFlagsTerminateOnFirstHitEXT | (testAlpha ? 0u : gl_RayFlagsOpaqueEXT),
				uint(p.range.z) & (testAlpha ? 0xFFu : 0xEFu), start, 0.0, toSun, p.bias.w);
			while (rayQueryProceedEXT(q))
				if (rayQueryGetIntersectionTypeEXT(q, false) == gl_RayQueryCandidateIntersectionTriangleEXT &&
					rtAlphaPass(rayQueryGetIntersectionInstanceIdEXT(q, false), rayQueryGetIntersectionPrimitiveIndexEXT(q, false),
						rayQueryGetIntersectionBarycentricsEXT(q, false)))
					rayQueryConfirmIntersectionEXT(q);
			bool hit = rayQueryGetIntersectionTypeEXT(q, true) != gl_RayQueryCommittedIntersectionNoneEXT;
			state = hit ? 0.6 : 0.8;
			if (hit) blocker = max(rayQueryGetIntersectionTEXT(q, true), 1.0);
			if (debug == 1)
				result = hit ? clamp(rayQueryGetIntersectionTEXT(q, true) / 4096.0, 0.0, 1.0) : 1.0;
			else
				result = hit ? 0.0 : 1.0;
			// The last FadeLength units of the RT range fade to "free" (the cascades take over there)
			result = mix(result, 1.0, clamp((viewZ - (p.range.x - p.range.y)) / max(p.range.y, 1.0), 0.0, 1.0));
		}
	}
	// UNOFFICIAL 2026-10-30 CloudShadows: the clouds' shadow on every lit pixel, inside the RT range and beyond it (the clouds' own pass
	// leaves them out in this frame): only the sunlight, faded off on faces turned from the sun as the clouds' composite does it
	// DebugView 10 (range.w 6): the clouds' shadow map as copied in, stretched over the screen (a check of the copy)
	if (p.cloud.x > 0.0 && debug == 6) {
		imageStore(visibilityImage, pixel, vec4(imageLoad(cloudImage, ivec2(uv * p.cloud.z)).r, 0.0, 0.0, 0.0));
		return;
	}
	// DebugView 9 (range.w 5): the clouds' transmittance at each pixel alone (no strength, no facing)
	if (p.cloud.x > 0.0 && debug == 5) {
		const vec3 position = p.origin.xyz + (p.forward.xyz + p.right.xyz * (2.0 * uv.x - 1.0) - p.up.xyz * (2.0 * uv.y - 1.0)) * viewZ;
		imageStore(visibilityImage, pixel, vec4(linear01 > 0.0 && linear01 < 0.9999 ? cloudTransmittance(position) : 1.0, 0.0, 0.0, 0.0));
		return;
	}
	if (p.cloud.x > 0.0 && debug == 0 && linear01 > 0.0 && linear01 < 0.9999) {
		const vec3 position = p.origin.xyz + (p.forward.xyz + p.right.xyz * (2.0 * uv.x - 1.0) - p.up.xyz * (2.0 * uv.y - 1.0)) * viewZ;
		const vec3 n = imageLoad(normalImage, source).xyz * 2.0 - 1.0;
		const vec3 normal = normalize(normalize(p.right.xyz) * n.x + normalize(p.up.xyz) * n.y + normalize(p.forward.xyz) * n.z);
		const float facing = smoothstep(0.0, 0.25, dot(normal, p.sun.xyz));
		if (facing > 0.0) result *= mix(1.0, cloudTransmittance(position), p.cloud.x * facing);
	}
	imageStore(visibilityImage, pixel, vec4(debug == 2 ? state : result, 0.0, 0.0, 0.0));
	if (p.alpha.w > 0.5) imageStore(hitImage, pixel, vec4(min(blocker, 60000.0), 0.0, 0.0, 0.0));
}

// UNOFFICIAL 2026-10-26 (NVR DXVK, deep/fork-hiz): the hierarchical depth pyramid (Hi-Z), built once per frame in ONE compute
// dispatch (core/HiZ.cpp). Single-pass downsampler style: each 16x16 workgroup reads a 128x128 block of TESR_DepthBuffer and writes
// all seven levels that block covers (64x64 .. 1x1), the inner levels through shared memory, no second dispatch, no atomics.
//
// v2 (2026-10-26, after the HiZCheck readback found the first version's pyramid ALL ZERO in game): the levels go into a STORAGE
// BUFFER (the extension's proven write path, as AvgLuma's) instead of storage-image views of a mipmapped D3D9 render target, and the
// depth is read with texelFetch (no gather, no sampler).
//
// Pyramid buffer: vec2 per cell, level k after levels 0..k-1, row-major, level k is (W0 >> k) x (H0 >> k) with W0 x H0 = the screen's
// half rounded UP to a multiple of 64 (1920x1080 -> 960x576). Cell (i, j) of level k covers the full-resolution pixels
// [i, i+1) x [j, j+1) * 2^(k+1): x = the NEAREST linear depth (depth / farZ as TESR_DepthBuffer stores it), y = the FARTHEST.
// The weapon (first-person view model) is left out of both: a cell that is all weapon reads nearest 4, farthest 0.
//
// Build: glslangValidator -V --target-env vulkan1.1 -o HiZBuild.spv HiZBuild.comp
#version 450
#extension GL_EXT_samplerless_texture_functions : enable

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 1, binding = 0) uniform texture2D t_depth;      // TESR_DepthBuffer (x: linear depth / farZ)
layout(set = 1, binding = 1) uniform texture2D t_viewModel;  // TESR_DepthBufferViewModel (INTZ)
layout(set = 1, binding = 2, std430) writeonly buffer Pyramid { vec2 cells[]; };

layout(push_constant) uniform Push {
    ivec2 fullSize;        // 0: the full-resolution size (TESR_DepthBuffer's)
    float invertedDepth;   // 8: TESR_DepthConstants.z (the weapon test, as Reflections' IsWeapon)
    uint w0;               // 12: level 0 size
    uint h0;               // 16
} pc;

shared vec2 s_level2[16][16];
shared vec2 s_level3[8][8];
shared vec2 s_level4[4][4];
shared vec2 s_level5[2][2];

const float Nothing = 4.0;   // nearest of a pixel that is not there (weapon); its farthest is 0

vec2 combine(vec2 a, vec2 b) { return vec2(min(a.x, b.x), max(a.y, b.y)); }

uint levelOffset(uint k) {
    uint o = 0u;
    for (uint i = 0u; i < k; i++) o += (pc.w0 >> i) * (pc.h0 >> i);
    return o;
}
void store(uint k, ivec2 c, vec2 v) { cells[levelOffset(k) + uint(c.y) * (pc.w0 >> k) + uint(c.x)] = v; }

vec2 pixel(ivec2 p) {
    p = clamp(p, ivec2(0), pc.fullSize - 1);
    float d = texelFetch(t_depth, p, 0).x;
    float w = texelFetch(t_viewModel, p, 0).x;
    bool weapon = pc.invertedDepth == 0.0 ? w < 0.9 : w > 0.01;
    return weapon ? vec2(Nothing, 0.0) : vec2(d);
}

void main() {
    uvec2 t = gl_LocalInvocationID.xy;
    uvec2 g = gl_WorkGroupID.xy;
    ivec2 base0 = ivec2(g * 64u + t * 4u);   // this thread's 4x4 level-0 cells
    vec2 l1[2][2];
    for (int by = 0; by < 2; by++)
        for (int bx = 0; bx < 2; bx++) {
            vec2 acc = vec2(Nothing, 0.0);
            for (int y = 0; y < 2; y++)
                for (int x = 0; x < 2; x++) {
                    ivec2 c = base0 + ivec2(bx * 2 + x, by * 2 + y);
                    ivec2 p = c * 2;
                    vec2 v = combine(combine(pixel(p), pixel(p + ivec2(1, 0))), combine(pixel(p + ivec2(0, 1)), pixel(p + ivec2(1, 1))));
                    store(0u, c, v);
                    acc = combine(acc, v);
                }
            l1[by][bx] = acc;
            store(1u, ivec2(g * 32u + t * 2u) + ivec2(bx, by), acc);
        }
    vec2 v2 = combine(combine(l1[0][0], l1[0][1]), combine(l1[1][0], l1[1][1]));
    store(2u, ivec2(g * 16u + t), v2);
    s_level2[t.y][t.x] = v2;
    memoryBarrierShared();
    barrier();
    if (t.x < 8u && t.y < 8u) {
        uvec2 s = t * 2u;
        vec2 v = combine(combine(s_level2[s.y][s.x], s_level2[s.y][s.x + 1u]), combine(s_level2[s.y + 1u][s.x], s_level2[s.y + 1u][s.x + 1u]));
        store(3u, ivec2(g * 8u + t), v);
        s_level3[t.y][t.x] = v;
    }
    memoryBarrierShared();
    barrier();
    if (t.x < 4u && t.y < 4u) {
        uvec2 s = t * 2u;
        vec2 v = combine(combine(s_level3[s.y][s.x], s_level3[s.y][s.x + 1u]), combine(s_level3[s.y + 1u][s.x], s_level3[s.y + 1u][s.x + 1u]));
        store(4u, ivec2(g * 4u + t), v);
        s_level4[t.y][t.x] = v;
    }
    memoryBarrierShared();
    barrier();
    if (t.x < 2u && t.y < 2u) {
        uvec2 s = t * 2u;
        vec2 v = combine(combine(s_level4[s.y][s.x], s_level4[s.y][s.x + 1u]), combine(s_level4[s.y + 1u][s.x], s_level4[s.y + 1u][s.x + 1u]));
        store(5u, ivec2(g * 2u + t), v);
        s_level5[t.y][t.x] = v;
    }
    memoryBarrierShared();
    barrier();
    if (t.x == 0u && t.y == 0u) {
        vec2 v = combine(combine(s_level5[0][0], s_level5[0][1]), combine(s_level5[1][0], s_level5[1][1]));
        store(6u, ivec2(g), v);
    }
}

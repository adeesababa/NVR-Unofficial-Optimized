// UNOFFICIAL 2026-10-27 (NVR DXVK, deep/fork2-ssgi) [Shaders.AmbientLight.Main] ComputeGI: the GI input for AmbientLightGI.frag, in ONE
// compute dispatch (effects/AmbientLight.cpp RenderGIPrefilter), right after Prepare (and NormalSmoothing) and before the GI pass.
//
// What it writes, per texel of AmbientLight's half-resolution prep: uvec2(view depth as float bits, light), light = the frame's colour
// there (the picture before AmbientLight's apply: what the surface sends on), linear, capped at pc.params.z, packed sqrt 11:11:10.
// Four levels (mips) in one storage buffer: level 0 at the prep's size, level m at max(size >> m, 1) (D3D9's mip sizes); each level in
// 8 x 8 tiles (64 texels in a row, tiles row by row) so a tap's neighbours share cache lines. One 8 x 8 workgroup = one level-0 tile;
// levels 1-3 come from it through shared memory (no second dispatch, no pass per level; this is what compute buys here).
// A level's depth: XeGTAO's depth MIP filter (a weighted average favouring the farthest of the four within 0.75 x Radius, so a thin
// thing in front does not make the coarse texel a wall); its light: the same weights. Texels with no surface (sky beyond pc.params.w,
// the weapon: the prep says 1e6) are left out; a parent of only such texels is one too.
//
// Why a buffer and not storage images: the extension's proven write path (AvgLuma, Hi-Z v2 found storage-image writes into the mip
// views of a D3D9 render target read back all zero in game), and no storage format that D3D9 textures offer here holds 8 bytes.
//
// Build: glslangValidator -V --target-env vulkan1.1 -o AmbientLightGIPrefilter.spv AmbientLightGIPrefilter.comp
#version 450
#extension GL_EXT_samplerless_texture_functions : enable
#extension GL_GOOGLE_include_directive : enable
#include "Common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 1, binding = 0) uniform texture2D t_prep;       // NVR_AmbientLightPrep: x view depth, y packed normal
layout(set = 1, binding = 1) uniform texture2D t_scene;      // the frame (TESR_SourceBuffer of AmbientLight's apply; LINEAR, CLAMP)
layout(set = 1, binding = 2, std430) writeonly restrict buffer GIInput { uvec2 texels[]; } gout;   // buffer slot 1

layout(push_constant) uniform Push {
    uvec4 size;          // 0: xy level-0 size (the prep's)
    uvec4 base;          // 16: element offset of levels 0-3
    uvec4 tiles;         // 32: 8 x 8 tiles across, levels 0-3
    vec4  params;        // 48: x falloffMul, y falloffAdd (the depth filter's weights), z light cap, w no surface at or beyond this depth
    uint  samplerIndex;  // 64: LINEAR, CLAMP
    uint  pad0, pad1, pad2;
} pc;                    // 80 bytes

const float Nothing = 1.0e6;

shared float s_z[64];
shared vec3  s_c[64];

uint PackLight(vec3 c) {
    vec3 s = sqrt(clamp(c, vec3(0.0), vec3(1.0)));
    return uint(s.r * 2047.0 + 0.5) | (uint(s.g * 2047.0 + 0.5) << 11) | (uint(s.b * 1023.0 + 0.5) << 22);
}

void Store(int level, ivec2 p, float z, vec3 c) {
    uvec2 size = max(pc.size.xy >> level, uvec2(1u));
    uvec2 q = uvec2(p);
    if (q.x >= size.x || q.y >= size.y) return;
    uint i = pc.base[level] + ((q.y >> 3) * pc.tiles[level] + (q.x >> 3)) * 64u + ((q.y & 7u) << 3) + (q.x & 7u);
    gout.texels[i] = uvec2(floatBitsToUint(z), PackLight(c));
}

// Four children (shared indices) -> one parent.
void Down(uint a, uint b, uint c, uint d, out float z, out vec3 colour) {
    float zs[4] = float[4](s_z[a], s_z[b], s_z[c], s_z[d]);
    vec3 cs[4] = vec3[4](s_c[a], s_c[b], s_c[c], s_c[d]);
    float far = -1.0;
    for (int i = 0; i < 4; i++) if (zs[i] < pc.params.w) far = max(far, zs[i]);
    z = Nothing;
    colour = vec3(0.0);
    if (far < 0.0) return;
    float sum = 0.0, zSum = 0.0;
    vec3 cSum = vec3(0.0);
    for (int i = 0; i < 4; i++) {
        if (!(zs[i] < pc.params.w)) continue;
        float w = saturate((far - zs[i]) * pc.params.x + pc.params.y);
        sum += w; zSum += w * zs[i]; cSum += w * cs[i];
    }
    z = zSum / max(sum, 1e-6);
    colour = cSum / max(sum, 1e-6);
}

void main() {
    uvec2 l = gl_LocalInvocationID.xy;
    ivec2 g = ivec2(gl_WorkGroupID.xy);
    ivec2 p = g * 8 + ivec2(l);
    uint me = l.y * 8u + l.x;
    float z = Nothing;
    vec3 colour = vec3(0.0);
    if (uint(p.x) < pc.size.x && uint(p.y) < pc.size.y) {
        z = texelFetch(t_prep, p, 0).x;
        vec2 uv = (vec2(p) + 0.5) / vec2(pc.size.xy);   // the half-resolution texel's centre: a LINEAR read = its 2 x 2 frame pixels
        colour = min(linearize(textureLod(sampler2D(t_scene, NVR_SAMPLER(pc.samplerIndex)), uv, 0.0).rgb), vec3(pc.params.z));
        Store(0, p, z, colour);
    }
    s_z[me] = z;
    s_c[me] = colour;
    barrier();

    // Level 1: 4 x 4 per group (threads 0-15 as 4 x 4), children in s_z[8 x 8].
    float z1 = Nothing; vec3 c1 = vec3(0.0);
    if (l.x < 4u && l.y < 4u) {
        uint a = (l.y * 2u) * 8u + l.x * 2u;
        Down(a, a + 1u, a + 8u, a + 9u, z1, c1);
        Store(1, g * 4 + ivec2(l), z1, c1);
    }
    barrier();
    if (l.x < 4u && l.y < 4u) { s_z[l.y * 8u + l.x] = z1; s_c[l.y * 8u + l.x] = c1; }   // level 1 in the top-left 4 x 4
    barrier();

    // Level 2: 2 x 2 per group.
    float z2 = Nothing; vec3 c2 = vec3(0.0);
    if (l.x < 2u && l.y < 2u) {
        uint a = (l.y * 2u) * 8u + l.x * 2u;
        Down(a, a + 1u, a + 8u, a + 9u, z2, c2);
        Store(2, g * 2 + ivec2(l), z2, c2);
    }
    barrier();
    if (l.x < 2u && l.y < 2u) { s_z[l.y * 8u + l.x] = z2; s_c[l.y * 8u + l.x] = c2; }
    barrier();

    // Level 3: one texel per group.
    if (me == 0u) {
        float z3; vec3 c3;
        Down(0u, 1u, 8u, 9u, z3, c3);
        Store(3, g, z3, c3);
    }
}
